---
// v2/src/pages/huzzah.astro - Website 11: Bản Astro Code Native Huzzah Creative Agency
import HuzzahLayout from '../layouts/HuzzahLayout.astro';
import Header from '../components/huzzah/Header.astro';
import Hero from '../components/huzzah/Hero.astro';
import Clients from '../components/huzzah/Clients.astro';
import Services from '../components/huzzah/Services.astro';
import WhyUs from '../components/huzzah/WhyUs.astro';
import Work from '../components/huzzah/Work.astro';
import Process from '../components/huzzah/Process.astro';
import Compare from '../components/huzzah/Compare.astro';
import Reviews from '../components/huzzah/Reviews.astro';
import Pricing from '../components/huzzah/Pricing.astro';
import Team from '../components/huzzah/Team.astro';
import Faq from '../components/huzzah/Faq.astro';
import Contact from '../components/huzzah/Contact.astro';
import Footer from '../components/huzzah/Footer.astro';
---

<HuzzahLayout
  title="Huzzah Studio — Branding & Digital Creative Agency (Bản Astro Code)"
  description="Huzzah Studio is a small, senior creative agency for branding, websites, content and growth marketing. Brand work so good, people actually cheer."
  isOriginal={false}
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <Hero />
      <Clients />
      <Services />
      <WhyUs />
      <Work />
      <Process />
      <Compare />
      <Reviews />
      <Pricing />
      <Team />
      <Faq />
      <Contact />
    </main>
    <Footer />
  </div>
</HuzzahLayout>
