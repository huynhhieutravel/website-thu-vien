// v2/src/pages/index.astro
// Trang Chủ Thư Viện: Danh mục các website clone
// Website 01 (AERIVE): Có 2 phiên bản (Bản Astro code & Bản gốc)
// Website 02 (VROOMX): Bản cover nguyên mẫu A-Z y hệt bản gốc (1 nút Xem Chi Tiết)
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Website Archive Hub — Danh Mục Website Đã Clone</title>
    <meta name="description" content="Danh mục các trang web clone nguyên mẫu và chuyển đổi mã nguồn." />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background-color: #f8fafc;
        color: #0f172a;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      /* Container RỘNG HƠN (1240px) & CĂN GIỮA ĐẸP MẮT (KHÔNG FULL-WIDTH) */
      .page-container {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 44px 28px 72px;
      }

      /* Top Header */
      .top-header-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
      }
      .top-title-group {
        flex: 1;
        min-width: 280px;
      }
      .top-title {
        font-size: 28px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
      }
      .top-subtitle {
        font-size: 14px;
        color: #64748b;
        margin-top: 6px;
      }
      .modulify-ref-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #0f172a;
        color: #ffffff;
        padding: 10px 20px;
        border-radius: 9999px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid #1e293b;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.12);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        white-space: nowrap;
      }
      .modulify-ref-btn:hover {
        background: #1e293b;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.18);
        color: #38bdf8;
      }
      .modulify-ref-btn .badge-dot {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
        display: inline-block;
      }
      .modulify-ref-btn .btn-arrow {
        font-size: 14px;
        transition: transform 0.2s ease;
      }
      .modulify-ref-btn:hover .btn-arrow {
        transform: translate(2px, -2px);
      }
      .pill-btn-modulify {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #0f172a;
        font-weight: 700;
      }
      .pill-btn-modulify:hover {
        background: #e2e8f0;
        border-color: #94a3b8;
      }

      /* Filter Pills Row */
      .filter-pills {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 24px;
        margin-bottom: 32px;
        overflow-x: auto;
        padding-bottom: 6px;
      }
      .pill-btn {
        border-radius: 9999px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #475569;
        transition: all 0.2s ease;
        text-decoration: none;
        white-space: nowrap;
        font-family: inherit;
      }
      .pill-btn:hover {
        border-color: #cbd5e1;
        color: #0f172a;
      }
      .pill-btn.active {
        background: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
      }

      /* Cards Grid (Chuẩn hệ thống 3 cột trên 1 hàng) */
      .cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 26px;
      }
      @media (max-width: 1060px) {
        .cards-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 680px) {
        .cards-grid {
          grid-template-columns: 1fr;
        }
      }

      /* Card Item */
      .card-item {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
      }
      .card-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
        border-color: #cbd5e1;
      }

      /* Thumbnail 16:9 Chuẩn Tuyệt Đối */
      .card-thumb-wrap {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        position: relative;
        background: #f1f5f9;
        flex-shrink: 0;
      }
      .card-thumb-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 0.45s ease;
      }
      .card-item:hover .card-thumb-img {
        transform: scale(1.05);
      }

      /* Card Body */
      .card-body {
        padding: 22px 22px 14px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }
      .card-tag {
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: #94a3b8;
        display: block;
        margin-bottom: 8px;
      }
      .card-title-wrap {
        margin: 0;
        padding: 0;
      }
      .card-title {
        font-size: 17.5px;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.4;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 48px;
        transition: color 0.2s ease;
      }
      .card-title:hover {
        color: #e0533c;
      }
      .card-desc {
        font-size: 13.5px;
        color: #64748b;
        line-height: 1.55;
        margin-top: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 62px;
      }

      /* Card Footer */
      .card-footer {
        padding: 0 24px 26px;
        margin-top: auto;
      }
      .meta-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding-top: 18px;
        margin-bottom: 20px;
        border-top: 1px solid #f1f5f9;
      }
      .meta-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94a3b8;
      }
      .meta-value {
        font-size: 13px;
        font-weight: 700;
        color: #e0533c;
      }

      /* Nhóm Nút Xem Chi Tiết - KHOẢNG CÁCH 16px THOÁNG ĐÃNG */
      .btn-stack {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .btn-detail {
        width: 100%;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 12px;
        border: 1.5px solid #e0533c;
        color: #e0533c;
        background: #ffffff;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        font-family: inherit;
      }
      .btn-detail:hover {
        background: #e0533c;
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(224, 83, 60, 0.22);
      }

      .btn-arrow {
        font-size: 15px;
        transition: transform 0.2s ease;
      }
      .btn-detail:hover .btn-arrow {
        transform: translateX(4px);
      }

      /* Clean Footer */
      .page-footer {
        margin-top: auto;
        padding: 24px;
        text-align: center;
        font-size: 12px;
        color: #94a3b8;
        border-top: 1px solid #e2e8f0;
        background: #ffffff;
      }
    </style>
  </head>

  <body>
