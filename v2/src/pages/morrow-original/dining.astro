-flex h-12 items-center gap-3 rounded-full bg-charcoal px-6 text-[12px] font-semibold uppercase tracking-[0.16em] text-bone transition-colors hover:bg-forest" type="button">Reserve a table<svg aria-hidden="true" class="lucide lucide-arrow-up-right size-4" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></button></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-charcoal opacity-0" data-venue-shade="true"></div></div></article><article aria-labelledby="venue-2" class="lg:sticky lg:top-[calc(6rem+var(--stack)*1.5rem)] lg:mb-16 lg:h-[min(76svh,720px)] lg:last:mb-0" data-venue="true" style="--stack:2"><div class="relative grid h-full origin-top overflow-hidden rounded-[6px] bg-paper shadow-[0_30px_80px_-40px_rgba(27,27,25,0.45)] lg:grid-cols-12" data-venue-inner="true"><div class="relative aspect-[4/3] lg:col-span-7 lg:aspect-auto"><img alt="A low stone pavilion with wide windows set into the dunes" class="object-cover" data-nimg="fill" decoding="async" loading="lazy" sizes="(min-width: 1024px) 58vw, 100vw" src="/images/clubhouse-3.jpg" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent"/></div><div class="flex flex-col justify-between gap-10 p-6 sm:p-8 lg:col-span-5 lg:p-12"><div><p class="font-mono text-[10px] uppercase tracking-[0.22em] text-charcoal/55 sm:text-[11px]">03<!-- --> · <!-- -->At the turn</p><h3 class="mt-5 font-serif text-[clamp(2.4rem,4vw,4.2rem)] leading-[0.95]" id="venue-2">Halfway House</h3><p class="mt-6 max-w-md text-[15px] leading-relaxed text-charcoal/75">A stone pavilion between the 9th green and the 10th tee for coffee, a warm bifana and something cold. Five minutes, then back out.</p></div><div><ul class="divide-y divide-charcoal/10 border-y border-charcoal/10"><li class="py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-charcoal/70">Open during play</li><li class="py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-charcoal/70">Between holes 9 and 10</li></ul></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-charcoal opacity-0" data-venue-shade="true"></div></div></article><article aria-labelledby="venue-3" class="lg:sticky lg:top-[calc(6rem+var(--stack)*1.5rem)] lg:mb-16 lg:h-[min(76svh,720px)] lg:last:mb-0" data-venue="true" style="--stack:3"><div class="relative grid h-full origin-top overflow-hidden rounded-[6px] bg-paper shadow-[0_30px_80px_-40px_rgba(27,27,25,0.45)] lg:grid-cols-12" data-venue-inner="true"><div class="relative aspect-[4/3] lg:col-span-7 lg:aspect-auto"><img alt="A timber lodge on a stone base, set into a grassy hillside" class="object-cover" data-nimg="fill" decoding="async" loading="lazy" sizes="(min-width: 1024px) 58vw, 100vw" src="/images/lodge-1.jpg" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent"/></div><div class="flex flex-col justify-between gap-10 p-6 sm:p-8 lg:col-span-5 lg:p-12"><div><p class="font-mono text-[10px] uppercase tracking-[0.22em] text-charcoal/55 sm:text-[11px]">04<!-- --> · <!-- -->Stay &amp; play</p><h3 class="mt-5 font-serif text-[clamp(2.4rem,4vw,4.2rem)] leading-[0.95]" id="venue-3">The Lodges</h3><p class="mt-6 max-w-md text-[15px] leading-relaxed text-charcoal/75">Twenty-four timber lodges among the pines, each with its own terrace, fireplace and cart. Wake up five minutes from the first tee.</p></div><div><ul class="divide-y divide-charcoal/10 border-y border-charcoal/10"><li class="py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-charcoal/70">24 lodges</li><li class="py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-charcoal/70">One to four bedrooms</li></ul><button class="mt-6 inline-flex h-12 items-center gap-3 rounded-full bg-charcoal px-6 text-[12px] font-semibold uppercase tracking-[0.16em] text-bone transition-colors hover:bg-forest" type="button">Plan a stay<svg aria-hidden="true" class="lucide lucide-arrow-up-right size-4" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></button></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-charcoal opacity-0" data-venue-shade="true"></div></div></article></div></div></section><section aria-labelledby="menu-heading" class="relative z-10 bg-bone text-charcoal" id="menu"><div class="grid gap-14 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:px-12 lg:py-32"><div class="lg:col-span-4"><div class="lg:sticky lg:top-28"><p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-charcoal/70"><span class="tabular-nums">03</span><span aria-hidden="true" class="h-px w-8 bg-current opacity-40"></span><span>From the Terrace menu</span></p><h2 class="mt-6 text-[clamp(2.1rem,4vw,4rem)] font-light leading-[1.02] tracking-[-0.03em]" id="menu-heading">Cooked over vine wood, <em class="font-serif font-normal">served with a view.</em></h2><p class="mt-6 max-w-sm text-base leading-relaxed text-charcoal/70" data-reveal="true">The menu changes every day with the garden and the morning boats. This is what it looked like last week.</p><div class="mt-8" data-reveal="true"><button class="inline-flex h-12 items-center gap-3 rounded-full px-6 text-[12px] font-semibold uppercase tracking-[0.16em] transition-colors duration-300 bg-charcoal text-bone hover:bg-forest" type="button">Reserve a table<svg aria-hidden="true" class="lucide lucide-arrow-up-right size-4" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></button></div></div></div><div class="rounded-[6px] border border-charcoal/10 bg-paper px-6 py-10 sm:px-10 lg:col-span-7 lg:col-start-6 lg:px-14 lg:py-14"><p class="text-center font-mono text-[10px] uppercase tracking-[0.3em] text-charcoal/50">The Terrace · Lunch</p><div class="mt-12 first-of-type:mt-10" data-reveal="true"><h3 class="text-center font-serif text-3xl italic text-forest">To start</h3><ul class="mt-6 space-y-6"><li class="text-center"><p class="type-wide text-[15px] font-medium uppercase tracking-[0.06em]">Morning oysters</p><p class="mx-auto mt-1.5 max-w-sm text-[15px] leading-relaxed text-charcoal/65">From the estuary, with green apple and a little sea fennel.</p></li><li class="text-center"><p class="type-wide text-[15px] font-medium uppercase tracking-[0.06em]">Garden tomatoes</p><p class="mx-auto mt-1.5 max-w-sm text-[15px] leading-relaxed text-charcoal/65">Warm from the estate garden, with sheep’s cheese and olive oil from the valley.</p></li><li class="text-center"><p class="type-wide text-[15px] font-medium uppercase tracking-[0.06em]">Cured presa</p><p class="mx-auto mt-1.5 max-w-sm text-[15px] leading-relaxed text-charcoal/65">Black pork, aged for eighteen months, sliced to order.</p></li></ul></div><div class="mt-12 first-of-type:mt-10" data-reveal="true"><h3 class="text-center font-serif text-3xl italic text-forest">From the fire</h3><ul class="mt-6 space-y-6"><li class="text-center"><p class="type-wide text-[15px] font-medium uppercase tracking-[0.06em]">Whole sea bass</p><p class="mx-auto mt-1.5 max-w-sm text-[15px] leading-relaxed text-charcoal/65">Cooked over vine wood and finished with lemon and wild fennel.</p></li><li class="text-center"><p class="type-wide text-[15px] font-medium uppercase tracking-[0.06em]">Carabineiro prawns</p><p class="mx-auto mt-1.5 max-w-sm text-[15px] leading-relaxed text-charcoal/65">Split and grilled, with garlic, chilli and bread for the juices.</p></li><li class="text-center"><p class="type-wide text-[15px] font-medium uppercase tracking-[0.06em]">Aged sirloin</p><p class="mx-auto mt-1.5 max-w-sm text-[15px] leading-relaxed text-charcoal/65">Alentejo beef, sixty days on the bone, with salt-baked potatoes.</p></li></ul></div><div class="mt-12 first-of-type:mt-10" data-reveal="true"><h3 class="text-center font-serif text-3xl italic text-forest">To finish</h3><ul class="mt-6 space-y-6"><li class="text-center"><p class="type-wide text-[15px] font-medium uppercase tracking-[0.06em]">Orange and almond cake</p><p class="mx-auto mt-1.5 max-w-sm text-[15px] leading-relaxed text-charcoal/65">Still warm, with a spoon of cold cream.</p></li><li class="text-center"><p class="type-wide text-[15px] font-medium uppercase tracking-[0.06em]">Valley cheeses</p><p class="mx-auto mt-1.5 max-w-sm text-[15px] leading-relaxed text-charcoal/65">Three from within forty kilometres, with fig bread and honey.</p></li></ul></div></div></div></section><section aria-labelledby="the-lodges-heading" class="relative z-10 bg-forest text-bone" id="the-lodges"><div class="px-5 py-24 sm:px-8 lg:px-12 lg:py-32"><div class="grid gap-10 lg:grid-cols-12 lg:gap-8"><div class="lg:col-span-7"><p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-bone/70"><span class="tabular-nums">04</span><span aria-hidden="true" class="h-px w-8 bg-current opacity-40"></span><span>Stay</span></p><h2 class="mt-6 text-[clamp(2.1rem,4.2vw,4.2rem)] font-light leading-[1.02] tracking-[-0.03em] [&amp;_em]:font-serif [&amp;_em]:font-normal" id="the-lodges-heading">Twenty-four lodges, <em>five minutes from the first tee.</em></h2></div><p class="self-end text-base leading-relaxed lg:col-span-4 lg:col-start-9 text-bone/70" data-reveal="true">Timber lodges among the umbrella pines, each with its own terrace, fire and cart parked at the door.</p></div><ol class="mt-14 grid gap-x-8 gap-y-12 lg:mt-20 sm:grid-cols-2 lg:grid-cols-3"><li class="flex flex-col border-t pt-6 border-bone/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-bone/45">01</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">Pine Lodge</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-bone/70">One bedroom under the pines, with a terrace, an open fire and a cart parked at the door.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ochre">Sleeps 2</p></li><li class="flex flex-col border-t pt-6 border-bone/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-bone/45">02</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">Heath Lodge</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-bone/70">Two bedrooms looking over the heath to the ocean, with an outdoor shower and a kitchen for long breakfasts.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ochre">Sleeps 4</p></li><li class="flex flex-col border-t pt-6 border-bone/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-bone/45">03</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">Dune House</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-bone/70">Four bedrooms, a pool in the dunes and a private chef on request. Made for golf trips and families.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ochre">Sleeps 8</p></li></ol><div class="mt-14 lg:mt-20" data-reveal="true"><button class="inline-flex h-12 items-center gap-3 rounded-full px-6 text-[12px] font-semibold uppercase tracking-[0.16em] transition-colors duration-300 bg-bone text-charcoal hover:bg-ochre" type="button">Plan a stay<svg aria-hidden="true" class="lucide lucide-arrow-up-right size-4" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></button></div></div></section><section aria-label="Next page" class="relative z-10 bg-charcoal"><a class="group relative block h-[78svh] min-h-[440px] overflow-hidden text-bone" href="/morrow-original/events"><div class="overflow-hidden absolute inset-0 h-full w-full bg-pine"><div class="absolute inset-x-0 -top-[14%] -bottom-[14%]" data-parallax="10"><div class="relative h-full w-full"><img alt="Guests dining on the glass-fronted clubhouse terrace at golden hour, carts lined up below" class="object-cover transition-transform duration-[1800ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.06]" data-nimg="fill" decoding="async" loading="lazy" sizes="100vw" src="/images/campaign/terrace-dining.png" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:72% center;color:transparent"/></div></div></div><span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-pine/90 via-pine/35 to-pine/20 transition-opacity duration-700 group-hover:opacity-80"></span><span class="absolute inset-x-0 bottom-0 flex flex-col gap-6 px-5 pb-10 sm:px-8 lg:flex-row lg:items-end lg:justify-between lg:px-12 lg:pb-14"><span class="block"><span class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-bone/75"><span>Next chapter</span><span aria-hidden="true" class="h-px w-8 bg-current opacity-50"></span><span class="tabular-nums">06</span></span><span class="type-wide mt-5 block text-[clamp(2.4rem,7.4vw,7.5rem)] font-medium uppercase leading-[0.9] tracking-[-0.03em]">Events</span><span class="mt-5 block max-w-lg font-serif text-xl italic text-bone/85 sm:text-2xl">The calendar, and your own day on our land.</span></span><span class="flex size-16 shrink-0 items-center justify-center rounded-full border border-bone/40 transition-colors duration-500 group-hover:border-bone group-hover:bg-bone group-hover:text-charcoal sm:size-20"><svg aria-hid