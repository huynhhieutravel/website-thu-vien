rem,8.4vw,8.75rem)] font-medium uppercase leading-[0.9] tracking-[-0.03em]" data-ph-title="true" id="page-title">The Course</h1><div class="mt-7 flex flex-col gap-6 border-t border-bone/20 pt-5 lg:mt-9 lg:flex-row lg:items-end lg:justify-between"><div class="flex items-end gap-6"><button aria-label="Scroll to the next section" class="group/cue hidden items-center sm:flex" data-ph-fade="true" type="button"><span aria-hidden="true" class="relative block h-10 w-px overflow-hidden bg-bone/25"><span class="absolute inset-x-0 top-0 block h-1/2 animate-scroll-cue bg-bone"></span></span></button><p class="max-w-xl font-serif text-[clamp(1.35rem,2.2vw,2rem)] italic leading-snug text-bone/90" data-ph-fade="true">The Championship 18, walked for two years before a single hole was drawn.</p></div><dl class="grid grid-cols-3 gap-5 sm:gap-8 lg:shrink-0" data-ph-fade="true"><div class="flex flex-col-reverse gap-1.5"><dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-bone/60 sm:text-[10px]">Par</dt><dd class="type-wide text-lg font-medium leading-none sm:text-2xl">72</dd></div><div class="flex flex-col-reverse gap-1.5"><dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-bone/60 sm:text-[10px]">Yards</dt><dd class="type-wide text-lg font-medium leading-none sm:text-2xl">7,048</dd></div><div class="flex flex-col-reverse gap-1.5"><dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-bone/60 sm:text-[10px]">Tee sets</dt><dd class="type-wide text-lg font-medium leading-none sm:text-2xl">4</dd></div></dl></div></div></div></section><section aria-labelledby="course-intro-label" class="relative z-10 -mt-px overflow-hidden rounded-t-[1.75rem] bg-bone text-charcoal shadow-[0_-30px_70px_-20px_rgba(9,17,12,0.55)] sm:rounded-t-[2.5rem]" id="course-intro"><div class="px-5 pb-24 pt-20 sm:px-8 lg:px-12 lg:pb-32 lg:pt-28"><div class="flex flex-wrap items-center justify-between gap-4"><h2 class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-charcoal/70" id="course-intro-label"><span class="tabular-nums">01</span><span aria-hidden="true" class="h-px w-8 bg-current opacity-40"></span><span>The Championship 18</span></h2><p class="font-mono text-[11px] uppercase tracking-[0.24em] text-muted-foreground">Dune · Pine · Heath · Ocean</p></div><p class="mt-12 max-w-[68rem] text-[clamp(1.6rem,3.5vw,3.4rem)] font-light leading-[1.14] tracking-[-0.02em] lg:mt-16 [&amp;_em]:font-serif [&amp;_em]:font-normal" data-intro-statement="true">Every hole at Morrow was found on foot. <em>Two years</em> of walking the estate, in every season and every wind, came before a single line was drawn.</p><div class="mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:gap-8"><div class="flex flex-col justify-between gap-12 lg:col-span-4 lg:py-4"><p class="max-w-md text-[15px] leading-relaxed text-charcoal/75" data-reveal="true">The Championship 18 plays across three landscapes: out along the coast through dune and umbrella pine, up onto the open heath, and home past the reservoir to the clubhouse. Four sets of tees make it a fair walk for every golfer and a serious test from the back.</p><dl class="grid grid-cols-2 gap-x-6 gap-y-10"><div class="flex flex-col-reverse border-t border-charcoal/15 pt-4" data-reveal="true"><dt class="mt-2 text-sm leading-snug text-charcoal/65">sets of tees, from 5,131 to 7,048 yards</dt><dd class="type-wide text-[clamp(1.9rem,3.2vw,3rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="4" data-decimals="0">4</span></span></dd></div><div class="flex flex-col-reverse border-t border-charcoal/15 pt-4" data-reveal="true"><dt class="mt-2 text-sm leading-snug text-charcoal/65">between tee times, so the course never feels busy</dt><dd class="type-wide text-[clamp(1.9rem,3.2vw,3rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="12" data-decimals="0">12</span> min</span></dd></div><div class="flex flex-col-reverse border-t border-charcoal/15 pt-4" data-reveal="true"><dt class="mt-2 text-sm leading-snug text-charcoal/65">years walking the estate before the routing was drawn</dt><dd class="type-wide text-[clamp(1.9rem,3.2vw,3rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="2" data-decimals="0">2</span></span></dd></div><div class="flex flex-col-reverse border-t border-charcoal/15 pt-4" data-reveal="true"><dt class="mt-2 text-sm leading-snug text-charcoal/65">tonnes of imported sand, every bunker is native dune</dt><dd class="type-wide text-[clamp(1.9rem,3.2vw,3rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="0" data-decimals="0">0</span></span></dd></div></dl></div><div class="relative lg:col-span-8"><figure><div class="relative overflow-hidden bg-sand aspect-[4/3] rounded-[4px] sm:aspect-[16/10]" data-mask="left"><div class="absolute inset-x-0 -top-[14%] -bottom-[14%]" data-parallax="8"><div class="relative h-full w-full" data-mask-inner=""><img alt="Fairways curving around a lagoon beneath umbrella pines, the bay shining at sunset" class="object-cover" data-nimg="fill" decoding="async" loading="lazy" sizes="(min-width: 1024px) 66vw, 100vw" src="/images/campaign/lagoon-holes.png" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:center 60%;color:transparent"/></div></div></div><figcaption class="mt-3 font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">The lagoon holes at dusk, 15 to 17</figcaption></figure><figure class="ml-auto mt-8 w-2/3 sm:w-1/2 lg:absolute lg:-bottom-24 lg:right-8 lg:mt-0 lg:w-[32%]"><div class="relative overflow-hidden bg-sand aspect-[4/5] rounded-[4px] ring-8 ring-bone" data-mask="up"><div class="absolute inset-x-0 -top-[14%] -bottom-[14%]" data-parallax="6"><div class="relative h-full w-full" data-mask-inner=""><img alt="A golfer crouching to read a putt beside the flag, the bay and mountains behind" class="object-cover" data-nimg="fill" decoding="async" loading="lazy" sizes="(min-width: 1024px) 26vw, 60vw" src="/images/campaign/reading-the-putt.png" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:36% center;color:transparent"/></div></div></div><figcaption class="mt-3 font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">Greens that reward a patient read</figcaption></figure></div></div></div></section><section aria-labelledby="course-map-heading" class="relative z-10 bg-sand text-charcoal" id="course-map"><div class="relative lg:h-[100svh] lg:min-h-[640px] lg:overflow-hidden"><div class="grid gap-10 px-5 py-20 sm:px-8 lg:h-full lg:grid-cols-12 lg:gap-10 lg:px-12 lg:pb-8 lg:pt-20"><div class="flex flex-col lg:col-span-4 lg:justify-between lg:py-2"><div><p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-charcoal/70"><span class="tabular-nums">02</span><span aria-hidden="true" class="h-px w-8 bg-current opacity-40"></span><span>The course</span></p><h2 class="mt-6 text-[clamp(2.1rem,3.6vw,3.4rem)] font-light leading-[1.02] tracking-[-0.03em]" id="course-map-heading">Eighteen holes. <em class="font-serif font-normal">One unbroken walk.</em></h2><p class="mt-5 max-w-sm text-[15px] leading-relaxed text-charcoal/70 lg:short:hidden">The routing heads out along the coast, climbs through the pines and turns for home across the heath.<span class="hidden lg:inline"> Keep scrolling to walk it hole by hole.</span><span class="lg:hidden"> Choose a hole to fly to it.</span></p></div><div aria-live="polite" class="mt-10 lg:mt-6"><div class="animate-in fade-in slide-in-from-bottom-3 duration-700 ease-out"><div class="flex items-end gap-5"><span class="font-serif text-[clamp(4rem,6vw,6.25rem)] leading-[0.78] tracking-[-0.02em] text-forest">01</span><div class="pb-1"><p class="font-mono text-[10px] uppercase tracking-[0.24em] text-charcoal/55">Hole <!-- -->1<!-- --> of 18</p><h3 class="ty