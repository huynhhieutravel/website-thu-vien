2.6rem,8.4vw,8.75rem)] font-medium uppercase leading-[0.9] tracking-[-0.03em]" data-ph-title="true" id="page-title">Clubhouse</h1><div class="mt-7 flex flex-col gap-6 border-t border-bone/20 pt-5 lg:mt-9 lg:flex-row lg:items-end lg:justify-between"><div class="flex items-end gap-6"><button aria-label="Scroll to the next section" class="group/cue hidden items-center sm:flex" data-ph-fade="true" type="button"><span aria-hidden="true" class="relative block h-10 w-px overflow-hidden bg-bone/25"><span class="absolute inset-x-0 top-0 block h-1/2 animate-scroll-cue bg-bone"></span></span></button><p class="max-w-xl font-serif text-[clamp(1.35rem,2.2vw,2rem)] italic leading-snug text-bone/90" data-ph-fade="true">Set into the slope above the 18th, built from the ground it stands on.</p></div><dl class="grid grid-cols-3 gap-5 sm:gap-8 lg:shrink-0" data-ph-fade="true"><div class="flex flex-col-reverse gap-1.5"><dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-bone/60 sm:text-[10px]">Under one roof</dt><dd class="type-wide text-lg font-medium leading-none sm:text-2xl">1,850 m²</dd></div><div class="flex flex-col-reverse gap-1.5"><dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-bone/60 sm:text-[10px]">Timber canopy</dt><dd class="type-wide text-lg font-medium leading-none sm:text-2xl">64 m</dd></div><div class="flex flex-col-reverse gap-1.5"><dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-bone/60 sm:text-[10px]">Solar by day</dt><dd class="type-wide text-lg font-medium leading-none sm:text-2xl">100%</dd></div></dl></div></div></div></section><section aria-labelledby="clubhouse-intro-label" class="relative z-10 -mt-px overflow-hidden rounded-t-[1.75rem] bg-bone text-charcoal shadow-[0_-30px_70px_-20px_rgba(9,17,12,0.55)] sm:rounded-t-[2.5rem]" id="clubhouse-intro"><div class="px-5 pb-24 pt-20 sm:px-8 lg:px-12 lg:pb-32 lg:pt-28"><div class="flex flex-wrap items-center justify-between gap-4"><h2 class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-charcoal/70" id="clubhouse-intro-label"><span class="tabular-nums">01</span><span aria-hidden="true" class="h-px w-8 bg-current opacity-40"></span><span>The building</span></h2><p class="font-mono text-[11px] uppercase tracking-[0.24em] text-muted-foreground">Rammed earth · Larch · Glass</p></div><p class="mt-12 max-w-[68rem] text-[clamp(1.6rem,3.5vw,3.4rem)] font-light leading-[1.14] tracking-[-0.02em] lg:mt-16 [&amp;_em]:font-serif [&amp;_em]:font-normal" data-intro-statement="true">A building that <em>steps back</em> so the landscape can step forward: low, long and pressed from the earth it stands on.</p><div class="mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:gap-8"><div class="flex flex-col justify-between gap-12 lg:col-span-4 lg:py-4"><p class="max-w-md text-[15px] leading-relaxed text-charcoal/75" data-reveal="true">Designed with architects who studied the old farmsteads of the Alentejo, the clubhouse borrows their thick earthen walls, deep shade and quiet courtyards, then opens a single wall of glass onto the 18th green.</p><dl class="grid grid-cols-2 gap-x-6 gap-y-10"><div class="flex flex-col-reverse border-t border-charcoal/15 pt-4" data-reveal="true"><dt class="mt-2 text-sm leading-snug text-charcoal/65">thick rammed earth walls that hold the cool of the night</dt><dd class="type-wide text-[clamp(1.9rem,3.2vw,3rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="38" data-decimals="0">38</span> cm</span></dd></div><div class="flex flex-col-reverse border-t border-charcoal/15 pt-4" data-reveal="true"><dt class="mt-2 text-sm leading-snug text-charcoal/65">courtyards bringing light and air deep into the building</dt><dd class="type-wide text-[clamp(1.9rem,3.2vw,3rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="4" data-decimals="0">4</span></span></dd></div><div class="flex flex-col-reverse border-t border-charcoal/15 pt-4" data-reveal="true"><dt class="mt-2 text-sm leading-snug text-charcoal/65">solar panels hidden within the timber canopy</dt><dd class="type-wide text-[clamp(1.9rem,3.2vw,3rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="212" data-decimals="0">212</span></span></dd></div><div class="flex flex-col-reverse border-t border-charcoal/15 pt-4" data-reveal="true"><dt class="mt-2 text-sm leading-snug text-charcoal/65">of deep shade along the terrace at midday</dt><dd class="type-wide text-[clamp(1.9rem,3.2vw,3rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="3" data-decimals="0">3</span> m</span></dd></div></dl></div><div class="relative lg:col-span-8"><figure><div class="relative overflow-hidden bg-sand aspect-[4/3] rounded-[4px] sm:aspect-[16/10]" data-mask="left"><div class="absolute inset-x-0 -top-[14%] -bottom-[14%]" data-parallax="8"><div class="relative h-full w-full" data-mask-inner=""><img alt="Guests dining on the glass-fronted clubhouse terrace at golden hour, carts lined up below" class="object-cover" data-nimg="fill" decoding="async" loading="lazy" sizes="(min-width: 1024px) 66vw, 100vw" src="/images/campaign/terrace-dining.png" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:72% center;color:transparent"/></div></div></div><figcaption class="mt-3 font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">The Terrace at golden hour</figcaption></figure></div></div></div></section><section aria-labelledby="clubhouse-heading" class="relative z-10 bg-bone text-charcoal" id="clubhouse"><div class="px-5 py-24 sm:px-8 lg:px-12 lg:py-36"><div class="grid gap-14 lg:grid-cols-12 lg:gap-8"><div class="lg:col-span-5 lg:pt-8"><p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-charcoal/70"><span class="tabular-nums">02</span><span aria-hidden="true" class="h-px w-8 bg-current opacity-40"></span><span>Clubhouse &amp; architecture</span></p><h2 class="mt-6 text-[clamp(2.3rem,4.4vw,4.4rem)] font-light leading-[1.02] tracking-[-0.03em]" id="clubhouse-heading">Built from the ground <em class="font-serif font-normal">it stands on.</em></h2><p class="mt-8 max-w-md text-base leading-relaxed text-charcoal/75" data-reveal="true">The clubhouse is set into the slope above the 18th green, its walls pressed from the estate's own earth and its roof drawn as one long timber line. From the fairway it almost disappears. From the terrace you can see the whole course.</p><ol class="mt-12 border-t border-charcoal/15"><li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-charcoal/15 py-5" data-reveal="true"><span class="pt-0.5 font-mono text-[11px] tabular-nums text-charcoal/50">01</span><div><h3 class="type-wide text-[15px] font-medium uppercase tracking-[0.04em]">Rammed earth</h3><p class="mt-2 text-sm leading-relaxed text-charcoal/70">Walls pressed by hand from soil excavated on site, a building method native to the Alentejo for a thousand years.</p></div></li><li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-charcoal/15 py-5" data-reveal="true"><span class="pt-0.5 font-mono text-[11px] tabular-nums text-charcoal/50">02</span><div><h3 class="type-wide text-[15px] font-medium uppercase tracking-[0.04em]">Timber canopy</h3><p class="mt-2 text-sm leading-relaxed text-charcoal/70">A 64-metre roof of cross-laminated larch, cantilevered over the terrace without a single column.</p></div></li><li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-charcoal/15 py-5" data-reveal="true"><span class="pt-0.5 font-mono text-[11px] tabular-nums text-charcoal/50">03</span><div><h3 class="type-wide text-[15px] font-medium uppercase tracking-[0.04em]">Frameless glass</h3><p class="mt-2 text-sm leading-relaxed text-charcoal/70">The pavilion opens fully onto the 18th green, so the course becomes the fourth wall.</p></div></li><li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-charcoal/15 py-5" data-reveal="true"><span class="pt-0.5 font-mono text-[11px] tabular-nums text-charcoal/50">04</span><div><h3 class="type-wide text-[15px] font-medium uppercase tracking-[0.04em]">Passive climate</h3><p class="mt-2 text-sm leading-relaxed text-charcoal/70">Thermal mass, cross-ventilation and a solar canopy replace air conditioning entirely.</p></div></li></ol></div><div class="lg:col-span-7"><figure><div class="relative aspect-[4/5] overflow-hidden rounded-t-full bg-sand sm:aspect-[5/6] lg:aspect-[4/5]" data-arch="true"><div class="absolute inset-0" data-arch-image="true"><img alt="The final green below a low rammed earth clubhouse with a long timber roof, glowing at dusk" class="object-cover" data-nimg="fill" decoding="async" loading="lazy" sizes="(min-width: 1024px) 58vw, 100vw" src="/images/golf-hole-return.jpg" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent"/></div><div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-pine/60 to-transparent"></div><p class="absolute bottom-5 left-5 right-5 flex justify-between gap-4 font-mono text-[10px] uppercase tracking-[0.22em] text-bone sm:bottom-7 sm:left-7 sm:right-7 sm:text-[11px]"><span>The clubhouse</span><span>Above the 18th green</span></p></div></figure></div></div><div class="mt-16 grid gap-8 lg:mt-28 lg:grid-cols-12 lg:items-end"><figure class="lg:col-span-8"><div class="relative overflow-hidden bg-sand aspect-[16/10] rounded-[4px]" data-mask="left"><div class="absolute inset-x-0 -top-[14%] -bottom-[14%]" data-parallax="8"><div class="relative h-full w-full" data-mask-inner=""><img alt="The clubhouse terrace on the cliff edge, with coastal fairways stretching along the sea below" class="object-cover" data-nimg="fill" decoding="async" loading="lazy" sizes="(min-width: 1024px) 66vw, 100vw" src="/images/campaign/cliff-terrace.png" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:30% center;color:transparent"/></div></div></div><figcaption class="mt-3 flex justify-between gap-4 font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground"><span>The terrace on the cliff above the coast holes</span><span class="hidden sm:inline">1,850 m² under one roof</span></figcaption></figure><figure class="lg:col-span-4"><div class="relative overflow-hidden bg-sand aspect-[4/5] rounded-[4px] lg:aspect-[3/4]" data-mask="up"><div class="absolute inset-x-0 -top-[14%] -bottom-[14%]" data-parallax="6"><div class="relative h-full w-full" data-mask-inner=""><img alt="A golfer walking past the cart court toward the lit clubhouse terrace at sunset" class="object-cover" data-nimg="fill" decoding="async" loading="lazy" sizes="(min-width: 1024px) 33vw, 100vw" src="/images/campaign/clubhouse-arrival.png" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:36% center;color:transparent"/></div></div></div><figcaption class="mt-3 font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">Arriving for a twilight round</figcaption></figure></div><dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-charcoal/15 pt-10 lg:mt-24 lg:grid-cols-4"><div class="flex flex-col-reverse" data-reveal="true"><dt class="mt-2 max-w-[14rem] text-sm leading-snug text-charcoal/65">timber canopy without columns</dt><dd class="type-wide text-[clamp(2rem,3.6vw,3.4rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="64" data-decimals="0">64</span> m</span></dd></div><div class="flex flex-col-reverse" data-reveal="true"><dt class="mt-2 max-w-[14rem] text-sm leading-snug text-charcoal/65">of clubhouse under one roof</dt><dd class="type-wide text-[clamp(2rem,3.6vw,3.4rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="1850" data-decimals="0">1,850</span> m²</span></dd></div><div class="flex flex-col-reverse" data-reveal="true"><dt class="mt-2 max-w-[14rem] text-sm leading-snug text-charcoal/65">of daytime power from the solar canopy</dt><dd class="type-wide text-[clamp(2rem,3.6vw,3.4rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="100" data-decimals="0">100</span>%</span></dd></div><div class="flex flex-col-reverse" data-reveal="true"><dt class="mt-2 max-w-[14rem] text-sm leading-snug text-charcoal/65">air conditioning units, by design</dt><dd class="type-wide text-[clamp(2rem,3.6vw,3.4rem)] font-light leading-none tracking-[-0.03em]"><span><span class="tabular-nums" data-count="0" data-decimals="0">0</span></span></dd></div></dl></div></section><section aria-labelledby="spaces-heading" class="relative z-10 bg-sand text-charcoal" id="spaces"><div class="px-5 py-24 sm:px-8 lg:px-12 lg:py-32"><div class="grid gap-10 lg:grid-cols-12 lg:gap-8"><div class="lg:col-span-7"><p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-charcoal/70"><span class="tabular-nums">03</span><span aria-hidden="true" class="h-px w-8 bg-current opacity-40"></span><span>Inside</span></p><h2 class="mt-6 text-[clamp(2.1rem,4.2vw,4.2rem)] font-light leading-[1.02] tracking-[-0.03em] [&amp;_em]:font-serif [&amp;_em]:font-normal" id="spaces-heading">Six rooms, <em>one long view.</em></h2></div><p class="self-end text-base leading-relaxed lg:col-span-4 lg:col-start-9 text-charcoal/70" data-reveal="true">Every space in the clubhouse faces the course, and every one of them is a little quieter than you expect.</p></div><ol class="mt-14 grid gap-x-8 gap-y-12 lg:mt-20 sm:grid-cols-2 lg:grid-cols-3"><li class="flex flex-col border-t pt-6 border-charcoal/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-charcoal/45">01</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">The Pavilion</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-charcoal/70">The main room of the clubhouse, opening through a wall of frameless glass onto the 18th green.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-clay">Up to 240 seated</p></li><li class="flex flex-col border-t pt-6 border-charcoal/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-charcoal/45">02</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">Members’ lounge</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-charcoal/70">Deep chairs, an open fire in winter and a library of the original routing drawings.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-clay">Members and guests</p></li><li class="flex flex-col border-t pt-6 border-charcoal/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-charcoal/45">03</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">Locker rooms</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-charcoal/70">Timber lockers, a steam room and cold plunge, with towels and shoes cared for between rounds.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-clay">Club care included</p></li><li class="flex flex-col border-t pt-6 border-charcoal/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-charcoal/45">04</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">Pro shop</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-charcoal/70">Apparel made for the climate here, rental sets from every major maker and same-day regripping.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-clay">07:00 to 19:00</p></li><li class="flex flex-col border-t pt-6 border-charcoal/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-charcoal/45">05</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">The Map Room</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-charcoal/70">A private dining room for twelve, lined with the hand-drawn plans of every hole on the estate.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-clay">Private dining for 12</p></li><li class="flex flex-col border-t pt-6 border-charcoal/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-charcoal/45">06</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">The Terrace</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-charcoal/70">All-day dining under the timber canopy with the whole back nine laid out below.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-clay">96 seats inside and out</p></li></ol></div></section><section aria-labelledby="story-heading" class="relative z-10 bg-forest text-bone" id="story"><div class="px-5 py-24 sm:px-8 lg:px-12 lg:py-32"><div class="grid gap-10 lg:grid-cols-12 lg:gap-8"><div class="lg:col-span-7"><p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-bone/70"><span class="tabular-nums">04</span><span aria-hidden="true" class="h-px w-8 bg-current opacity-40"></span><span>The story</span></p><h2 class="mt-6 text-[clamp(2.1rem,4.2vw,4.2rem)] font-light leading-[1.02] tracking-[-0.03em] [&amp;_em]:font-serif [&amp;_em]:font-normal" id="story-heading">From the first walk <em>to the first tee.</em></h2></div></div><ol class="mt-14 grid gap-x-8 gap-y-12 lg:mt-20 sm:grid-cols-2 lg:grid-cols-4"><li class="flex flex-col border-t pt-6 border-bone/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-bone/45">01</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">The first walk</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-bone/70">Two architects and a greenkeeper spend a full year walking the estate before a single hole is drawn.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ochre">2019</p></li><li class="flex flex-col border-t pt-6 border-bone/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-bone/45">02</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">Restoring the heath</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-bone/70">One hundred and forty-two hectares are cleared of invasive acacia and replanted with native heather.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ochre">2021</p></li><li class="flex flex-col border-t pt-6 border-bone/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-bone/45">03</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">Pressing the walls</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-bone/70">The rammed earth walls rise layer by layer from soil excavated for the foundations.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ochre">2023</p></li><li class="flex flex-col border-t pt-6 border-bone/15" data-reveal="true"><span class="font-mono text-[11px] tabular-nums text-bone/45">04</span><h3 class="type-wide text-[17px] font-medium uppercase leading-snug tracking-[0.02em] mt-5">Doors open</h3><p class="mt-3 max-w-sm text-[15px] leading-relaxed text-bone/70">The first tee time goes out at seven on a spring morning, and the terrace fills by noon.</p><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ochre">2026</p></li></ol></div></section><section aria-label="Next page" class="relative z-10 bg-charcoal"><a class="group relative block h-[78svh] min-h-[440px] overflow-hidden text-bone" href="/morrow-original/academy"><div class="overflow-hidden absolute inset-0 h-full w-full bg-pine"><div class="absolute inset-x-0 -top-[14%] -bottom-[14%]" data-parallax="10"><div class="relative h-full w-