-2xl border px-3.5 py-3.5 text-left transition-colors duration-300 sm:gap-4 sm:px-4 border-transparent bg-white/60 hover:bg-white"><span class="w-6 shrink-0 font-mono text-[11px] tabular-nums text-ink/40">02</span><span class="min-w-0 flex-1"><span class="block text-[15px] font-semibold text-ink">Red and infrared LEDs</span><span class="block text-[12px] text-ink/50">3 emitters · overnight</span></span><span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] bg-surface text-ink/55">Optical</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-3 rounded-2xl border px-3.5 py-3.5 text-left transition-colors duration-300 sm:gap-4 sm:px-4 border-transparent bg-white/60 hover:bg-white"><span class="w-6 shrink-0 font-mono text-[11px] tabular-nums text-ink/40">03</span><span class="min-w-0 flex-1"><span class="block text-[15px] font-semibold text-ink">Photodiode array</span><span class="block text-[12px] text-ink/50">4 receivers · 24-bit</span></span><span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] bg-surface text-ink/55">Optical</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-3 rounded-2xl border px-3.5 py-3.5 text-left transition-colors duration-300 sm:gap-4 sm:px-4 border-transparent bg-white/60 hover:bg-white"><span class="w-6 shrink-0 font-mono text-[11px] tabular-nums text-ink/40">04</span><span class="min-w-0 flex-1"><span class="block text-[15px] font-semibold text-ink">Skin temperature</span><span class="block text-[12px] text-ink/50">0.01 °C resolution</span></span><span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] bg-surface text-ink/55">Thermal</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-3 rounded-2xl border px-3.5 py-3.5 text-left transition-colors duration-300 sm:gap-4 sm:px-4 border-transparent bg-white/60 hover:bg-white"><span class="w-6 shrink-0 font-mono text-[11px] tabular-nums text-ink/40">05</span><span class="min-w-0 flex-1"><span class="block text-[15px] font-semibold text-ink">Ambient temperature</span><span class="block text-[12px] text-ink/50">Outer shell reference</span></span><span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] bg-surface text-ink/55">Thermal</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-3 rounded-2xl border px-3.5 py-3.5 text-left transition-colors duration-300 sm:gap-4 sm:px-4 border-transparent bg-white/60 hover:bg-white"><span class="w-6 shrink-0 font-mono text-[11px] tabular-nums text-ink/40">06</span><span class="min-w-0 flex-1"><span class="block text-[15px] font-semibold text-ink">Accelerometer</span><span class="block text-[12px] text-ink/50">3 axes · up to 400 Hz</span></span><span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] bg-surface text-ink/55">Motion</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-3 rounded-2xl border px-3.5 py-3.5 text-left transition-colors duration-300 sm:gap-4 sm:px-4 border-transparent bg-white/60 hover:bg-white"><span class="w-6 shrink-0 font-mono text-[11px] tabular-nums text-ink/40">07</span><span class="min-w-0 flex-1"><span class="block text-[15px] font-semibold text-ink">Gyroscope</span><span class="block text-[12px] text-ink/50">3 axes · same package</span></span><span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] bg-surface text-ink/55">Motion</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-3 rounded-2xl border px-3.5 py-3.5 text-left transition-colors duration-300 sm:gap-4 sm:px-4 border-transparent bg-white/60 hover:bg-white"><span class="w-6 shrink-0 font-mono text-[11px] tabular-nums text-ink/40">08</span><span class="min-w-0 flex-1"><span class="block text-[15px] font-semibold text-ink">Barometric altimeter</span><span class="block text-[12px] text-ink/50">0.1 m relative accuracy</span></span><span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] bg-surface text-ink/55">Pressure</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-3 rounded-2xl border px-3.5 py-3.5 text-left transition-colors duration-300 sm:gap-4 sm:px-4 border-transparent bg-white/60 hover:bg-white"><span class="w-6 shrink-0 font-mono text-[11px] tabular-nums text-ink/40">09</span><span class="min-w-0 flex-1"><span class="block text-[15px] font-semibold text-ink">Dual-frequency GNSS</span><span class="block text-[12px] text-ink/50">L1 + L5 · 5 systems</span></span><span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] bg-surface text-ink/55">Position</span></button></li></ul></div></div></div></section><section id="signal" aria-labelledby="signal-title" class="bg-surface py-24 sm:py-36"><div class="mx-auto max-w-[1440px] px-5 sm:px-8"><div class="grid gap-10 sm:gap-12 lg:grid-cols-12"><div class="lg:col-span-4"><div class="@container w-full"><p data-reveal="fade" class="eyebrow flex items-center gap-3 text-ink/55"><span class="text-signal-deep">02</span><span class="h-px w-8 bg-ink/25" aria-hidden="true"></span>Signal processing</p><h2 id="signal-title" data-split="true" class="mt-6 font-display text-[clamp(1.75rem,9cqw,5rem)] uppercase leading-[0.92] text-ink text-balance"><span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">From</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">noise</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">to</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">a</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">heartbeat.</span></span></h2><div data-reveal="true" class="mt-6 max-w-xl text-base leading-relaxed sm:text-[17px] text-ink/60 text-pretty">Running is the hardest test for a wrist sensor. Step through what happens to the light signal in the fraction of a second before a number reaches your phone.</div></div><ol data-stagger="true" class="mt-10 space-y-5"><li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4"><span class="font-mono text-[11px] tabular-nums text-signal-deep">01</span><span><span class="block text-[15px] font-semibold text-ink">Capture</span><span class="mt-0.5 block text-[13px] leading-relaxed text-ink/60">Light and motion sampled up to 256 times a second, in sync.</span></span></li><li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4"><span class="font-mono text-[11px] tabular-nums text-signal-deep">02</span><span><span class="block text-[15px] font-semibold text-ink">Clean</span><span class="mt-0.5 block text-[13px] leading-relaxed text-ink/60">Arm swing, footstrike and ambient light subtracted on the band.</span></span></li><li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4"><span class="font-mono text-[11px] tabular-nums text-signal-deep">03</span><span><span class="block text-[15px] font-semibold text-ink">Detect</span><span class="mt-0.5 block text-[13px] leading-relaxed text-ink/60">Every beat timed to the millisecond, every interval stored.</span></span></li><li class="grid grid-cols-[auto_minmax(0,1fr)] gap-4"><span class="font-mono text-[11px] tabular-nums text-signal-deep">04</span><span><span class="block text-[15px] font-semibold text-ink">Interpret</span><span class="mt-0.5 block text-[13px] leading-relaxed text-ink/60">Heart rate, HRV, sleep and load scored against your own baseline.</span></span></li></ol></div><div data-reveal="true" class="lg:col-span-8"><div class="rounded-[20px] bg-white p-4 sm:rounded-[28px] sm:p-8"><div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><p class="eyebrow text-ink/55">Optical signal · 3.2 seconds of a tempo run</p><div class="no-scrollbar -mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0"><div role="radiogroup" aria-label="Processing stage" class="no-scrollbar inline-flex max-w-full shrink-0 items-center overflow-x-auto rounded-full bg-surface p-1 sm:overflow-visible"><button type="button" role="radio" aria-checked="true" tabindex="0" class="shrink-0 whitespace-nowrap rounded-full font-semibold transition-all duration-300 h-8 px-3 text-xs sm:h-7 bg-white text-ink shadow-[0_1px_2px_rgba(0,0,0,0.08),0_4px_12px_-6px_rgba(0,0,0,0.25)]">1 · Raw</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="shrink-0 whitespace-nowrap rounded-full font-semibold transition-all duration-300 h-8 px-3 text-xs sm:h-7 text-ink/55 hover:text-ink">2 · Cleaned</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="shrink-0 whitespace-nowrap rounded-full font-semibold transition-all duration-300 h-8 px-3 text-xs sm:h-7 text-ink/55 hover:text-ink">3 · Beats</button></div></div></div><div class="relative mt-6 h-[220px] sm:h-[260px]"><svg viewBox="0 0 1000 200" preserveAspectRatio="none" role="img" aria-label="Raw light. What the photodiodes see mid-run. Arm swing moves the band and the blood beneath it, and that motion is far louder than your pulse." class="absolute inset-0 size-full overflow-visible"><line x1="0" x2="1000" y1="50" y2="50" stroke="var(--ink)" stroke-opacity="0.06" vector-effect="non-scaling-stroke"></line><line x1="0" x2="1000" y1="100" y2="100" stroke="var(--ink)" stroke-opacity="0.06" vector-effect="non-scaling-stroke"></line><line x1="0"