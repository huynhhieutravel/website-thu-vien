000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bed-double size-5 text-ink" aria-hidden="true"><path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"></path><path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"></path><path d="M12 4v6"></path><path d="M2 18h20"></path></svg><h3 class="mt-5 text-lg font-semibold text-ink">Personal sleep need</h3><p class="mt-2 text-[15px] leading-relaxed text-ink/60">Your nightly target adapts to yesterday&#x27;s strain and any sleep debt you are carrying.</p></li><li class="rounded-[24px] bg-surface p-6 sm:p-7"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sunrise size-5 text-ink" aria-hidden="true"><path d="M12 2v8"></path><path d="m4.93 10.93 1.41 1.41"></path><path d="M2 18h2"></path><path d="M20 18h2"></path><path d="m19.07 10.93-1.41 1.41"></path><path d="M22 22H2"></path><path d="m8 6 4-4 4 4"></path><path d="M16 18a4 4 0 0 0-8 0"></path></svg><h3 class="mt-5 text-lg font-semibold text-ink">Consistency coaching</h3><p class="mt-2 text-[15px] leading-relaxed text-ink/60">A bedtime window built from your best nights, nudged gently when your schedule drifts.</p></li></ul></div></section><section id="hrv" aria-labelledby="hrv-title" class="bg-white pb-24 sm:pb-36"><div class="mx-auto max-w-[1440px] px-5 sm:px-8"><div class="grid gap-10 sm:gap-12 lg:grid-cols-12"><div class="lg:col-span-5"><div class="@container w-full"><p data-reveal="fade" class="eyebrow flex items-center gap-3 text-ink/55"><span class="text-signal-deep">04</span><span class="h-px w-8 bg-ink/25" aria-hidden="true"></span>Heart-rate variability</p><h2 id="hrv-title" data-split="true" class="mt-6 font-display text-[clamp(1.75rem,9cqw,5rem)] uppercase leading-[0.92] text-ink text-balance"><span cla