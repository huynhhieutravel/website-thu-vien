---
// v2/src/pages/helix/contact.astro - Website 28: Helix (Contact Native)
import HelixLayout from '../../layouts/HelixLayout.astro';
---

<HelixLayout
  title="Contact | Helix"
  description="Contact sheet — Write to the archive."
  currentPath="/helix/contact"
>
  <main>
    <section id="write" class="px-[clamp(18px,4vw,46px)] pb-[clamp(60px,12vh,140px)] pt-[clamp(104px,20vh,200px)]">
      <div class="mx-auto grid max-w-[1440px] grid-cols-12 gap-x-[clamp(10px,1.8vw,26px)] gap-y-[clamp(48px,10vh,110px)]">
        <div class="col-span-12 lg:col-span-7">
          <div data-reveal="" class="mb-[clamp(24px,4vh,44px)] flex flex-wrap items-baseline justify-between gap-4">
            <p class="micro-wide text-ink/30">
              Contact sheet<span aria-hidden="true" class="ml-2 inline-block h-[0.9em] w-[6px] translate-y-[1px] animate-pulse bg-ember align-middle"></span>
            </p>
            <p class="micro text-ink/25">
              <span id="exposed-counter" class="transition-colors duration-700">00</span> / 04 exposed
            </p>
          </div>

          <form id="contact-form" novalidate="" data-reveal="">
            <div class="border-b border-ink/10">
              <!-- Field 01: Name -->
              <div class="group relative border-t border-ink/10">
                <div class="grid grid-cols-12 gap-x-4 py-[clamp(18px,3.2vh,30px)]">
                  <div class="col-span-12 mb-4 flex items-center gap-3 sm:col-span-3 sm:mb-0 sm:pt-[0.45em]">
                    <span id="dot-name" aria-hidden="true" class="block size-[7px] shrink-0 rounded-full border transition-colors duration-700 border-ink/25 bg-transparent"></span>
                    <label for="name" class="micro-wide cursor-text text-ink/35 transition-colors duration-500 group-focus-within:text-ink/75">
                      01 — Who is writing
                    </label>
                  </div>
                  <div class="col-span-12 sm:col-span-9">
                    <input
                      id="name"
                      type="text"
                      autocomplete="name"
                      placeholder="Your name"
                      class="w-full bg-transparent text-[clamp(17px,1.9vw,26px)] font-medium leading-[1.45] tracking-[-0.02em] text-ink caret-ember outline-none transition-colors duration-500 placeholder:text-ink/20"
                      name="name"
                    />
                  </div>
                </div>
                <span aria-hidden="true" class="absolute inset-x-0 bottom-0 block h-px origin-left scale-x-0 bg-ember transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-focus-within:scale-x-100"></span>
              </div>

              <!-- Field 02: Email -->
              <div class="group relative border-t border-ink/10">
                <div class="grid grid-cols-12 gap-x-4 py-[clamp(18px,3.2vh,30px)]">
                  <div class="col-span-12 mb-4 flex items-center gap-3 sm:col-span-3 sm:mb-0 sm:pt-[0.45em]">
                    <span id="dot-email" aria-hidden="true" class="block size-[7px] shrink-0 rounded-full border transition-colors duration-700 border-ink/25 bg-transparent"></span>
                    <label for="email" class="micro-wide cursor-text text-ink/35 transition-colors duration-500 group-focus-within:text-ink/75">
                      02 — Where to answer
                    </label>
                  </div>
                  <div class="col-span-12 sm:col-span-9">
                    <input
                      id="email"
                      type="email"
                      autocomplete="email"
                      placeholder="you@somewhere"
                      class="w-full bg-transparent text-[clamp(17px,1.9vw,26px)] font-medium leading-[1.45] tracking-[-0.02em] text-ink caret-ember outline-none transition-colors duration-500 placeholder:text-ink/20"
                      name="email"
                    />
                  </div>
                </div>
                <span aria-hidden="true" class="absolute inset-x-0 bottom-0 block h-px origin-left scale-x-0 bg-ember transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-focus-within:scale-x-100"></span>
              </div>

              <!-- Field 03: Subject -->
              <div class="group relative border-t border-ink/10">
                <div class="grid grid-cols-12 gap-x-4 py-[clamp(18px,3.2vh,30px)]">
                  <div class="col-span-12 mb-4 flex items-center gap-3 sm:col-span-3 sm:mb-0 sm:pt-[0.45em]">
                    <span id="dot-subject" aria-hidden="true" class="block size-[7px] shrink-0 rounded-full border transition-colors duration-700 border-ink/25 bg-transparent"></span>
                    <label for="subject" class="micro-wide cursor-text text-ink/35 transition-colors duration-500 group-focus-within:text-ink/75">
                      03 — The subject
                    </label>
                  </div>
                  <div class="col-span-12 sm:col-span-9">
                    <input
                      id="subject"
                      type="text"
                      placeholder="A print, a show, a commission"
                      class="w-full bg-transparent text-[clamp(17px,1.9vw,26px)] font-medium leading-[1.45] tracking-[-0.02em] text-ink caret-ember outline-none transition-colors duration-500 placeholder:text-ink/20"
                      name="subject"
                    />
                  </div>
                </div>
                <span aria-hidden="true" class="absolute inset-x-0 bottom-0 block h-px origin-left scale-x-0 bg-ember transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-focus-within:scale-x-100"></span>
              </div>

              <!-- Field 04: Message -->
              <div class="group relative border-t border-ink/10">
                <div class="grid grid-cols-12 gap-x-4 py-[clamp(18px,3.2vh,30px)]">
                  <div class="col-span-12 mb-4 flex items-center gap-3 sm:col-span-3 sm:mb-0 sm:pt-[0.45em]">
                    <span id="dot-message" aria-hidden="true" class="block size-[7px] shrink-0 rounded-full border transition-colors duration-700 border-ink/25 bg-transparent"></span>
                    <label for="message" class="micro-wide cursor-text text-ink/35 transition-colors duration-500 group-focus-within:text-ink/75">
                      04 — The frame itself
                    </label>
                  </div>
                  <div class="col-span-12 sm:col-span-9">
                    <textarea
                      id="message"
                      name="message"
                      rows="2"
                      placeholder="Take your time"
                      class="w-full bg-transparent text-[clamp(17px,1.9vw,26px)] font-medium leading-[1.45] tracking-[-0.02em] text-ink caret-ember outline-none transition-colors duration-500 placeholder:text-ink/20 block resize-none overflow-hidden"
                    ></textarea>
                  </div>
                </div>
                <span aria-hidden="true" class="absolute inset-x-0 bottom-0 block h-px origin-left scale-x-0 bg-ember transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-focus-within:scale-x-100"></span>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="mt-8 flex items-center justify-between">
              <button
                type="submit"
                class="group inline-flex items-center gap-3 py-3 text-ink transition-colors duration-500 hover:text-ember cursor-pointer"
              >
                <span class="micro uppercase tracking-[0.24em]">Expose to the archive</span>
                <span class="inline-flex items-center">
                  <span class="block h-px bg-current transition-all duration-500 ease-out w-2 group-hover:w-6"></span>
                  <svg width="7" height="8" viewBox="0 0 7 8" fill="none" class="-ml-px block">
                    <path d="M1 1L5 4L1 7" stroke="currentColor" stroke-width="1" stroke-linecap="square"></path>
                  </svg>
                </span>
              </button>
              <p id="submit-feedback" aria-live="polite" class="micro min-h-[1.4em] transition-opacity duration-500 opacity-0 text-ember">
                Received into the coil.
              </p>
            </div>
          </form>
        </div>

        <!-- Sidebar Info: Other ways in -->
        <div class="col-span-12 lg:col-span-4 lg:col-start-9">
          <h2 data-reveal="" class="micro-wide mb-2 text-ink/30">Other ways in</h2>
          <ul>
            <li data-reveal="" style="transition-delay:0ms">
              <a href="mailto:frames@helix.archive" class="group block w-full border-t border-ink/10 pb-5 pt-5 text-left outline-none">
                <span class="micro text-ink/45 transition-colors duration-500 group-hover:text-ink group-focus-visible:text-ink">Post</span>
                <span class="mt-3 block overflow-hidden">
                  <span class="reveal-value block text-[clamp(15px,1.5vw,20px)] font-medium tracking-[-0.015em] text-ink/85 transition-transform duration-700">frames@helix.archive</span>
                </span>
                <span class="micro mt-2 block text-ink/20 transition-colors duration-700 group-hover:text-ink/40">Read every Thursday</span>
                <span aria-hidden="true" class="mt-4 block h-px w-full origin-left scale-x-0 bg-ember/60 transition-transform duration-700 ease-out group-hover:scale-x-100"></span>
              </a>
            </li>

            <li data-reveal="" style="transition-delay:80ms">
              <button
                type="button"
                data-copy="4th floor, 118 Watt Street"
                aria-label="Copy Darkroom address"
                class="group block w-full border-t border-ink/10 pb-5 pt-5 text-left outline-none cursor-pointer"
              >
                <span class="micro text-ink/45 transition-colors duration-500 group-hover:text-ink">Darkroom</span>
                <span class="mt-3 block overflow-hidden">
                  <span class="reveal-value block text-[clamp(15px,1.5vw,20px)] font-medium tracking-[-0.015em] text-ink/85">4th floor, 118 Watt Street</span>
                </span>
                <span class="micro mt-2 block text-ink/20 transition-colors duration-700 group-hover:text-ink/40">Buzzer marked HELIX</span>
                <span aria-hidden="true" class="mt-4 block h-px w-full origin-left scale-x-0 bg-ember/60 transition-transform duration-700 ease-out group-hover:scale-x-100"></span>
              </button>
            </li>

            <li data-reveal="" style="transition-delay:160ms">
              <a href="https://instagram.com" target="_blank" rel="noreferrer noopener" class="group block w-full border-t border-ink/10 pb-5 pt-5 text-left outline-none">
                <span class="micro text-ink/45 transition-colors duration-500 group-hover:text-ink">Elsewhere</span>
                <span class="mt-3 block overflow-hidden">
                  <span class="reveal-value block text-[clamp(15px,1.5vw,20px)] font-medium tracking-[-0.015em] text-ink/85">@helix.archive</span>
                </span>
                <span class="micro mt-2 block text-ink/20 transition-colors duration-700 group-hover:text-ink/40">One frame a week, no more</span>
                <span aria-hidden="true" class="mt-4 block h-px w-full origin-left scale-x-0 bg-ember/60 transition-transform duration-700 ease-out group-hover:scale-x-100"></span>
              </a>
            </li>

            <li data-reveal="" style="transition-delay:240ms">
              <button
                type="button"
                data-copy="Thursday to Saturday, 14–20"
                aria-label="Copy Hours"
                class="group block w-full border-t border-ink/10 pb-5 pt-5 text-left outline-none cursor-pointer"
              >
                <span class="micro text-ink/45 transition-colors duration-500 group-hover:text-ink">Hours</span>
                <span class="mt-3 block overflow-hidden">
                  <span class="reveal-value block text-[clamp(15px,1.5vw,20px)] font-medium tracking-[-0.015em] text-ink/85">Thursday to Saturday, 14–20</span>
                </span>
                <span class="micro mt-2 block text-ink/20 transition-colors duration-700 group-hover:text-ink/40">Knock, the bell is broken</span>
                <span aria-hidden="true" class="mt-4 block h-px w-full origin-left scale-x-0 bg-ember/60 transition-transform duration-700 ease-out group-hover:scale-x-100"></span>
              </button>
            </li>
          </ul>

          <p data-reveal="" style="transition-delay:340ms" class="mt-8 border-t border-ink/10 pt-6 text-[clamp(13px,1vw,15px)] leading-[1.8] text-ink/35">
            We do not sell prints and we do not take submissions by attachment. Tell us what the picture is doing, and we will ask to see it.
          </p>
        </div>
      </div>
    </section>
  </main>
</HelixLayout>

<script>
  function initContactForm() {
    const inputs = ['name', 'email', 'subject', 'message'].map(id => document.getElementById(id));
    const counter = document.getElementById('exposed-counter');
    const form = document.getElementById('contact-form');
    const feedback = document.getElementById('submit-feedback');

    function updateCount() {
      let count = 0;
      inputs.forEach(inp => {
        if (!inp) return;
        const val = inp.value.trim();
        const dot = document.getElementById(`dot-${inp.id}`);
        if (val.length > 0) {
          count++;
          if (dot) {
            dot.style.background = '#c8a86a';
            dot.style.borderColor = '#c8a86a';
          }
        } else {
          if (dot) {
            dot.style.background = 'transparent';
            dot.style.borderColor = 'rgba(244, 242, 238, 0.25)';
          }
        }
      });
      if (counter) {
        counter.textContent = String(count).padStart(2, '0');
        counter.style.color = count > 0 ? '#c8a86a' : '';
      }
    }

    inputs.forEach(inp => {
      if (inp) inp.addEventListener('input', updateCount);
    });

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (feedback) {
          feedback.style.opacity = '1';
          setTimeout(() => { feedback.style.opacity = '0'; }, 4000);
        }
      });
    }

    // Copy to clipboard
    document.querySelectorAll('[data-copy]').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-copy');
        if (text) {
          navigator.clipboard.writeText(text).catch(() => {});
          const originalText = btn.querySelector('.reveal-value');
          if (originalText) {
            const old = originalText.textContent;
            originalText.textContent = 'Copied to clipboard';
            setTimeout(() => { originalText.textContent = old; }, 2000);
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>

