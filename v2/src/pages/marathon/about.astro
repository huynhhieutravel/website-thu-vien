---
// v2/src/pages/marathon/about.astro - Website 31: Marathon About
import rawHtml from '../../raw/marathon-about-original-raw.html?raw';

const adaptedHtml = rawHtml
  .replaceAll('/marathon-original/about', '/marathon/about')
  .replaceAll('/marathon-original/contact', '/marathon/contact')
  .replaceAll('/marathon-original', '/marathon')
  .replace('MARATHON — BẢN GỐC 1-TO-1 (THREE.JS / WEBGL)', 'MARATHON — 3D RUNNING TELEMETRY (THREE.JS / WEBGL)')
  .replace(/<a href="\/marathon" style="background:#e94e1b;color:#fff;padding:4px 12px;border-radius:9999px;text-decoration:none;font-size:11.5px;font-weight:600;letter-spacing:0.02em;transition:opacity 0.2s;">\s*XEM BẢN ASTRO CODE →\s*<\/a>/, '<span style="background:rgba(255,255,255,0.08);color:#e2e8f0;padding:4px 12px;border-radius:9999px;font-size:11px;font-weight:600;letter-spacing:0.02em;">IPHONE 17 PRO 3D MODEL</span>');
---

<Fragment set:html={adaptedHtml} />
