---
// v2/src/pages/galleries/cabin-suites.astro
// Thư viện 02: VIP Cabin & Suite Interiors
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import BookingModal from '../../components/BookingModal.astro';

const cabinImages = [
  {
    src: "/images/aerive/window.png",
    thumb: "/images/aerive/window.png",
    title: "Khung Cửa Sổ Bầu Dục Toàn Cảnh (Panoramic Oval Windows)",
    alt: "Cửa sổ bầu dục máy bay tư nhân khổ lớn đón trọn ánh nắng ban mai và quang cảnh mây trời",
    caption: "16 ô cửa sổ siêu lớn thiết kế khí động học mang lại tầm nhìn vô cực và ánh sáng tự nhiên ngập tràn khoang khách.",
    meta: "Kính chống tia cực tím 99.9% | Màn chắn điện tử thông minh | Ánh sáng tự nhiên tối đa"
  },
  {
    src: "/images/aerive/cloud-wisps.png",
    thumb: "/images/aerive/cloud-wisps.png",
    title: "Không Gian Yên Tĩnh & Cách Âm Đỉnh Cao (<48 dBA)",
    alt: "Tầng mây tĩnh lặng nhìn qua lớp kính cách âm hai lớp của chuyên cơ tư nhân",
    caption: "Công nghệ giảm chấn âm thanh chủ động tạo nên không gian yên ắng như phòng đọc sách thư thái tại gia.",
    meta: "Độ ồn cabin: <48 dBA | Hệ thống lọc khí HEPA 100% | Bơm oxy tươi mỗi 2 phút"
  },
  {
    src: "/images/aerive/advantage-pets-2.png",
    thumb: "/images/aerive/advantage-pets-2.png",
    title: "Ghế Da Thủ Công Thuỵ Sĩ & Không Gian Thú Cưng",
    alt: "Nội thất da thật may tay màu đen tuyền mềm mại bên cạnh cửa sổ cabin",
    caption: "Từng chiếc ghế được bọc da bò thượng hạng từ dãy Alps, có thể xoay 360 độ và ngả thành giường phẳng hoàn toàn.",
    meta: "Chất liệu da thuộc hữu cơ | Nệm lông vũ tự nhiên | Giường phẳng 180 độ"
  },
  {
    src: "/images/aerive/advantage-dining-2.png",
    thumb: "/images/aerive/advantage-dining-2.png",
    title: "Bàn Họp & Ăn Uống Sơn Mài Đen Bóng (Lacquered Suite Table)",
    alt: "Mặt bàn gỗ sơn mài đen bóng loáng phản chiếu ánh sáng sang trọng trong cabin máy bay",
    caption: "Bàn gỗ tự nhiên sơn mài thủ công nhiều lớp, tích hợp sạc không dây và màn hình điều khiển thông minh ẩn.",
    meta: "Mặt gỗ nguyên khối | Kết nối vệ tinh Starlink | Màn hình 4K HDR cảm ứng"
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Thư Viện Nội Thất Khoang Khách VIP & Cabin Suites AERIVE",
  "description": "Hình ảnh chi tiết không gian nội thất khoang hạng nhất, giường nằm phẳng và cửa sổ toàn cảnh của chuyên cơ AERIVE.",
  "url": "https://aerive-template.modulify.website/galleries/cabin-suites",
  "associatedMedia": cabinImages.map((img) => ({
    "@type": "ImageObject",
    "contentUrl": img.src,
    "name": img.title,
    "description": img.caption,
    "encodingFormat": "image/png"
  }))
};
---

<Layout
  title="Thư Viện 02: VIP Cabin & Suite Interiors — Không Gian Sống Tầng Bình Lưu | AERIVE"
  description="Khám phá chi tiết không gian nội thất 3 gian độc lập, giường nằm phẳng đôi, ghế bọc da thủ công và 16 cửa sổ toàn cảnh trên chuyên cơ AERIVE."
  ogImage="/images/aerive/window.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Top Breadcrumb Bar -->
  <header class="sticky top-0 z-50 bg-obsidian/95 backdrop-blur-md border-b border-champagne/15 px-5 py-3 flex items-center justify-between text-[11px] uppercase tracking-[0.2em]">
    <div class="flex items-center gap-3">
      <a href="/" class="text-smoke hover:text-champagne transition-colors">Trang Chủ</a>
      <span class="text-smoke/40">/</span>
      <a href="/archive" class="text-champagne hover:text-ivory transition-colors flex items-center gap-1.5">
        <span>Kho Thư Viện</span>
      </a>
      <span class="text-smoke/40">/</span>
      <span class="text-ivory/80">Thư viện 02: VIP Cabin & Suites</span>
    </div>
    <a href="/" class="text-smoke hover:text-champagne transition-colors hidden sm:inline">
      Về Trang Chủ 3D →
    </a>
  </header>

  <!-- Gallery Header Hero -->
  <section class="relative px-5 pt-20 pb-16 md:px-[6vw] md:pt-28 md:pb-20 border-b border-champagne/15">
    <div class="max-w-5xl">
      <span class="rounded-full bg-champagne/10 border border-champagne/30 px-3.5 py-1 text-[11px] uppercase tracking-[0.22em] text-champagne">
        Thư viện chuyên đề • 02
      </span>
      <h1 class="mt-6 font-heading text-[clamp(2.8rem,7vw,5.5rem)] font-light leading-[0.95] text-ivory">
        VIP Cabin & Suite Interiors<br />
        <span class="text-champagne">Nghệ thuật không gian sống ở độ cao 45,000 feet.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-ivory/75">
        Được chia thành ba không gian sinh hoạt tách biệt: phòng khách hội đàm, khu ẩm thực và phòng ngủ yên tĩnh với giường phẳng hoàn toàn. Mọi chi tiết đều được chăm chút để tái tạo năng lượng trọn vẹn cho bạn.
      </p>
    </div>
  </section>

  <!-- Masonry Images Grid -->
  <section class="px-5 py-16 md:px-[6vw] md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {cabinImages.map((img, idx) => (
        <figure class="group relative overflow-hidden rounded-[16px] border border-champagne/15 bg-onyx transition-all duration-500 hover:border-champagne/60 hover:shadow-[0_25px_60px_rgba(0,0,0,0.8)]" itemprop="associatedMedia" itemscope itemtype="https://schema.org/ImageObject">
          <div class="relative aspect-[16/10] w-full overflow-hidden cursor-pointer js-open-photo" data-idx={idx}>
            <img src={img.src} alt={img.alt} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" itemprop="contentUrl" />
            <div class="absolute inset-0 bg-linear-to-t from-obsidian/85 via-transparent to-transparent opacity-60"></div>
            <div class="absolute right-4 top-4 flex size-10 items-center justify-center rounded-full bg-obsidian/80 backdrop-blur-md border border-champagne/30 text-champagne opacity-0 translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
            </div>
          </div>
          <figcaption class="p-6">
            <h3 class="font-heading text-[1.5rem] font-normal text-ivory group-hover:text-champagne transition-colors" itemprop="name">
              {img.title}
            </h3>
            <p class="mt-2 text-[13px] leading-relaxed text-smoke" itemprop="description">
              {img.caption}
            </p>
            <div class="mt-4 flex items-center justify-between border-t border-champagne/10 pt-3 text-[11px] text-champagne/80">
              <span>{img.meta}</span>
              <button type="button" class="underline underline-offset-4 js-open-photo hover:text-champagne" data-idx={idx}>Mở ảnh lớn</button>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Interactive Lightbox Dialog -->
  <dialog id="photo-dialog" class="fixed inset-0 m-0 h-full w-full max-h-none max-w-none bg-obsidian/95 p-4 md:p-8 backdrop-blur-xl backdrop:bg-black/90 text-ivory">
    <div class="flex h-full flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="font-heading text-[1.4rem] tracking-[0.2em] text-champagne">AERIVE VIP SUITES</span>
        <button type="button" id="dialog-close" class="flex size-11 items-center justify-center rounded-full border border-champagne/20 text-champagne hover:bg-champagne hover:text-obsidian">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
      </div>
      <div class="flex flex-1 items-center justify-center p-4">
        <img id="dialog-img" src="" alt="" class="max-h-[75vh] max-w-[90vw] object-contain rounded-[8px]" />
      </div>
      <div class="mx-auto max-w-xl text-center">
        <h4 id="dialog-title" class="font-heading text-[1.6rem] text-champagne"></h4>
        <p id="dialog-desc" class="mt-1 text-[13px] text-smoke"></p>
      </div>
    </div>
  </dialog>

  <script is:inline define:vars={{ cabinImages }}>
    const dialog = document.getElementById('photo-dialog');
    const dImg = document.getElementById('dialog-img');
    const dTitle = document.getElementById('dialog-title');
    const dDesc = document.getElementById('dialog-desc');
    const dClose = document.getElementById('dialog-close');

    document.querySelectorAll('.js-open-photo').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
        const item = cabinImages[idx];
        if (item && dialog) {
          dImg.src = item.src;
          dImg.alt = item.alt;
          dTitle.textContent = item.title;
          dDesc.textContent = item.caption;
          dialog.showModal();
        }
      });
    });

    dClose?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  </script>

  <Footer />
  <BookingModal />
</Layout>
