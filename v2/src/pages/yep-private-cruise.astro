          ease: "none",
          scrollTrigger: {
            trigger: ".night",
            start: "top bottom",
            end: "bottom top",
            scrub: 1,
          },
        });

        // Global Corporate Timeline (Incentive & MICE Outbound)
        const sec = document.querySelector("#global-corporate");
        if (sec && window.innerWidth > 1024) {
          const stage = sec.querySelector(".global-stage");
          const title = sec.querySelector("#global-corporate-title");
          const globeBox = sec.querySelector(".global-globe-box");
          const globeImg = sec.querySelector(".globe-img");
          const arcs = sec.querySelectorAll("[data-gc-arc]");
          const items = sec.querySelectorAll("[data-gc-item]");
          const pass = sec.querySelector("[data-gc-pass]");

          const globalTL = gsap.timeline({
            scrollTrigger: {
              trigger: sec,
              start: "top top",
              end: () => "+=" + Math.round(innerHeight * 2.4),
              scrub: 1.2,
              pin: stage,
              anticipatePin: 1,
              invalidateOnRefresh: true,
            },
          });

