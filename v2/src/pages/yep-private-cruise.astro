    <script define:vars={{ photos, base }}>
      const menu = document.querySelector(".menu-toggle"),
        nav = document.querySelector("#mobile-nav");
      if (menu && nav) {
        menu.addEventListener("click", () => {
          const open = menu.getAttribute("aria-expanded") !== "true";
          menu.setAttribute("aria-expanded", String(open));
          nav.hidden = !open;
        });
        nav.querySelectorAll("a").forEach((a) =>
          a.addEventListener("click", () => {
            nav.hidden = true;
            menu.setAttribute("aria-expanded", "false");
          }),
        );
      }
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if ("IntersectionObserver" in window && !reduced) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                observer.unobserve(e.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll(".reveal").forEach((el) => {
          el.classList.add("will-reveal");
          observer.observe(el);
        });
      }
      const box = document.querySelector(".lightbox"),
        large = document.querySelector("#large-photo"),
        caption = document.querySelector("#photo-caption");
      let active = 0;
      function showPhoto(i) {
        active = (i + photos.length) % photos.length;
        large.src = base + photos[active].file + ".webp";
        large.alt = photos[active].alt;
        caption.textContent =
          String(active + 1).padStart(2, "0") +
          " / 06 — " +
          photos[active].title;
      }
      document.querySelectorAll("[data-photo]").forEach((button) =>
        button.addEventListener("click", () => {
          showPhoto(Number(button.dataset.photo));
          box.showModal();
        }),
      );
      document
        .querySelector("[data-prev]")
        .addEventListener("click", () => showPhoto(active - 1));
      document
        .querySelector("[data-next]")
        .addEventListener("click", () => showPhoto(active + 1));
      box.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") showPhoto(active + 1);
        if (e.key === "ArrowLeft") showPhoto(active - 1);
      });
      document.querySelectorAll("dialog").forEach((dialog) => {
        dialog
          .querySelector(".dialog-close")
          .addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) {
            const r = dialog.getBoundingClientRect();
            if (
              e.clientX < r.left ||
              e.clientX > r.right ||
              e.clientY < r.top ||
              e.clientY > r.bottom
            )
              dialog.close();
          }
        });
      });
      document.addEventListener("click", (event) => {
        if (
          event.target instanceof Element &&
          event.target.closest("[data-open-contact]")
        )
          document.querySelector(".contact-dialog").showModal();
      });
      document.querySelectorAll(".details details").forEach((d) =>
        d.addEventListener("toggle", () => {
          if (d.open)
            document.querySelectorAll(".details details").forEach((other) => {
              if (other !== d) other.open = false;
            });
        }),
      );
    </script>
    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import { renderWindowCanvas } from "../lib/window-chroma.js";
      gsap.registerPlugin(ScrollTrigger);
      const mm = gsap.matchMedia();
      mm.add("(prefers-reduced-motion: no-preference)", () => {
        // Khởi tạo Canvas Chroma-Key bóc tách cửa sổ máy bay Aerive sang trọng
        const canvas = document.querySelector("#hero-canvas");
        if (canvas) {
          const isMobile = window.innerWidth < 768;
          renderWindowCanvas(
            "/images/aerive/window-clear.png",
            canvas,
            isMobile ? 2048 : 2752,
          );
        }

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: ".voyage",
            start: "top top",
            end: () => "+=" + innerHeight * (innerWidth <= 768 ? 1.65 : 3.5),
            pin: ".voyage-stage",
            scrub: 1.2,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });
        tl.to(
          ".window-box",
          { scale: 5.4, ease: "power2.in", duration: 6.2 },
          0,
        )
          .to(
            ".window-box",
            { autoAlpha: 0, duration: 0.6, ease: "power1.out" },
            5.8,
          )
          .fromTo(
            ".sky-depth",
            { scale: 1 },
            { scale: 1.2, duration: 8, ease: "none" },
            0,
          )
          .fromTo(
            ".sky-clouds-bank",
            { yPercent: 60, scale: 1 },
            { yPercent: -15, scale: 1.35, duration: 7, ease: "power1.out" },
            2,
          )
          .to(
            ".voyage-titles",
            {
              y: -45,
              scale: 1.1,
              autoAlpha: 0,
              filter: "blur(8px)",
