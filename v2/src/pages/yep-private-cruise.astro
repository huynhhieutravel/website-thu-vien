        position: relative;
        overflow: hidden;
        border-radius: 6px;
        border: 1px solid rgba(215, 194, 158, 0.3);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      }
      .media-frame img {
        width: 100%;
        height: auto;
        aspect-ratio: 16/10.5;
