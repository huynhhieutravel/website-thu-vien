---
import CaseStudy from "../components/yep/CaseStudy.astro";
import GlobalCorporate from "../components/yep/GlobalCorporate.astro";
import CorporateHeader from "../components/yep/CorporateHeader.astro";
import YepMobileCTA from "../components/yep/YepMobileCTA.astro";
const base = "/images/yep-cruise/";
const photos = [
  {
    file: "yep-140-khach-du-thuyen-indochina-star-tphcm",
    title: "Bắt đầu một buổi tối khác biệt",
    label: "01 / ĐÓN KHÁCH",
    alt: "Đoàn khách chuẩn bị lên du thuyền Indochina Star tại TP.HCM",
  },
  {
    file: "yep-indoor-activities-tro-choi-tuong-tac",
    title: "Kết nối bằng những tiếng cười",
    label: "02 / INDOOR ACTIVITIES",
    alt: "MC hướng dẫn trò chơi tương tác trong chương trình YEP của FIT TOUR",
  },
  {
    file: "san-khau-yep-thiet-ke-rieng-tren-du-thuyen",
    title: "Sân khấu cho câu chuyện riêng",
    label: "03 / THIẾT KẾ CHƯƠNG TRÌNH",
    alt: "Sân khấu sự kiện được chuẩn bị trong khoang du thuyền Indochina Star",
  },
  {
    file: "gala-dinner-140-khach-tren-du-thuyen-sai-gon",
    title: "Cùng ngồi lại, cùng nâng ly",
    label: "04 / GALA DINNER",
    alt: "Không gian Gala Dinner với khách mời và bàn tiệc trong khoang du thuyền",
  },
  {
    file: "acoustic-live-band-gala-dinner-du-thuyen",
    title: "Âm nhạc nối dài cảm xúc",
    label: "05 / ACOUSTIC LIVE BAND",
    alt: "Ban nhạc acoustic biểu diễn trên sân khấu Gala Dinner của FIT TOUR",
  },
  {
    file: "ngam-sai-gon-ve-dem-tu-du-thuyen",
    title: "Sài Gòn, từ một góc nhìn khác",
    label: "06 / SÀI GÒN VỀ ĐÊM",
    alt: "Khách ngắm cầu và các tòa nhà sáng đèn từ du thuyền trên sông Sài Gòn",
  },
];
const image = (i: number) => base + photos[i].file + ".webp";
