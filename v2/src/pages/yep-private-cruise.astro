  <body>
    <a class="skip" href="#story">Đến nội dung</a>
    <CorporateHeader />
    <main>
      <section
        class="voyage"
        id="top"
        aria-label="Tầm nhìn hoàng hôn trên sông Sài Gòn từ du thuyền Indochina Star"
      >
        <div class="voyage-stage">
          <!-- Nền Biển Mây Hoàng Hôn Chụp Thật (Aerive Sky) -->
          <div class="sky-depth" aria-hidden="true">
            <div class="sky-bg">
              <img
                src="/images/aerive/sky-dusk.png"
                alt="Biển mây hoàng hôn rực rỡ nhìn từ không gian sự kiện cao cấp"
                fetchpriority="high"
              />
            </div>
            <div class="sky-clouds-drift">
              <div class="sky-drift-track">
                <img
                  class="clouds-wisp"
                  src="/images/aerive/cloud-wisps.png"
                  alt=""
                />
                <img
                  class="clouds-wisp"
                  src="/images/aerive/cloud-wisps.png"
                  alt=""
                  style="transform: scaleX(-1);"
                />
              </div>
            </div>
            <div class="sky-clouds-bank">
              <img src="/images/aerive/cloud-bank.png" alt="" />
            </div>
          </div>

          <!-- Khung Cửa Sổ Chuyên Cơ Aerive Chuẩn (Da Bọc & Viền Vàng Kim Loại - Canvas Chroma) -->
          <div class="window-box will-change-transform" aria-hidden="true">
            <div class="window-inner">
              <div class="window-band window-band-top"></div>
              <div class="window-band window-band-bottom"></div>
              <div class="window-band window-band-left"></div>
              <div class="window-band window-band-right"></div>
              <canvas id="hero-canvas" class="window-canvas"></canvas>
            </div>
          </div>

          <!-- Tiêu Đề Hero Chuẩn SEO & Bài Toán Doanh Nghiệp (Cột Trái Tinh Tế) -->
          <div class="voyage-titles">
            <nav class="hero-breadcrumb" aria-label="Breadcrumb">
              <a href="https://fittour.vn">Trang chủ</a>
              <span class="breadcrumb-sep">›</span>
              <a href="https://fittour.vn/hanh-trinh-doanh-nghiep"
                >Hành trình Doanh Nghiệp</a
              >
              <span class="breadcrumb-sep">›</span>
              <span class="breadcrumb-current"
                >Case Study Tổ Chức YEP Indoor Cá Nhân Hóa</span
              >
            </nav>
            <h1 id="hero-title">
              Thay đổi cách tổ chức<br /><em>team building.</em>
            </h1>
            <p class="hero-subdeck">
              Indoor Games & Gala Dinner trên du thuyền riêng cho 140 khách
            </p>
            <p class="hero-sapo">
              Case Study YEP 140 khách tại TP.HCM do FIT TOUR thiết kế riêng:
              kết hợp chuỗi Indoor Activities ấm cúng, tiệc tối Gala Dinner sang
              trọng và ban nhạc Acoustic trên du thuyền Indochina Star biệt lập
              giữa sông Sài Gòn.
            </p>
            <div class="hero-specs-row">
              <span class="spec-tag">140 KHÁCH VIP</span>
              <span class="spec-tag">INDOOR ACTIVITIES</span>
              <span class="spec-tag">DU THUYỀN RIÊNG</span>
            </div>
          </div>

          <!-- Góc Nhìn Thiết Kế & Ý Tưởng (Cột Phải Đối Xứng) -->
          <div class="voyage-counter">
            <span class="counter-label">Ý TƯỞNG THIẾT KẾ</span>
            <p>Một buổi tối.<br /><em>Hai miền cảm xúc.</em></p>
            <small>Du thuyền Indochina Star · TP.HCM</small>
          </div>

          <!-- Phân Cảnh Mở Đầu Câu Chuyện Chuẩn Case Study Doanh Nghiệp (Yêu cầu 2) -->
          <div class="sky-message">
            <p class="eyebrow">MỘT CHƯƠNG TRÌNH · HAI TRẢI NGHIỆM</p>
            <h2>Không chỉ gặp nhau.<br /><em>Mà thật sự kết nối.</em></h2>
            <p class="whisper-sub">
              Thoát khỏi lối mòn vận động dãi nắng kiệt sức. Một buổi tối kết
              hợp tương tác ấm cúng trong nhà (Indoor Activities), tiệc tối Gala
              Dinner trên du thuyền riêng và âm nhạc Acoustic giữa lòng TP.HCM
              lên đèn.
            </p>
            <div class="whisper-tags">
              <span>TÁI ĐỊNH NGHĨA TEAM BUILDING</span>
              <span>·</span>
              <span>DU THUYỀN INDOCHINA STAR</span>
              <span>·</span>
              <span>140 KHÁCH VIP</span>
            </div>
          </div>

          <div class="voyage-cue">
            CUỘN ĐỂ BƯỚC VÀO HÀNH TRÌNH <span>↓</span>
          </div>
        </div>
      </section>

      <!-- Thanh Điều Hướng Nhanh Mục Lục Bài Viết (Quick Jump Navigation - Tối ưu cho Mobile & Desktop) -->
      <nav class="article-quick-nav" aria-label="Xem nhanh các mục nội dung">
        <div class="wrap quick-nav-inner">
          <span class="quick-nav-title">MỤC LỤC BÀI VIẾT:</span>
          <div class="quick-nav-pills">
            <a href="#story" class="quick-pill"
              ><span>01. Bối cảnh & 4 Trụ cột</span></a
            >
            <a href="#arrival" class="quick-pill"
              ><span>02. Đón khách bến tàu</span></a
            >
            <a href="#vessel" class="quick-pill"
              ><span>03. Khám phá du thuyền</span></a
            >
            <a href="#experience" class="quick-pill"
              ><span>04. Indoor & Gala tiệc</span></a
            >
            <a href="#case-study" class="quick-pill highlight"
              ><span>⚡ Hồ Sơ Case Study</span></a
            >
            <a href="#moments" class="quick-pill"
              ><span>05. 06 Ảnh thực tế</span></a
            >
            <a href="#contact" class="quick-pill cta"
              ><span>📞 Nhận Báo Giá</span></a
            >
          </div>
        </div>
      </nav>

      <section class="intro wrap section" id="story">
        <div class="section-label reveal">
          <span class="number">01</span>
          <p>CÂU CHUYỆN THIẾT KẾ<br />ĐẰNG SAU BUỔI TIỆC</p>
        </div>
        <div class="intro-main reveal">
          <h2>Không chỉ gặp nhau.<br /><em>Mà thật sự kết nối.</em></h2>
          <div class="intro-lead">
            <p>
              Team building doanh nghiệp có nhất thiết phải là những trò chơi
              vận động dãi nắng kiệt sức? Với chương trình YEP 140 khách tại
              TP.HCM, FIT TOUR lựa chọn tái cấu trúc toàn diện trải nghiệm: đưa
              ban lãnh đạo và đội ngũ cùng bước lên du thuyền riêng biệt lập
              giữa sông Sài Gòn, nơi sự gắn kết đến từ những cuộc trò chuyện
              chân thành và tiếng cười tự nhiên.
            </p>
          </div>

          <!-- 4 Trụ Cột Storytelling Độc Bản (Chuẩn Editorial Luxury) -->
          <div class="story-pillars">
            <article class="pillar-card">
              <div class="pillar-num">01</div>
              <h3>Không vận động thể lực</h3>
              <span class="pillar-line"></span>
              <p>
                Thay thế hoàn toàn trò chơi ngoài trời bằng chuỗi Indoor
                Activities thông minh trong khoang tiệc ấm. MC chuyên nghiệp dẫn
                dắt tinh tế, khơi gợi tương tác tự nhiên giữa các phòng ban mà
                không tạo áp lực.
              </p>
            </article>

            <article class="pillar-card">
              <div class="pillar-num">02</div>
              <h3>Du thuyền riêng biệt lập</h3>
              <span class="pillar-line"></span>
              <p>
                Toàn quyền sở hữu du thuyền Indochina Star chuẩn VIP. Không gian
                riêng tư 100% không chia sẻ với bất kỳ đoàn khách nào khác, giúp
                các câu chuyện nội bộ và lời tri ân được sẻ chia trọn vẹn.
              </p>
            </article>

            <article class="pillar-card">
              <div class="pillar-num">03</div>
              <h3>Acoustic Live dẫn dắt</h3>
              <span class="pillar-line"></span>
              <p>
                Ban nhạc Acoustic biểu diễn mộc mạc theo từng thời khắc của buổi
                tối. Giai điệu du dương hòa cùng làn gió sông Sài Gòn, tạo nên
                mạch cảm xúc lắng đọng khó quên cho từng thành viên.
              </p>
            </article>

            <article class="pillar-card">
              <div class="pillar-num">04</div>
              <h3>Gala Dinner bên cảnh đêm</h3>
              <span class="pillar-line"></span>
              <p>
                Bàn tiệc ẩm thực tinh tế bên khung cửa sổ ngắm trọn cầu Ba Son
                và những tòa tháp chọc trời rực sáng. Khép lại một năm nhiều nỗ
                lực bằng khoảnh khắc nâng ly đầy tự hào giữa dòng sông lên đèn.
              </p>
            </article>
          </div>

          <!-- Dải Thống Kê Bề Thế -->
          <div class="facts">
            <div><strong>140</strong><span>KHÁCH VIP THAM DỰ</span></div>
            <div><strong>02</strong><span>MẠCH CẢM XÚC NỐI TIẾP</span></div>
            <div><strong>01</strong><span>DU THUYỀN BIỆT LẬP</span></div>
            <div><strong>00</strong><span>TẠP ÂM NGOẠI CẢNH</span></div>
          </div>
        </div>
      </section>
      <section class="arrival-story wrap section" id="arrival">
        <div class="arrival-grid">
          <!-- Cột Trái: Text Storytelling Dẫn Nhập Sâu Sắc -->
          <div class="arrival-text reveal">
            <p class="eyebrow">01 / KHỞI ĐẦU HÀNH TRÌNH · BẾN TÀU TP.HCM</p>
            <h2>
              Bước lên du thuyền,<br /><em>bắt đầu buổi tối khác biệt.</em>
            </h2>
            <div class="arrival-copy">
              <p>
                Buổi chiều muộn tại bến tàu, từng đoàn xe đưa 140 thành viên và
                ban lãnh đạo đến điểm đón. Không có không khí hối hả hay áp lực
                chuẩn bị trang phục thể thao dãi nắng. Mọi người thong thả bước
                qua thảm đỏ lên du thuyền Indochina Star trong tiếng nhạc đón
                khách nhẹ nhàng và làn gió sông êm đềm.
              </p>
              <p>
                Một không gian hoàn toàn riêng tư giữa lòng sông Sài Gòn, tách
                biệt khỏi khói bụi và sự ồn ào của phố thị, sẵn sàng cho một đêm
                hội ngộ ấm cúng, sang trọng và đầy ắp tiếng cười.
              </p>
            </div>

            <div class="arrival-meta-strip">
              <div class="meta-item">
                <span class="meta-label">ĐỊA ĐIỂM</span>
                <strong class="meta-val"
                  >Cảng Sài Gòn (5 Nguyễn Tất Thành, Q.4) · Ngắm Bến Bạch Đằng</strong
                >
              </div>
              <div class="meta-item">
                <span class="meta-label">THỜI GIAN</span>
                <strong class="meta-val">17:30 — Đón khách & Check-in</strong>
              </div>
              <div class="meta-item">
                <span class="meta-label">KHÔNG GIAN</span>
                <strong class="meta-val"
                  >Sảnh tiệc VIP du thuyền Indochina Star</strong
                >
              </div>
            </div>
          </div>

          <!-- Cột Phải: Ảnh Kích Thước Vừa Vặn, Sắc Nét 100%, Khung Viền Sang Trọng (Không Full Width) -->
          <div class="arrival-media reveal">
            <div class="media-frame">
              <img
                src={image(0)}
                alt={photos[0].alt}
                width="800"
                height="530"
                loading="lazy"
              />
              <span class="media-tag">ẢNH SỰ KIỆN THỰC TẾ ↗</span>
            </div>
            <figcaption class="arrival-caption">
              <strong>ĐÓN KHÁCH LÊN DU THUYỀN INDOCHINA STAR</strong>
              <p>
                Đoàn khách 140 thành viên bước vào không gian sự kiện riêng tư
                trên sông
              </p>
            </figcaption>
          </div>
        </div>
      </section>
      <section class="vessel" aria-label="Du thuyền và hành trình">
        <div class="vessel-stage">
          <div class="vessel-heading">
            <p class="eyebrow dark">THE PRIVATE CRUISE</p><h2>
              Mang theo<br /><em>những kết nối.</em>
            </h2>
          </div><img
            class="vessel-model"
            src={base + "vessel.webp"}
            alt="Minh họa du thuyền gỗ phục vụ tiệc trên sông"
          /><div class="vessel-details">
            <p class="eyebrow dark">MỘT KHÔNG GIAN · NHIỀU CẢM XÚC</p><h3>
              Từ khoang tiệc ấm<br />đến thành phố lên đèn.
            </h3><p>
              Hoạt động indoor · Gala Dinner<br />Acoustic live band · Ngắm cảnh
              đêm
            </p><small>Hình minh họa du thuyền</small>
          </div>
        </div>
      </section>
      <section class="experience section" id="experience">
        <div class="wrap experience-heading reveal">
          <div>
            <p class="eyebrow dark">
              02 / MỘT CHƯƠNG TRÌNH, HAI TRẢI NGHIỆM
            </p><h2>Nhịp vui chung.<br /><em>Dấu ấn riêng.</em></h2>
          </div><p>
            Từ những tiếng cười trong khoang tiệc<br />đến thành phố lấp lánh
            ngoài ô cửa.
          </p>
        </div>
        <div class="duet wrap">
          <article class="experience-card reveal">
            <div class="media">
              <img
                src={image(1)}
                alt={photos[1].alt}
                loading="lazy"
                width="1280"
                height="720"
              /><span class="photo-tag">THE CONNECTION</span>
            </div><div class="card-copy">
              <span class="small-label">01 / GẮN KẾT</span><h3>
                Khi khoảng cách<br />nhường chỗ cho <em>tiếng cười.</em>
              </h3><p>
                Indoor Activities là một phần của concept ngay từ đầu. Nội dung
                trò chơi, cách dẫn dắt và tinh thần tham gia tạo nên sự gắn kết,
                thay vì đặt trọng tâm vào thử thách thể lực.
              </p><a class="text-link dark-link" href="#design"
                >Bên trong chương trình <span>↗</span></a
              >
            </div>
          </article>
          <article class="experience-card second reveal">
            <div class="media">
              <img
                src={image(3)}
                alt={photos[3].alt}
                loading="lazy"
                width="1280"
                height="720"
