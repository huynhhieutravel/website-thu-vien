      /* Section Arrival: 2 Cột Xen Kẽ Text & Ảnh (Không Full-Width) */
      .arrival-story {
        padding-block: 110px;
      }
      .arrival-grid {
        display: grid;
        grid-template-columns: 1fr 1.05fr;
        gap: 64px;
        align-items: center;
      }
      .arrival-text h2 {
        font-size: clamp(40px, 4.2vw, 68px);
