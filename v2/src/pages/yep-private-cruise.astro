      /* ==========================================================================
   HỆ THỐNG ĐỒNG BỘ TYPOGRAPHY & ĐỘ TƯƠNG PHẢN CHUẨN (LIGHT & DARK SECTIONS)
   Giải quyết triệt để 3 yêu cầu:
   1. Độ tương phản cao, chống text mờ nhạt
   2. Font & Size phân cấp chuẩn mực, text mô tả to rõ dễ đọc (17-18px)
   3. CTA B2B đẳng cấp doanh nghiệp
   ========================================================================== */

      /* 1. NỀN SÁNG (LIGHT SECTIONS: .experience, .journey, .moments) - WCAG AAA */
      .experience,
      .journey,
      .moments {
        background: #f4efe6 !important;
        color: #1a2018 !important;
      }

      .experience-heading h2,
      .journey-head h2,
      .moments h2 {
        color: #141812 !important;
        font-family: Cormorant, Georgia, serif !important;
        font-size: clamp(44px, 4.8vw, 76px) !important;
        line-height: 1.08 !important;
      }

      .experience-heading h2 em,
      .journey-head h2 em,
      .moments h2 em,
      .card-copy h3 em {
        color: #8c6721 !important;
        font-weight: 500 !important;
        font-style: italic !important;
      }

      .experience-heading > p,
      .journey-head > p:last-child {
        color: #2b3227 !important;
        font-size: 18px !important;
        line-height: 1.8 !important;
        font-family: Manrope, sans-serif !important;
        font-weight: 500 !important;
      }

      .eyebrow.dark,
      .small-label {
        color: #4a3e2b !important;
        font-size: 11.5px !important;
        font-weight: 700 !important;
        letter-spacing: 0.18em !important;
      }

      .card-copy {
        padding-top: 32px !important;
      }

      .card-copy h3 {
        color: #171c15 !important;
        font-size: clamp(34px, 3.4vw, 48px) !important;
        font-family: Cormorant, Georgia, serif !important;
        line-height: 1.15 !important;
        margin-top: 14px !important;
      }

      /* Sửa triệt để đoạn text bị mờ trên nền sáng (Ảnh 1 & Ảnh 2) */
      .card-copy p {
        color: #1a2018 !important;
        font-size: 17.5px !important;
        line-height: 1.85 !important;
        font-family: Manrope, sans-serif !important;
        font-weight: 450 !important;
        margin-top: 20px !important;
      }

      .card-copy .text-link.dark-link {
        color: #1a2018 !important;
        font-size: 14px !important;
        font-weight: 700 !important;
        letter-spacing: 0.08em !important;
        border-bottom: 2px solid #8c6721 !important;
        padding-block: 12px !important;
        margin-top: 24px !important;
        display: inline-flex !important;
        align-items: center;
        gap: 12px;
      }

      .card-copy .text-link.dark-link:hover {
        color: #8c6721 !important;
        border-bottom-color: #1a2018 !important;
      }

      /* Timeline nhịp chương trình nền sáng */
      .timeline li > span {
        color: #8c6721 !important;
        font-size: 46px !important;
        font-weight: 600 !important;
        font-family: Cormorant, serif !important;
      }

      .timeline h3 {
        color: #171c15 !important;
