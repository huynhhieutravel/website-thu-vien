      /* 2. NỀN TỐI (DARK SECTIONS: .design, .intro, .arrival-story, .night) */
      /* Nâng cấp kích thước đoạn mô tả bị User phản ánh quá nhỏ (Ảnh 3) */
      .design-desc {
