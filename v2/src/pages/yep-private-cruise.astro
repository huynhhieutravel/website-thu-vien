              ease: "power2.in",
            },
            0,
          )
          .to(
            ".voyage-counter",
            {
              y: 25,
              autoAlpha: 0,
              filter: "blur(6px)",
              duration: 1.8,
              ease: "power2.in",
            },
            0,
          )
          .to(".voyage-cue", { autoAlpha: 0, duration: 0.5 }, 0)
          .fromTo(
            ".sky-message",
            { y: 50, autoAlpha: 0, scale: 0.92, filter: "blur(12px)" },
            {
              y: 0,
              autoAlpha: 1,
              scale: 1,
              filter: "blur(0px)",
              duration: 2.4,
              ease: "power3.out",
            },
            4.8,
          )
          .to(
            ".sky-message",
            {
              autoAlpha: 0,
              y: -35,
              filter: "blur(8px)",
              duration: 1.4,
              ease: "power2.in",
            },
            7.6,
          );
        const boat = gsap.timeline({
          scrollTrigger: {
            trigger: ".vessel",
            start: "top top",
            end: () => "+=" + innerHeight * (innerWidth <= 768 ? 1.3 : 2.4),
            pin: ".vessel-stage",
            scrub: 1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });
        boat
          .fromTo(
            ".vessel-model",
            { y: () => innerHeight * 0.75, rotation: -12, scale: 1.25 },
            { y: 0, rotation: 0, scale: 1, duration: 4, ease: "power2.out" },
            0,
          )
          .to(".vessel-heading", { y: -70, autoAlpha: 0, duration: 1.5 }, 3)
          .to(
            ".vessel-model",
            {
              xPercent: () => (innerWidth < 751 ? 0 : -24),
              yPercent: () => (innerWidth < 751 ? -22 : 0),
              scale: () => (innerWidth < 751 ? 0.75 : 0.85),
              duration: 2,
            },
            4,
          )
          .fromTo(
            ".vessel-details",
            { y: 40, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 1.5 },
            5,
          )
          .to({}, { duration: 1 });
        gsap.to(".night>img", {
