x-1/2" style="left:9.392265193370166%">May</span><span class="absolute top-0 whitespace-nowrap text-[11px] tabular-nums text-ink/45 -translate-x-1/2" style="left:26.519337016574585%">Jun</span><span class="absolute top-0 whitespace-nowrap text-[11px] tabular-nums text-ink/45 -translate-x-1/2" style="left:43.0939226519337%">Jul</span><span class="absolute top-0 whitespace-nowrap text-[11px] tabular-nums text-ink/45 -translate-x-1/2" style="left:60.22099447513812%">Aug</span><span class="absolute top-0 whitespace-nowrap text-[11px] tabular-nums text-ink/45 -translate-x-1/2" style="left:77.34806629834254%">Sep</span><span class="absolute top-0 whitespace-nowrap text-[11px] tabular-nums text-ink/45 -translate-x-1/2" style="left:93.92265193370166%">Oct</span></div></div><ul class="mt-8 grid gap-5 border-t border-line pt-6 sm:grid-cols-3"><li class="flex gap-3 sm:flex-col"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity size-5 shrink-0 text-signal-deep"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg><div><p class="text-[15px] font-semibold text-ink">Every run</p><p class="mt-1 text-[14px] leading-relaxed text-ink/60">Pace and heart rate from each outdoor run refine the estimate. No lab test, no treadmill protocol.</p></div></li><li class="flex gap-3 sm:flex-col"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mountain size-5 shrink-0 text-signal-deep"><path d="m8 3 4 8 5-5 5 15H2L8 3z"></path></svg><div><p class="text-[15px] font-semibold text-ink">Terrain aware</p><p class="mt-1 text-[14px] leading-relaxed text-ink/60">Climbs, heat and altitude are corrected for, so a hilly day does not read as lost fitness.</p></div></li><li class="flex gap-3 sm:flex-col"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer size-5 shrink-0 text-signal-deep"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg><div><p class="text-[15px] font-semibold text-ink">Race ready</p><p class="mt-1 text-[14px] leading-relaxed text-ink/60">Your estimate drives predicted finish times from 5K to the marathon, updated after every session.</p></div></li></ul></div></div></div></section><section id="engineering" aria-labelledby="engineering-title" class="bg-white py-24 sm:py-36"><div class="mx-auto grid max-w-[1440px] gap-14 px-5 sm:px-8 lg:grid-cols-12 lg:gap-10"><div class="lg:col-span-6"><div class="lg:sticky lg:top-28"><div class="relative overflow-hidden bg-surface aspect-[4/5] rounded-[32px] sm:aspect-[4/3] lg:aspect-[4/5]"><div data-parallax="6" class="absolute -inset-y-[12%] inset-x-0"><img alt="Side profile of the PACE titanium core flowing into the woven strap" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 1024px) 50vw, 100vw" /images/pace/macro-core.jpg 384w, /images/pace/macro-core.jpg 640w, /images/pace/macro-core.jpg 750w, /images/pace/macro-core.jpg 828w, /images/pace/macro-core.jpg 1080w, /images/pace/macro-core.jpg 1200w, /images/pace/macro-core.jpg 1920w, /images/pace/macro-core.jpg 2048w, /images/pace/macro-core.jpg 3840w" src="/images/pace/macro-core.jpg"/></div></div></div></div><div class="lg:col-span-5 lg:col-start-8 lg:pt-10"><div class="@container w-full"><p data-reveal="fade" class="eyebrow flex items-center gap-3 text-ink/55"><span class="text-signal-deep">05</span><span class="h-px w-8 bg-ink/25" aria-hidden="true"></span>Materials</p><h2 id="engineering-title" data-split="true" class="mt-6 font-display text-[clamp(1.75rem,9cqw,5rem)] uppercase leading-[0.92] text-ink text-balance"><span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">Engineered</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">to</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">disappear.</span></span></h2><div data-reveal="true" class="mt-6 max-w-xl text-base leading-relaxed sm:text-[17px] text-ink/60 text-pretty">Everything that touches your skin was designed to be forgotten. Everything inside was designed to never miss a beat.</div></div><ol class="mt-14 border-t border-line"><li data-reveal="true" class="grid grid-cols-[48px_minmax(0,1fr)] gap-4 border-b border-line py-7"><span class="eyebrow pt-1 text-signal-deep">01</span><div><h3 class="text-xl font-semibold text-ink">Grade 5 titanium core</h3><p class="mt-2 text-[15px] leading-relaxed text-ink/60">Machined from a single billet and bead-blasted to a satin finish. 11 grams, 8.6 mm thin, with no seams to catch on a sleeve.</p></div></li><li data-reveal="true" class="grid grid-cols-[48px_minmax(0,1fr)] gap-4 border-b border-line py-7"><span class="eyebrow pt-1 text-signal-deep">02</span><div><h3 class="text-xl font-semibold text-ink">Double-weave strap</h3><p class="mt-2 text-[15px] leading-relaxed text-ink/60">Recycled nylon over an elastane core. Breathable, quick-drying and soft enough to forget you&#x27;re wearing it at night.</p></div></li><li data-reveal="true" class="grid grid-cols-[48px_minmax(0,1fr)] gap-4 border-b border-line py-7"><span class="eyebrow pt-1 text-signal-deep">03</span><div><h3 class="text-xl font-semibold text-ink">Domed sapphire window</h3><p class="mt-2 text-[15px] leading-relaxed text-ink/60">A sapphire lens presses the optical array gently into the skin, keeping the signal clean through every stride and rep.</p></div></li><li data-reveal="true" class="grid grid-cols-[48px_minmax(0,1fr)] gap-4 border-b border-line py-7"><span class="eyebrow pt-1 text-signal-deep">04</span><div><h3 class="text-xl font-semibold text-ink">MagLock clasp</h3><p class="mt-2 text-[15px] leading-relaxed text-ink/60">Two titanium halves meet with 40 newtons of magnetic hold. On and off with one hand, secure through a sprint finish.</p></div></li></ol><div data-reveal="true" class="mt-10 grid grid-cols-2 gap-3"><div class="relative aspect-square overflow-hidden rounded-[24px] bg-surface"><img alt="Extreme close-up of the black twill weave with a signal-orange edge thread" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 1024px) 20vw, 50vw" /images/pace/macro-weave.jpg 128w, /images/pace/macro-weave.jpg 256w, /images/pace/macro-weave.jpg 384w, /images/pace/macro-weave.jpg 640w, /images/pace/macro-weave.jpg 750w, /images/pace/macro-weave.jpg 828w, /images/pace/macro-weave.jpg 1080w, /images/pace/macro-weave.jpg 1200w, /images/pace/macro-weave.jpg 1920w, /images/pace/macro-weave.jpg 2048w, /images/pace/macro-weave.jpg 3840w" src="/images/pace/macro-weave.jpg"/></div><div class="relative aspect-square overflow-hidden rounded-[24px] bg-surface"><img alt="The two titanium halves of the MagLock clasp meeting in a fine seam" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 1024px) 20vw, 50vw" /images/pace/macro-clasp.jpg 128w, /images/pace/macro-clasp.jpg 256w, /images/pace/macro-clasp.jpg 384w, /images/pace/macro-clasp.jpg 640w, /images/pace/macro-clasp.jpg 750w, /images/pace/macro-clasp.jpg 828w, /images/pace/macro-clasp.jpg 1080w, /images/pace/macro-clasp.jpg 1200w, /images/pace/macro-clasp.jpg 1920w, /images/pace/macro-clasp.jpg 2048w, /images/pace/macro-clasp.jpg 3840w" src="/images/pace/macro-clasp.jpg"/></div></div></div></div></section><section id="colorways" aria-labelledby="colorways-title" class="bg-white pb-24 sm:pb-36"><div class="mx-auto max-w-[1440px] px-5 sm:px-8"><div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"><div class="@container w-full max-w-3xl"><p data-reveal="fade" class="eyebrow flex items-center gap-3 text-ink/55"><span class="text-signal-deep">06</span><span class="h-px w-8 bg-ink/25" aria-hidden="true"></span>Three finishes</p><h2 id="colorways-title" data-split="true" class="mt-6 font-display text-[clamp(1.75rem,9cqw,5rem)] uppercase leading-[0.92] text-ink text-balance"><span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">Pick</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">your</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">signal.</span></span></h2><div data-reveal="true" class="mt-6 max-w-xl text-base leading-relaxed sm:text-[17px] text-ink/60 text-pretty">Every colorway pairs a woven strap with a titanium core finished to match. Same sensors, same 24 grams.</div></div><div data-reveal="true" class="shrink-0"><a class="group inline-flex items-center gap-2 font-semibold transition-colors duration-300 rounded-full min-h-14 px-6 py-2 text-[15px] leading-snug sm:px-7 border border-ink/15 bg-white text-ink hover:border-ink/45" href="/band#colorways">Compare colorways<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div><div class="relative overflow-hidden bg-surface mt-14 aspect-[4/3] rounded-[32px] sm:aspect-[16/8]"><div data-parallax="5" class="absolute -inset-y-[12%] inset-x-0"><img alt="PACE Band in Carbon Black, Signal Orange and Stone Titanium, standing side by side" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" /images/pace/colorways.jpg 640w, /images/pace/colorways.jpg 750w, /images/pace/colorways.jpg 828w, /images/pace/colorways.jpg 1080w, /images/pace/colorways.jpg 1200w, /images/pace/colorways.jpg 1920w, /images/pace/colorways.jpg 2048w, /images/pace/colorways.jpg 3840w" src="/images/pace/colorways.jpg"/></div></div><ul data-stagger="true" class="mt-8 grid gap-6 sm:grid-cols-3"><li class="flex gap-4"><span aria-hidden="true" class="mt-1 size-6 shrink-0 rounded-full ring-1 ring-black/10" style="background:linear-gradient(135deg, #1c1c1e 0%, #1c1c1e 62%, #ff5a1f 62%)"></span><div><h3 class="text-lg font-semibold text-ink">Carbon Black</h3><p class="mt-1 text-[15px] leading-relaxed text-ink/60">Black double-weave strap, DLC-coated titanium core and a signal-orange inner lining.</p></div></li><li class="flex gap-4"><span aria-hidden="true" class="mt-1 size-6 shrink-0 rounded-full ring-1 ring-black/10" style="background:linear-gradient(135deg, #ff5a1f 0%, #ff5a1f 62%, #2f2f33 62%)"></span><div><h3 class="text-lg font-semibold text-ink">Signal Orange</h3><p class="mt-1 text-[15px] leading-relaxed text-ink/60">High-visibility orange weave with a graphite titanium core, made for early starts and late finishes.</p></div></li><li class="flex gap-4"><span aria-hidden="true" class="mt-1 size-6 shrink-0 rounded-full ring-1 ring-black/10" style="background:linear-gradient(135deg, #c8c1b4 0%, #c8c1b4 62%, #8d8579 62%)"></span><div><h3 class="text-lg font-semibold text-ink">Stone Titanium</h3><p class="mt-1 text-[15px] leading-relaxed text-ink/60">Warm stone weave with a bead-blasted natural titanium core and a tonal lining.</p></div></li></ul></div></section><section id="field-team" aria-labelledby="field-team-title" class="bg-surface py-24 sm:py-36"><div class="mx-auto max-w-[1440px] px-5 sm:px-8"><div class="@container w-full max-w-3xl"><p data-reveal="fade" class="eyebrow flex items-center gap-3 text-ink/55"><span class="text-signal-deep">07</span><span class="h-px w-8 bg-ink/25" aria-hidden="true"></span>Field tested</p><h2 id="field-team-title" data-split="true" class="mt-6 font-display text-[clamp(1.75rem,9cqw,5rem)] uppercase leading-[0.92] text-ink text-balance"><span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">Worn</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">by</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">people</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">who</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">measure</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">everything.</span></span></h2><div data-reveal="true" class="mt-6 max-w-xl text-base leading-relaxed sm:text-[17px] text-ink/60 text-pretty">Over 14 months, our field team of endurance athletes wore pre-production bands through races, training blocks and recovery weeks.</div></div><ul data-stagger="true" class="mt-14 grid gap-4 md:grid-cols-3"><li class="flex flex-col rounded-[28px] bg-white p-6 sm:p-8"><figure class="flex h-full flex-col"><blockquote class="text-xl leading-snug text-ink text-pretty"><p>“<!-- -->I stopped looking at my wrist mid-race. The band tells me what I need when I need it, through a haptic nudge, and nothing else.<!-- -->”</p></blockquote><figcaption class="mt-auto flex items-center gap-4 border-t border-line pt-6"><span aria-hidden="true" class="inline-flex size-11 items-center justify-center rounded-full bg-ink text-sm font-semibold text-white">LH</span><span><span class="block text-[15px] font-semibold text-ink">Lena Hartmann</span><span class="block text-[13px] text-ink/55">Ultra-trail runner<!-- --> · <!-- -->Field team since beta · 2,140 km logged</span></span></figcaption></figure></li><li class="flex flex-col rounded-[28px] bg-white p-6 sm:p-8"><figure class="flex h-full flex-col"><blockquote class="text-xl leading-snug text-ink text-pretty"><p>“<!-- -->My HRV trend flagged overreaching two days before I felt it. I backed off, and set a 2k best the following week.<!-- -->”</p></blockquote><figcaption class="mt-auto flex items-center gap-4 border-t border-line pt-6"><span aria-hidden="true" class="inline-flex size-11 items-center justify-center rounded-full bg-ink text-sm font-semibold text-white">MB</span><span><span class="block text-[15px] font-semibold text-ink">Marcus Bell</span><span class="block text-[13px] text-ink/55">Competitive rower<!-- --> · <!-- -->Field team since beta · 318 sessions</span></span></figcaption></figure></li><li class="flex flex-col rounded-[28px] bg-white p-6 sm:p-8"><figure class="flex h-full flex-col"><blockquote class="text-xl leading-snug text-ink text-pretty"><p>“<!-- -->It disappears at night. The sleep and recovery data has become the most honest coach I have.<!-- -->”</p></blockquote><figcaption class="mt-auto flex items-center gap-4 border-t border-line pt-6"><span aria-hidden="true" class="inline-flex size-11 items-center justify-center rounded-full bg-ink text-sm font-semibold text-white">AT</span><span><span class="block text-[15px] font-semibold text-ink">Aiko Tanaka</span><span class="block text-[13px] text-ink/55">Long-course triathlete<!-- --> · <!-- -->Field team since beta · 196 nights tracked</span></span></figcaption></figure></li></ul></div></section><section id="faq" aria-labelledby="faq-title" class="bg-white py-24 sm:py-36"><div class="mx-auto grid max-w-[1440px] gap-12 px-5 sm:px-8 lg:grid-cols-12"><div class="lg:col-span-4"><div class="@container w-full"><p data-reveal="fade" class="eyebrow flex items-center gap-3 text-ink/55"><span class="text-signal-deep">08</span><span class="h-px w-8 bg-ink/25" aria-hidden="true"></span>Questions</p><h2 id="faq-title" data-split="true" class="mt-6 font-display text-[clamp(1.75rem,9cqw,5rem)] uppercase leading-[0.92] text-ink text-balance"><span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">Good</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">to</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">know.</span></span></h2><div data-reveal="true" class="mt-6 max-w-xl text-base leading-relaxed sm:text-[17px] text-ink/60 text-pretty">The questions we hear most from athletes considering their first screenless band.</div><div data-reveal="true" class="mt-8"><a class="group inline-flex items-center gap-2 font-semibold transition-colors duration-300 rounded-full min-h-12 px-6 py-2 text-sm leading-snug border border-ink/15 bg-white text-ink hover:border-ink/45" href="/band#faq">All questions<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></div><div data-reveal="true" class="lg:col-span-7 lg:col-start-6"><ul class="border-t border-line"><li class="border-b border-line"><h3><button id="_R_5a6_-button-0" type="button" aria-expanded="true" aria-controls="_R_5a6_-panel-0" class="group flex w-full items-start justify-between gap-4 py-5 text-left sm:gap-6 sm:py-6"><span class="text-lg font-semibold leading-snug text-ink sm:text-xl">Why doesn&#x27;t PACE Band have a screen?</span><span aria-hidden="true" class="mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-full border transition-all duration-500 ease-out-expo rotate-45 border-ink bg-ink text-white group-hover:border-ink"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-4"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></button></h3><div id="_R_5a6_-panel-0" role="region" aria-labelledby="_R_5a6_-button-0" class="grid transition-[grid-template-rows] duration-500 ease-out-expo grid-rows-[1fr]"><div class="overflow-hidden"><p class="max-w-3xl pb-7 pr-4 text-[15px] sm:pr-12 leading-relaxed text-ink/65">Because the most useful data is the data you don&#x27;t stare at. Without a display, the band is thinner, lighter, lasts up to 10 days and never pulls your attention mid-session. Live numbers stream to your phone when you want them, and silent haptic cues tell you when you drift out of your target zone.</p></div></div></li><li class="border-b border-line"><h3><button id="_R_5a6_-button-1" type="button" aria-expanded="false" aria-controls="_R_5a6_-panel-1" class="group flex w-full items-start justify-between gap-4 py-5 text-left sm:gap-6 sm:py-6"><span class="text-lg font-semibold leading-snug text-ink sm:text-xl">Is there a subscription?</span><span aria-hidden="true" class="mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-line transition-all duration-500 ease-out-expo group-hover:border-ink/40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-4"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></button></h3><div id="_R_5a6_-panel-1" role="region" aria-labelledby="_R_5a6_-button-1" class="grid transition-[grid-template-rows] duration-500 ease-out-expo grid-rows-[0fr]"><div class="overflow-hidden"><p class="max-w-3xl pb-7 pr-4 text-[15px] sm:pr-12 leading-relaxed text-ink/65">No. Every metric, every insight, your complete history and full data export are included with the band. Software updates that add new features are free for the life of the product.</p></div></div></li><li class="border-b border-line"><h3><button id="_R_5a6_-button-2" type="button" aria-expanded="false" aria-controls="_R_5a6_-panel-2" class="group flex w-full items-start justify-between gap-4 py-5 text-left sm:gap-6 sm:py-6"><span class="text-lg font-semibold leading-snug text-ink sm:text-xl">How do I start a workout without a screen?</span><span aria-hidden="true" class="mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-line transition-all duration-500 ease-out-expo group-hover:border-ink/40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-4"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></button></h3><div id="_R_5a6_-panel-2" role="region" aria-labelledby="_R_5a6_-button-2" class="grid transition-[grid-template-rows] duration-500 ease-out-expo grid-rows-[0fr]"><div class="overflow-hidden"><p class="max-w-3xl pb-7 pr-4 text-[15px] sm:pr-12 leading-relaxed text-ink/65">Double-tap the core and a short haptic pulse confirms the session has started. Runs, rides, swims, walks and strength sessions are also detected automatically, and you can start any of 90 activity types from the app.</p></div></div></li><li class="border-b border-line"><h3><button id="_R_5a6_-button-3" type="button" aria-expanded="false" aria-controls="_R_5a6_-panel-3" class="group flex w-full items-start justify-between gap-4 py-5 text-left sm:gap-6 sm:py-6"><span class="text-lg font-semibold leading-snug text-ink sm:text-xl">How accurate are heart rate and HRV?</span><span aria-hidden="true" class="mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-line transition-all duration-500 ease-out-expo group-hover:border-ink/40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-4"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></button></h3><div id="_R_5a6_-panel-3" role="region" aria-labelledby="_R_5a6_-button-3" class="grid transition-[grid-template-rows] duration-500 ease-out-expo grid-rows-[0fr]"><div class="overflow-hidden"><p class="max-w-3xl pb-7 pr-4 text-[15px] sm:pr-12 leading-relaxed text-ink/65">In validation against chest-strap ECG, PACE Band measured heart rate within 1.8 bpm on average across 40 activity types and tracked overnight HRV with a 0.97 correlation. Accuracy can vary with fit, so wear the core snug, one finger above the wrist bone.</p></div></div></li><li class="border-b border-line"><h3><button id="_R_5a6_-button-4" type="button" aria-expanded="false" aria-controls="_R_5a6_-panel-4" class="group flex w-full items-start justify-between gap-4 py-5 text-left sm:gap-6 sm:py-6"><span class="text-lg font-semibold leading-snug text-ink sm:text-xl">Can I swim and shower with it?</span><span aria-hidden="true" class="mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-line transition-all duration-500 ease-out-expo group-hover:border-ink/40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-4"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span></button></h3><div id="_R_5a6_-panel-4" role="region" aria-labelledby="_R_5a6_-button-4" class="grid transition-[grid-template-rows] duration-500 ease-out-expo grid-rows-[0fr]"><div class="overflow-hidden"><p class="max-w-3xl pb-7 pr-4 text-[15px] sm:pr-12 leading-relaxed text-ink/65">Yes. The band is rated 10 ATM and tracks pool and open-water swims, including distance, stroke rate and SWOLF. The woven strap dries in about 20 minutes.</p></div></div></li></ul></div></div></section><section id="reserve-cta" aria-labelledby="reserve-cta-title" class="bg-white py-24 sm:py-36"><div class="mx-auto max-w-[1440px] px-5 sm:px-8"><div class="relative overflow-hidden rounded-[36px] bg-surface px-6 py-16 sm:px-12 sm:py-24"><div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 size-[420px] rounded-full border-[56px] border-white/70"></div><p data-reveal="fade" class="eyebrow relative text-ink/55">$299<!-- --> · <!-- -->No subscription. Every metric included.</p><h2 id="reserve-cta-title" data-split="true" class="relative mt-6 max-w-[12ch] font-display text-[clamp(2.1rem,10.5vw,3rem)] uppercase sm:text-[clamp(3rem,9vw,8.5rem)] leading-[0.86] text-ink"><span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">Reserve</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">yours.</span></span>