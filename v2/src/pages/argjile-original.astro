18" stroke-dasharray="4 5" stroke-width="1"></rect><g stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" class="transition-colors duration-500 ease-soft text-charcoal"><path d="M230 252H350V318H230Z"></path><path d="M246 264L270 306M270 264L294 306M294 264L318 306M318 264L338 300"></path></g><g class="transition-opacity duration-500 ease-soft opacity-0"><path d="M240 326V338" stroke="currentColor" stroke-width="1" class="text-terracotta"></path><text x="226" y="350" text-anchor="start" class="fill-terracotta font-mono text-[11px] uppercase tracking-[0.18em]">Wedging table</text></g></g></svg></div><figcaption class="mt-5 flex min-h-[3.5rem] flex-col gap-1 md:flex-row md:items-baseline md:justify-between md:gap-8"><span class="mono-label text-charcoal/55">Plan, not to scale</span><span class="max-w-sm text-[0.9375rem] leading-relaxed text-charcoal/75 md:text-right">Hover or tap the plan to walk through the room.</span></figcaption></figure></div></div></section><section id="workshops" aria-labelledby="workshops-title" class="relative border-t border-charcoal/10 bg-bone px-[6vw] pb-28 pt-24 md:pb-40 md:pt-32"><div class="flex items-center gap-5"><p class="mono-label whitespace-nowrap">06<!-- --> — <!-- -->Workshops</p><span aria-hidden="true" class="h-px flex-1 bg-current opacity-20"></span></div><div class="mt-14 grid gap-14 md:mt-20 md:grid-cols-12 md:gap-10"><aside class="md:sticky md:top-28 md:col-span-4 md:self-start"><h2 id="workshops-title" data-reveal="" class="font-heading text-[clamp(3rem,5.6vw,6rem)] leading-[0.9] tracking-[-0.02em]"><span class="reveal-line"><span style="transition-delay:0s">Sit at</span></span><span class="reveal-line"><span style="transition-delay:0.1s">the wheel.</span></span></h2><p class="reveal-settle mt-8 max-w-sm text-[1.0625rem] leading-relaxed text-charcoal/80" style="transition-delay:0.15s">Small groups, patient teachers and a wheel each. You leave with clay under your nails and, about three weeks later, your own fired piece.</p><div class="reveal-settle mt-12" style="transition-delay:0.3s"><div class="relative max-w-xs -rotate-[1.5deg] border border-charcoal/10 bg-[#F4EFE6] px-6 pb-6 pt-8 shadow-[0_18px_40px_-28px_rgba(27,23,20,0.55)]"><span aria-hidden="true" class="absolute left-1/2 top-3 size-2.5 -translate-x-1/2 rounded-full bg-terracotta shadow-[0_2px_3px_rgba(27,23,20,0.35)]"></span><p class="mono-label text-charcoal/55">Pinned note</p><p class="mt-3 font-heading text-[1.75rem] italic leading-[1.08]">Aprons, tea, and clay-stained hands are included.</p><p class="mt-4 text-[0.875rem] leading-relaxed text-charcoal/70">We trim, glaze and fire your favourite piece, then email you when it is ready to collect.</p></div></div></aside><div class="flex flex-col md:col-span-7 md:col-start-6"><article class="reveal-settle border-t border-charcoal pb-12 pt-7 last:pb-0 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:gap-12" style="transition-delay:0s"><div><div class="flex items-baseline gap-5"><span class="mono-label text-charcoal/50">01</span><h3 class="font-heading text-[clamp(2.3rem,3.6vw,3.5rem)] leading-[0.95] tracking-[-0.01em]" data-mdlfy-cms="workshops:9653321c-34bf-4ef6-ae77-65bb0828b1df:name">Intro to the Wheel</h3></div><p class="mono-label mt-4 flex flex-wrap gap-x-5 gap-y-1 text-charcoal/65"><span data-mdlfy-cms="workshops:9653321c-34bf-4ef6-ae77-65bb0828b1df:duration">2 hours</span><span>Next: <span>date to be announced</span></span></p><p class="mt-5 max-w-lg text-[1rem] leading-relaxed text-charcoal/80" data-mdlfy-cms="workshops:9653321c-34bf-4ef6-ae77-65bb0828b1df:description">Two hours on a wheel of your own. We centre, open and pull together until something stands up by itself, then trim, glaze and fire your favourite piece for you.</p></div><div class="mt-8 flex flex-col items-start gap-5 md:mt-1 md:min-w-[13rem] md:items-end md:text-right"><p class="flex items-baseline gap-2"><span class="font-mono text-[1.6rem] leading-none">€<span>55</span></span><span class="mono-label text-charcoal/60" data-mdlfy-cms="workshops:9653321c-34bf-4ef6-ae77-65bb0828b1df:price_note">per person</span></p><div class="flex flex-col items-start gap-2 md:items-end"><span aria-hidden="true" class="flex flex-wrap gap-1.5"><span class="block size-2.5 rounded-full border border-charcoal bg-charcoal"></span><span class="block size-2.5 rounded-full border border-charcoal bg-charcoal"></span><span class="block size-2.5 rounded-full border border-charcoal bg-charcoal"></span><span class="block size-2.5 rounded-full border border-charcoal bg-transparent opacity-35"></span><span class="block size-2.5 rounded-full border border-charcoal bg-transparent opacity-35"></span><span class="block size-2.5 rounded-full border border-charcoal bg-transparent opacity-35"></span><span class="block size-2.5 rounded-full border border-charcoal bg-transparent opacity-35"></span><span class="block size-2.5 rounded-full border border-charcoal bg-transparent opacity-35"></span></span><p class="mono-label text-charcoal/65"><span>3</span> of <span>8</span> <span data-mdlfy-cms="workshops:9653321c-34bf-4ef6-ae77-65bb0828b1df:spot_label">places</span> <!-- -->left</p></div><button type="button" class="btn btn-sm" aria-label="Reserve Intro to the Wheel">Reserve<span class="btn-end"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="size-4 shrink-0 rotate-0"><path d="M3 12H20.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path><path d="M14.5 5.5C15.6 8.4 17.7 10.8 20.5 12C17.7 13.2 15.6 15.6 14.5 18.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></button></div></article><article class="reveal-settle border-t border-charcoal pb-12 pt-7 last:pb-0 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:gap-12" style="transition-delay:0.1s"><div><div class="flex items-baseline gap-5"><span class="mono-label text-charcoal/50">02</span><h3 class="font-heading text-[clamp(2.3rem,3.6vw,3.5rem)] leading-[0.95] tracking-[-0.01em]" data-mdlfy-cms="workshops:5a271497-26a0-428d-8b68-3aef378b4038:name">Date Night Throw</h3></div><p class="mono-label mt-4 flex flex-wrap gap-x-5 gap-y-1 text-charcoal/65"><span data-mdlfy-cms="workshops:5a271497-26a0-428d-8b68-3aef378b4038:duration">2.5 hours</span><span>Next: <span>date to be announced</span></span></p><p class="mt-5 max-w-lg text-[1rem] leading-relaxed text-charcoal/80" data-mdlfy-cms="workshops:5a271497-26a0-428d-8b68-3aef378b4038:description">A slow evening for two: a wheel each, a pot of mountain tea and one teacher moving quietly between you. Bring someone who does not mind clay on their sleeve.</p></div><div class="mt-8 flex flex-col items-start gap-5 md:mt-1 md:min-w-[13rem] md:items-end md:text-right"><p class="flex items-baseline gap-2"><span class="font-mono text-[1.6rem] leading-none">€<span>120</span></span><span class="mono-label text-charcoal/60" data-mdlfy-cms="workshops:5a271497-26a0-428d-8b68-3aef378b4038:price_note">per pair</span></p><div class="flex flex-col items-start gap-2 md:items-end"><span aria-hidden="true" class="flex flex-wrap gap-1.5"><span class="block size-2.5 rounded-full border border-charcoal bg-charcoal"></span><span class="block size-2.5 rounded-full border border-charcoal bg-charcoal"></span><span class="block size-2.5 rounded-full border border-charcoal bg-transparent opacity-35"></span><span class="block size-2.5 rounded-full border border-charcoal bg-transparent opacity-35"></span><span class="block size-2.5 rounded-full border border-charcoal bg-transparent opacity-35"></span></span><p class="mono-label text-charcoal/65"><span>2</span> of <span>5</span> <span data-mdlfy-cms="workshops:5a271497-26a0-428d-8b68-3aef378b4038:spot_label">pairs</span> <!-- -->left</p></div><button type="button" class="btn btn-sm" aria-label="Reserve Date Night Throw">Reserve<span class="btn-end"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="size-4 shrink-0 rotate-0"><path d="M3 12H20.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path><path d="M14.5 5.5C15.6 8.4 17.7 10.8 20.5 12C17.7 13.2 15.6 15.6 14.5 18.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></button></div></article><article class="reveal-settle border-t border-charcoal pb-12 pt-7 last:pb-0 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:gap-12" style="transition-delay:0.2s"><div><div class="flex items-baseline gap-5"><span class="mono-label text-charcoal/50">03</span><h3 class="font-heading text-[clamp(2.3rem,3.6vw,3.5rem)] leading-[0.95] tracking-[-0.01em]" data-mdlfy-cms="workshops:dbb9ebfd-5837-45a9-bd5f-fa4bfa97c237:name">Private Masterclass</h3></div><p class="mono-label mt-4 flex flex-wrap gap-x-5 gap-y-1 text-charcoal/65"><span data-mdlfy-cms="workshops:dbb9ebfd-5837-45a9-bd5f-fa4bfa97c237:duration">4 hours</span><span>Next: <span>Tue 3 Nov · 10:00</span></span></p><p class="mt-5 max-w-lg text-[1rem] leading-relaxed text-charcoal/80" data-mdlfy-cms="workshops:dbb9ebfd-5837-45a9-bd5f-fa4bfa97c237:description">Four hours with our head potter, shaped around what you want to make. Taller walls, wider plates, cleaner trimming: we work on your hands, not a lesson plan.</p></div><div class="mt-8 flex flex-col items-start gap-5 md:mt-1 md:min-w-[13rem] md:items-end md:text-right"><p class="flex items-baseline gap-2"><span class="font-mono text-[1.6rem] leading-none">€<span>240</span></span><span class="mono-label text-charcoal/60" data-mdlfy-cms="workshops:dbb9ebfd-5837-45a9-bd5f-fa4bfa97c237:price_note">one to one</span></p><div class="flex flex-col items-start gap-2 md:items-end"><span aria-hidden="true" class="flex flex-wrap gap-1.5"><span class="block size-2.5 rounded-full border border-charcoal bg-charcoal"></span><span class="block size-2.5 rounded-full border border-charcoal bg-transparent opacity-35"></span></span><p class="mono-label text-charcoal/65"><span>1</span> of <span>2</span> <span data-mdlfy-cms="workshops:dbb9ebfd-5837-45a9-bd5f-fa4bfa97c237:spot_label">sessions</span> <!-- -->left</p></div><button type="button" class="btn btn-sm" aria-label="Reserve Private Masterclass">Reserve<span class="btn-end"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="size-4 shrink-0 rotate-0"><path d="M3 12H20.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path><path d="M14.5 5.5C15.6 8.4 17.7 10.8 20.5 12C17.7 13.2 15.6 15.6 14.5 18.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></button></div></article></div></div><div inert="" aria-hidden="true" class="fixed inset-0 z-[80] flex items-end justify-center md:items-center pointer-events-none"><button type="button" tabindex="-1" aria-label="Close" class="absolute inset-0 bg-charcoal/45 transition-opacity duration-700 ease-soft opacity-0"></button></div></section><section id="voices" aria-labelledby="voices-title" aria-roledescription="carousel" class="relative bg-bone px-[6vw] pb-28 pt-24 md:pb-40 md:pt-32"><div class="flex items-center gap-5"><p class="mono-label whitespace-nowrap">07<!-- --> — <!-- -->Voices</p><span aria-hidden="true" class="h-px flex-1 bg-current opacity-20"></span></div><h2 id="voices-title" class="sr-only">What people say about the studio</h2><div class="mt-16 grid md:mt-24" aria-live="off"><figure aria-hidden="false" class="[grid-area:1/1] transition-opacity duration-[1400ms] ease-soft opacity-100"><blockquote class="max-w-[64rem] font-heading text-[clamp(2.1rem,4.4vw,4.6rem)] italic leading-[1.04] tracking-[-0.012em] text-balance"><p><span aria-hidden="true">“</span>I came for one evening and left with a lopsided bowl I still eat breakfast from. Nobody rushed me, and the tea never ran out.<span aria-hidden="true">”</span></p></blockquote><figcaption class="mono-label mt-10 text-charcoal/65">Drita K.<!-- --> — <!-- -->Intro to the Wheel</figcaption></figure><figure aria-hidden="true" class="[grid-area:1/1] transition-opacity duration-[1400ms] ease-soft pointer-events-none opacity-0"><blockquote class="max-w-[64rem] font-heading text-[clamp(2.1rem,4.4vw,4.6rem)] italic leading-[1.04] tracking-[-0.012em] text-balance"><p><span aria-hidden="true">“</span>We bought four Ember Cups as a wedding present to ourselves. They are the first thing guests pick up and the last thing they put down.<span aria-hidden="true">”</span></p></blockquote><figcaption class="mono-label mt-10 text-charcoal/65">Leon &amp; Mira<!-- --> — <!-- -->Collection order, Tirana</figcaption></figure><figure aria-hidden="true" class="[grid-area:1/1] transition-opacity duration-[1400ms] ease-soft pointer-events-none opacity-0"><blockquote class="max-w-[64rem] font-heading text-[clamp(2.1rem,4.4vw,4.6rem)] italic leading-[1.04] tracking-[-0.012em] text-balance"><p><span aria-hidden="true">“</span>Four hours, one teacher, and finally a wall that rose without collapsing. The masterclass changed how I hold my hands.<span aria-hidden="true">”</span></p></blockquote><figcaption class="mono-label mt-10 text-charcoal/65">Arben G.<!-- --> — <!-- -->Private Masterclass</figcaption></figure></div><div class="mt-14 flex flex-col gap-6 md:mt-20 md:flex-row md:items-center md:gap-10"><div class="relative h-px flex-1 bg-charcoal/15"><span class="voices-progress absolute inset-0 origin-left bg-charcoal" style="animation-duration:7.5s;animation-play-state:running"></span></div><div class="flex items-center gap-6"><div class="flex items-center gap-1" role="group" aria-label="Choose a quote"><button type="button" aria-label="Quote 1 of 3, from Drita K." aria-pressed="true" class="mono-label px-2 py-2 transition-colors duration-500 ease-soft text-charcoal">01</button><button type="button" aria-label="Quote 2 of 3, from Leon &amp; Mira" aria-pressed="false" class="mono-label px-2 py-2 transition-colors duration-500 ease-soft text-charcoal/35 hover:text-charcoal/70">02</button><button type="