---
// v2/src/pages/sandiego/company.astro
import SanDiegoLayout from '../../layouts/SanDiegoLayout.astro';
---

<SanDiegoLayout title="Company | San Diego" activePage="company">
<main>
 <div class="section-hero">
  <div class="main-hero-container about-main-hero-container">
   <div class="small-container">
    <div class="text-center">
     <div class="animation-on-page-load">
      <div class="logo-about-holder">
       <img alt="San Diego" class="logo-about" loading="lazy" sizes="(max-width: 479px) 200px, 310px" src="/images/Logo-About.png" srcset="/images/Logo-About-p-500.png 500w, /images/Logo-About-p-800.png 800w, /images/Logo-About.png 956w"/>
      </div>
     </div>
     <h1 class="main-heading">
      <span class="white-text">
       The Power of
      </span>
      <span class="text-gradient">
       Teamwork
      </span>
     </h1>
     <div class="w-layout-grid grid-10-columns">
      <p class="hero-description on-dark">
       Experience a new era of time, finance, and task management. Say goodbye to missed deadlines and hello to a stress-free, productive life.
      </p>
     </div>
     <div class="download-buttons hero-download-buttons">
      <div class="download-button">
       <a class="button black-button w-inline-block" href="https://apple.com" rel="noreferrer" target="_blank">
        <img alt="" class="download-button-icon" loading="lazy" src="/images/Apple-Icon.svg"/>
        <div>
         <span class="hide-on-mobile">
          Download for
         </span>
         iOS
        </div>
       </a>
      </div>
      <div class="download-button">
       <a class="button black-button w-inline-block" href="https://play.google.com/store/apps" rel="noreferrer" target="_blank">
        <img alt="" class="download-button-icon" loading="lazy" src="/images/Android-Icon.svg"/>
        <div>
         <span class="hide-on-mobile">
          Download for
         </span>
         Android
        </div>
       </a>
      </div>
     </div>
    </div>
   </div>
  </div>
  <div class="about-section-bg">
  </div>
 </div>
 <div class="section">
  <div class="container">
   <div class="fade-in-on-scroll">
    <h2>
     Working
     <span class="text-gradient">
      together
     </span>
     is what makes us special
    </h2>
    <div class="text-container">
     <div class="grey-text">
      We are a small, focused team that cares deeply about helping people feel in control of their day.
     </div>
    </div>
   </div>
   <div class="w-layout-grid about-grid">
    <div class="grey-card-item-holder">
     <div class="card-content-holder bigger-cards">
      <div class="fade-in-on-scroll">
       <div class="card-title-sm">
        Pioneering Seamless Living
       </div>
       <p class="card-description">
        At San Diego, we push the boundaries of what is possible, continuously innovating to provide cutting-edge solutions that enhance your daily life.
       </p>
      </div>
      <img alt="" class="card-about-image" loading="lazy" sizes="(max-width: 479px) 76vw, (max-width: 1279px) 38vw, 524px" src="/images/3dicons-2.png" srcset="/images/3dicons-2-p-500.png 500w, /images/3dicons-2-p-800.png 800w, /images/3dicons-2.png 1278w"/>
     </div>
    </div>
    <div class="grey-card-item-holder">
     <div class="card-content-holder bigger-cards">
      <div class="fade-in-on-scroll">
       <div class="card-title-sm">
        Effortless Mastery at Your Fingertips
       </div>
       <p class="card-description">
        We believe in simplifying complexity. San Diego is designed with a clean and intuitive interface, making its powerful features effortless to use.
       </p>
      </div>
      <img alt="" class="card-about-image" loading="lazy" sizes="(max-width: 479px) 76vw, (max-width: 1279px) 38vw, 524px" src="/images/3dicons-3.png" srcset="/images/3dicons-3-p-500.png 500w, /images/3dicons-3.png 1278w"/>
     </div>
    </div>
    <div class="grey-card-item-holder">
     <div class="card-content-holder bigger-cards">
      <div class="fade-in-on-scroll">
       <div class="card-title-sm">
        Fortifying Your Digital Sanctuary
       </div>
       <p class="card-description">
        We adhere to strict data protection measures, employing robust encryption and safeguarding protocols to keep your valuable information secure.
       </p>
      </div>
      <img alt="" class="card-about-image" loading="lazy" sizes="(max-width: 479px) 76vw, (max-width: 1279px) 38vw, 524px" src="/images/3dicons.png" srcset="/images/3dicons-p-500.png 500w, /images/3dicons-p-800.png 800w, /images/3dicons.png 1278w"/>
     </div>
    </div>
    <div class="grey-card-item-holder">
     <div class="card-content-holder bigger-cards">
      <div class="fade-in-on-scroll">
       <div class="card-title-sm">
        Empowering You to Thrive
       </div>
       <p class="card-description">
        With San Diego, you have the tools to optimize your time, make informed financial decisions, and achieve personal and professional success.
       </p>
      </div>
      <img alt="" class="card-about-image" loading="lazy" sizes="(max-width: 479px) 76vw, (max-width: 1279px) 38vw, 524px" src="/images/3dicons-1.png" srcset="/images/3dicons-1-p-500.png 500w, /images/3dicons-1-p-800.png 800w, /images/3dicons-1.png 1278w"/>
     </div>
    </div>
   </div>
  </div>
 </div>
 <div class="section">
  <div class="container">
   <div class="fade-in-on-scroll">
    <h2>
     Working
     <span class="text-gradient">
      together
     </span>
     is what makes us special
    </h2>
    <div class="text-container">
     <div class="grey-text">
      From design to engineering, we build San Diego the way we want to use it ourselves.
     </div>
    </div>
   </div>
   <div class="about-images-grid">
    <div class="content" id="w-node-_8db46236-34c0-a907-dbd5-3aa2c9c6ad29-77af5896">
     <div class="about-image-holder">
      <img alt="San Diego team" class="about-image" loading="lazy" sizes="(max-width: 767px) 95vw, (max-width: 1279px) 62vw, 805px" src="/images/About1.webp" srcset="/images/About1-p-500.jpg 500w, /images/About1-p-800.jpg 800w, /images/About1-p-1080.jpg 1080w, /images/About1-p-1600.jpg 1600w, /images/About1.webp 1968w"/>
     </div>
    </div>
    <div class="content">
     <div class="about-image-holder">
      <img alt="San Diego workspace" class="about-image" loading="lazy" sizes="(max-width: 767px) 95vw, (max-width: 1279px) 31vw, 402px" src="/images/About2.webp" srcset="/images/About2-p-500.jpg 500w, /images/About2-p-800.jpg 800w, /images/About2-p-1080.jpg 1080w, /images/About2.webp 1380w"/>
     </div>
    </div>
    <div class="content">
     <div class="about-image-holder">
      <img alt="San Diego team at work" class="about-image" loading="lazy" sizes="(max-width: 767px) 95vw, (max-width: 1279px) 62vw, 805px" src="/images/About3.webp" srcset="/images/About3-p-500.jpg 500w, /images/About3-p-800.jpg 800w, /images/About3-p-1080.jpg 1080w, /images/About3.webp 1380w"/>
     </div>
    </div>
   </div>
  </div>
 </div>
 <div class="section section-grey-bg">
  <div class="container">
   <div class="fade-in-on-scroll">
    <h2>
     Working
     <span class="text-gradient">
      together
     </span>
     is what makes it work
    </h2>
    <div class="text-container">
     <div class="grey-text">
      We are hiring. Join us and help shape the future of seamless living.
     </div>
    </div>
   </div>
   <div class="job-postion-card-holder">
    <div aria-expanded="false" class="simple-info-holder" role="button" tabindex="0">
     <div class="simple-info">
      <div class="career-item-title">
       Head of Design
      </div>
      <div class="grey-text">
       Berlin / Remote
      </div>
     </div>
     <div class="arrow-holder">
      <div class="career-arrow-bg">
      </div>
      <img alt="" class="career-arrow-image" loading="lazy" src="/images/Arrow-Icon.svg"/>
     </div>
    </div>
    <div class="more-info-holder">
     <div class="job-description-holder">
      <div class="job-content title">
       <div>
        <strong>
         Job Description
        </strong>
       </div>
      </div>
      <div class="job-content">
       <p class="grey-text">
        Lead the design of San Diego across mobile and web. You will own the end-to-end experience, from first sketch to shipped feature, and set the bar for craft across the team.
       </p>
      </div>
     </div>
     <div class="career-item-line">
     </div>
     <div class="job-description-holder">
      <div class="job-content title">
       <div>
        <strong>
         Opportunity
        </strong>
       </div>
      </div>
      <div class="job-content">
       <p class="grey-text">
        Shape a product used every day by thousands of people, work directly with founders, and build a design culture from the ground up.
       </p>
      </div>
     </div>
     <a class="button rounded-orage-button w-button" href="https://linkedin.com" rel="noreferrer" target="_blank">
      Apply on LinkedIn
     </a>
    </div>
   </div>
   <div class="job-postion-card-holder">
    <div aria-expanded="false" class="simple-info-holder" role="button" tabindex="0">
     <div class="simple-info">
      <div class="career-item-title">
       Frontend Engineer
      </div>
      <div class="grey-text">
       Remote
      </div>
     </div>
     <div class="arrow-holder">
      <div class="career-arrow-bg">
      </div>
      <img alt="" class="career-arrow-image" loading="lazy" src="/images/Arrow-Icon.svg"/>
     </div>
    </div>
    <div class="more-info-holder">
     <div class="job-description-holder">
      <div class="job-content title">
       <div>
        <strong>
         Job Description
        </strong>
       </div>
      </div>
      <div class="job-content">
       <p class="grey-text">
        Build fast, accessible, beautifully animated interfaces in React. You will turn designs into production features and keep the experience smooth on every device.
       </p>
      </div>
     </div>
     <div class="career-item-line">
     </div>
     <div class="job-description-holder">
      <div class="job-content title">
       <div>
        <strong>
         Opportunity
        </strong>
       </div>
      </div>
      <div class="job-content">
       <p class="grey-text">
        Work on a polished product with real users, influence the architecture, and grow with a team that values quality over shortcuts.
       </p>
      </div>
     </div>
     <a class="button rounded-orage-button w-button" href="https://linkedin.com" rel="noreferrer" target="_blank">
      Apply on LinkedIn
     </a>
    </div>
   </div>
  </div>
 </div>
</main>

</SanDiegoLayout>
