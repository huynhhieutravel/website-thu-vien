---
// v2/src/pages/sandiego/features.astro
import SanDiegoLayout from '../../layouts/SanDiegoLayout.astro';
---

<SanDiegoLayout title="Features | San Diego" activePage="features">
<main>
 <div class="section-hero">
  <div class="main-hero-container">
   <div class="small-container">
    <div class="text-center">
     <div class="hero-link-holder">
      <div class="text-hidden">
       <div class="hero-top-content">
        <a class="hero-link w-inline-block" href="/features#Download">
         <div class="link-new-badge">
          New
         </div>
         <div>
          Introducing the Class app
         </div>
         <div class="hero-link-arrow">
         </div>
        </a>
       </div>
      </div>
     </div>
     <h1 class="main-heading">
      Don't live like 1800's, it's
      <span class="text-gradient">
       2024
      </span>
      baby!
     </h1>
     <div class="w-layout-grid grid-10-columns">
      <p class="hero-description">
       San Diego keeps your work on-brand, on message, and on time. Innovative features make creating and sharing your work feel effortless.
      </p>
     </div>
     <div class="download-buttons hero-download-buttons">
      <div class="download-button">
       <a class="button black-button w-inline-block" href="https://apple.com" rel="noreferrer" target="_blank">
        <img alt="" class="download-button-icon" loading="lazy" src="/images/Apple-Icon.svg"/>
        <div>
         <span class="hide-on-mobile">
          Download for
         </span>
         iOS
        </div>
       </a>
      </div>
      <div class="download-button">
       <a class="button black-button w-inline-block" href="https://play.google.com/store/apps" rel="noreferrer" target="_blank">
        <img alt="" class="download-button-icon" loading="lazy" src="/images/Android-Icon.svg"/>
        <div>
         <span class="hide-on-mobile">
          Download for
         </span>
         Android
        </div>
       </a>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
 <div class="section" id="FeatureList">
  <div class="container">
   <div class="animation-on-page-load">
    <div class="w-layout-grid features-page-grid">
     <div class="grey-card-item-holder" id="w-node-_683f6423-2343-b727-5633-7065e36f1185-77af58a2">
      <div class="card-content-holder bigger-cards">
       <div class="fade-in-on-scroll">
        <div class="text-center">
         <div class="card-title-sm">
          Stay on Top of Your Schedule
         </div>
         <p class="card-description">
          Easily integrate with all your favorite tools through a flexible API and Zapier integration.
         </p>
        </div>
       </div>
       <img alt="San Diego schedule view" class="card-iphone-image" loading="lazy" sizes="(max-width: 767px) 85vw, (max-width: 1279px) 46vw, 624px" src="/images/Top-Schedule.webp" srcset="/images/Top-Schedule-p-500.png 500w, /images/Top-Schedule-p-800.png 800w, /images/Top-Schedule-p-1080.png 1080w, /images/Top-Schedule-p-1600.png 1600w, /images/Top-Schedule.webp 1835w"/>
      </div>
     </div>
     <div class="grey-card-item-holder" id="w-node-_51e55d01-3c69-3038-c7cd-21ca1bd224bf-77af58a2">
      <div class="card-content-holder bigger-cards">
       <div class="fade-in-on-scroll">
        <div class="text-center">
         <div class="card-title-sm">
          Financial Freedom
         </div>
         <p class="card-description">
          Gain control over your expenses and make smarter financial decisions.
         </p>
        </div>
       </div>
       <div class="card-image-to-corner">
        <img alt="San Diego finance view" class="card-image-100pct" loading="lazy" sizes="100vw" src="/images/Financial-Freedom.webp" srcset="/images/Financial-Freedom-p-500.png 500w, /images/Financial-Freedom-p-800.png 800w, /images/Financial-Freedom-p-1080.png 1080w, /images/Financial-Freedom.webp 1383w"/>
       </div>
      </div>
     </div>
     <div class="grey-card-item-holder" id="w-node-_897ff961-4a2b-567e-4a21-bf49fcd29a77-77af58a2">
      <div class="card-content-holder bigger-cards">
       <div class="fade-in-on-scroll">
        <div class="text-center">
         <div class="card-title-sm">
          Safeguard Data
         </div>
         <p class="card-description">
          Store and access all your important information securely in one place.
         </p>
        </div>
       </div>
       <div class="card-image-to-corner">
        <img alt="San Diego security view" class="card-image-100pct" loading="lazy" sizes="100vw" src="/images/Safeguard.webp" srcset="/images/Safeguard-p-500.png 500w, /images/Safeguard-p-800.png 800w, /images/Safeguard-p-1080.png 1080w, /images/Safeguard.webp 1380w"/>
       </div>
      </div>
     </div>
    </div>
   </div>
   <div class="w-layout-grid features-page-grid _2">
    <div class="grey-card-item-holder" id="w-node-_78b7323e-030b-5aa6-7734-8f321585dcc2-77af58a2">
     <div class="card-content-holder bigger-cards">
      <div class="fade-in-on-scroll">
       <div class="card-item-with-text-the-bottom">
        <div class="card-title-sm">
         <span class="white-text">
          Capture Ideas on the Go
         </span>
        </div>
       </div>
      </div>
      <div class="card-image-holder">
       <img alt="Person using San Diego" class="card-image-bg" loading="lazy" sizes="(max-width: 767px) 95vw, (max-width: 1279px) 39vw, 503px" src="/images/Card-ImagePerson.webp" srcset="/images/Card-ImagePerson-p-500.jpg 500w, /images/Card-ImagePerson-p-800.jpg 800w, /images/Card-ImagePerson-p-1080.jpg 1080w, /images/Card-ImagePerson.webp 1380w"/>
       <div class="card-image-holder-overlay">
       </div>
      </div>
     </div>
    </div>
    <div class="grey-card-item-holder" id="w-node-_2abbd720-0bb2-88d3-f9b1-e54f95e89d83-77af58a2">
     <div class="card-content-holder bigger-cards">
      <div class="fade-in-on-scroll">
       <div class="text-center">
        <div class="card-title-sm">
         Smart Reminders
        </div>
        <p class="card-description">
         Never miss a deadline with reminders that respect your focus.
        </p>
       </div>
      </div>
      <div class="card-image-to-corner">
       <img alt="San Diego reminders" class="card-image-100pct" loading="lazy" sizes="100vw" src="/images/Reminder.png" srcset="/images/Reminder-p-500.png 500w, /images/Reminder-p-800.png 800w, /images/Reminder-p-1080.png 1080w, /images/Reminder-p-1600.png 1600w, /images/Reminder.png 1968w"/>
      </div>
     </div>
    </div>
    <div class="grey-card-item-holder" id="w-node-_2f1d4b38-7a36-2a3c-b862-7b209a203be8-77af58a2">
     <div class="card-content-holder bigger-cards">
      <div class="fade-in-on-scroll">
       <div class="text-center">
        <div class="card-title-sm">
         Your Productivity Sidekick
        </div>
        <p class="card-description">
         Let our AI handle mundane tasks and provide valuable insights for optimal efficiency.
        </p>
       </div>
      </div>
      <div class="card-image-to-corner">
       <img alt="San Diego AI assistant" class="card-image-100pct" loading="lazy" sizes="100vw" src="/images/AI.webp" srcset="/images/AI-p-500.png 500w, /images/AI-p-800.png 800w, /images/AI-p-1080.png 1080w, /images/AI.webp 1380w"/>
      </div>
     </div>
    </div>
    <div class="grey-card-item-holder" id="w-node-_068289f4-e438-fbcc-fb63-74d8e36ae71c-77af58a2">
     <div class="card-content-holder bigger-cards">
      <div class="fade-in-on-scroll">
       <div class="text-center">
        <div class="card-title-sm">
         Personalize Your App Experience
        </div>
        <p class="card-description">
         Enjoy a sleek interface and reduce eye strain with our customizable Dark Mode.
        </p>
       </div>
      </div>
      <div class="card-image-to-corner">
       <img alt="San Diego personalization" class="card-image-100pct" loading="lazy" sizes="100vw" src="/images/Personalize.webp" srcset="/images/Personalize-p-500.png 500w, /images/Personalize-p-800.png 800w, /images/Personalize-p-1080.png 1080w, /images/Personalize.webp 1380w"/>
      </div>
     </div>
    </div>
    <div class="grey-card-item-holder" id="w-node-cf622425-eeeb-8f7c-77c7-371e18bd1ec4-77af58a2">
     <div class="card-content-holder bigger-cards">
      <div class="fade-in-on-scroll">
       <div class="card-item-with-text-the-bottom">
        <div class="card-title-sm">
         <span class="white-text">
          Cross-Platform Syncing: Seamlessly Access Your Data
         </span>
        </div>
       </div>
      </div>
      <div class="card-image-holder">
       <img alt="Person syncing San Diego" class="card-image-bg" loading="lazy" sizes="(max-width: 767px) 95vw, (max-width: 1279px) 39vw, 503px" src="/images/CardImagePerson2.webp" srcset="/images/CardImagePerson2-p-500.jpg 500w, /images/CardImagePerson2-p-800.jpg 800w, /images/CardImagePerson2-p-1080.jpg 1080w, /images/CardImagePerson2.webp 1968w"/>
       <div class="card-image-holder-overlay">
       </div>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
 <div class="section">
  <div class="container">
   <div class="text-left" id="w-node-b262d101-88e2-3de7-f57b-8d4a24389714-77af58a2">
    <div class="fade-in-on-scroll">
     <h2>
      Ignite Your Potential with
      <span class="text-gradient">
       Seamless Power
      </span>
     </h2>
    </div>
    <div class="fade-in-on-scroll">
     <p class="grey-text">
      One app for time, money, and tasks, so nothing slips through the cracks.
     </p>
    </div>
   </div>
   <div class="grid-app-features-2cols">
    <div class="app-features">
     <div class="fade-in-on-scroll left">
      <img alt="" class="icon-image" loading="lazy" src="/images/Folder-Icon.svg"/>
     </div>
     <div class="fade-in-on-scroll">
      <div class="card-title-sm">
       Seamlessly integrate time, finance, and task management in one app.
      </div>
     </div>
    </div>
    <div class="app-features">
     <div class="fade-in-on-scroll left">
      <img alt="" class="icon-image" loading="lazy" src="/images/User-Icon.svg"/>
     </div>
     <div class="fade-in-on-scroll">
      <div class="card-title-sm">
       Gain a comprehensive overview of your expenses for informed decision-making.
      </div>
     </div>
    </div>
    <div class="app-features">
     <div class="fade-in-on-scroll left">
      <img alt="" class="icon-image" loading="lazy" src="/images/Table-Icon.svg"/>
     </div>
     <div class="fade-in-on-scroll">
      <div class="card-title-sm">
       Effortlessly stay organized with an intuitive interface and powerful features.
      </div>
     </div>
    </div>
    <div class="app-features">
     <div class="fade-in-on-scroll left">
      <img alt="" class="icon-image" loading="lazy" src="/images/AI-Icon.svg"/>
     </div>
     <div class="fade-in-on-scroll">
      <div class="card-title-sm">
       Let the AI-powered personal assistant handle mundane tasks for you.
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
 <div class="section">
  <div class="container">
   <div class="text-left" id="w-node-_4d156a35-5ff3-7081-9732-1d15bc3c363f-77af58a2">
    <div class="fade-in-on-scroll">
     <h2 class="text-center">
      Empowering You with Advanced Capabilities
     </h2>
    </div>
   </div>
   <div class="features-page-grid-list">
    <div class="features-page-grid _2">
     <div class="long-feature-content">
      <div class="fade-in-on-scroll">
       <div class="card-title-sm">
        Effortless Management
       </div>
      </div>
      <div class="fade-in-on-scroll">
       <div>
        Managing your time, finances, and tasks has never been easier than with San Diego. The user-friendly interface makes navigation effortless, from adding new tasks to editing existing ones, all streamlined to save you time.
       </div>
      </div>
      <div class="fade-in-on-scroll">
       <ul class="list-with-check-icons" role="list">
        <li>
         Add and edit tasks in seconds
        </li>
        <li>
         Sync across all your devices
        </li>
        <li>
         See everything in one calm view
        </li>
       </ul>
      </div>
      <div class="fade-in-on-scroll">
       <div class="button-holder-left-justify-bottom">
        <a class="button black-button-with-icon w-button" href="/sandiego/pricing">
         See pricing
        </a>
       </div>
      </div>
     </div>
     <div class="grey-card-item-holder card-item-with-xl-bg-image" id="w-node-_639c9289-1bcc-e302-dffb-17a6e38c0822-77af58a2">
      <div class="card-content-holder bigger-cards">
       <div class="card-image-holder card-image-effortless-management">
        <img alt="San Diego management dashboard" class="card-image-bg" loading="lazy" sizes="(max-width: 767px) 95vw, (max-width: 1279px) 54vw, 704px" src="/images/ManagementBg.jpg" srcset="/images/ManagementBg-p-500.jpg 500w, /images/ManagementBg-p-800.jpg 800w, /images/ManagementBg-p-1080.jpg 1080w, /images/ManagementBg-p-1600.jpg 1600w, /images/ManagementBg.jpg 1962w"/>
        <div class="card-image-holder-overlay">
        </div>
       </div>
      </div>
     </div>
    </div>
    <div class="features-page-grid">
     <div class="card-with-person-image features-card-with-person">
      <div class="grey-card-item-holder with-top-padding" id="w-node-d6f44763-ad30-c17d-bcb6-29b9132d6280-77af58a2">
       <div class="card-content-holder bigger-cards">
        <div class="fade-in-on-scroll">
         <div class="card-item-with-text-the-bottom">
         </div>
        </div>
        <div class="card-image-holder">
         <img alt="" class="card-image-bg" loading="lazy" src="/images/Gradient-Box.svg"/>
        </div>
       </div>
      </div>
      <img alt="Person chatting with San Diego" class="card-image-person-chatting" loading="lazy" sizes="(max-width: 767px) 95vw, (max-width: 1279px) 54vw, 704px" src="/images/Person-Chatting.webp" srcset="/images/Person-Chatting-p-500.png 500w, /images/Person-Chatting-p-800.png 800w, /images/Person-Chatting-p-1080.png 1080w, /images/Person-Chatting-p-1600.png 1600w, /images/Person-Chatting.webp 1782w"/>
     </div>
     <div class="card-with-person-image">
      <div class="long-feature-content">
       <div class="fade-in-on-scroll">
        <div class="card-title-sm">
         Experience the Excellence with
         <br/>
         San Diego
        </div>
       </div>
       <div class="fade-in-on-scroll">
        <div>
         From busy professionals balancing work and personal commitments to students striving for academic success, San Diego has become an indispensable companion. It is the all-in-one app that brings order, efficiency, and peace of mind to your everyday life.
        </div>
       </div>
       <div class="fade-in-on-scroll">
        <ul class="list-with-check-icons" role="list">
         <li>
          Built for work and personal life
         </li>
         <li>
          Smart reminders that respect your focus
         </li>
         <li>
          Private and secure by default
         </li>
        </ul>
       </div>
       <div class="fade-in-on-scroll">
        <div class="button-holder-left-justify-bottom">
         <a class="button black-button-with-icon w-button" href="/sandiego/company">
          About us
         </a>
        </div>
       </div>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
</main>

</SanDiegoLayout>
