---
// v2/src/pages/sandiego/pricing.astro
import SanDiegoLayout from '../../layouts/SanDiegoLayout.astro';
---

<SanDiegoLayout title="Pricing | San Diego" activePage="pricing">
<main>
 <div class="section-hero">
  <div class="main-hero-container">
   <div class="small-container">
    <div class="text-center">
     <div class="hero-link-holder">
      <div class="text-hidden">
       <div class="hero-top-content">
        <a class="hero-link w-inline-block" href="/sandiego/features">
         <div class="link-new-badge">
          New
         </div>
         <div>
          Introducing the Class app
         </div>
         <div class="hero-link-arrow">
         </div>
        </a>
       </div>
      </div>
     </div>
     <h1 class="main-heading">
      Flexible pricing
      <br/>
      for
      <span class="text-gradient">
       companies
      </span>
      and developers
     </h1>
     <div class="w-layout-grid grid-10-columns">
      <p class="hero-description">
       Start free and upgrade as you grow. Every plan keeps your time, expenses, and tasks in one place.
      </p>
     </div>
     <div class="download-buttons hero-download-buttons">
      <div class="download-button">
       <a class="button black-button w-inline-block" href="https://apple.com" rel="noreferrer" target="_blank">
        <img alt="" class="download-button-icon" loading="lazy" src="/images/Apple-Icon.svg"/>
        <div>
         <span class="hide-on-mobile">
          Download for
         </span>
         iOS
        </div>
       </a>
      </div>
      <div class="download-button">
       <a class="button black-button w-inline-block" href="https://play.google.com/store/apps" rel="noreferrer" target="_blank">
        <img alt="" class="download-button-icon" loading="lazy" src="/images/Android-Icon.svg"/>
        <div>
         <span class="hide-on-mobile">
          Download for
         </span>
         Android
        </div>
       </a>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
 <div class="section animation-on-page-load" id="pricing">
  <div class="container">
   <div class="pricing-table">
    <div class="content">
     <div class="pricing-table-info">
      <div class="fade-in-on-scroll">
       <h2 class="heading-3-style">
        Keep everything organised
       </h2>
      </div>
      <div class="fade-in-on-scroll">
       <div>
        Choose the plan that fits your team. Every tier brings your time, expenses, and tasks into one calm, shared workspace, with no setup headaches and no surprises.
       </div>
      </div>
      <div class="fade-in-on-scroll">
       <div class="button-holder-left-justify-bottom">
        <a class="button black-button-with-icon w-button" href="/sandiego/contact">
         Talk to sales
        </a>
       </div>
      </div>
     </div>
    </div>
    <div class="content">
     <div class="card-item pricing-card">
      <div class="card-item-content pricing-item-content">
       <div class="pricing-item-content">
        <div class="pricing-title">
         Core
        </div>
        <div class="pricing-main-content">
         <div class="product-item-price">
          <sup class="superscript">
           $
          </sup>
          20
         </div>
         <div class="pricing-item-price-desc">
          per user / month
          <br/>
          billed annually
         </div>
        </div>
        <div class="pricing-item-description">
         For small teams that want a world-class experience without all the admin.
        </div>
       </div>
       <div class="pricing-item-button-holder">
        <a class="button w-button" href="/sandiego/contact">
         Try for Free
        </a>
       </div>
      </div>
     </div>
    </div>
    <div class="content">
     <div class="card-item pricing-card">
      <div class="card-item-content pricing-item-content">
       <div class="pricing-item-content">
        <div class="pricing-title">
         Pro
        </div>
        <div class="pricing-main-content">
         <div class="product-item-price">
          <sup class="superscript">
           $
          </sup>
          50
         </div>
         <div class="pricing-item-price-desc">
          per user / month
          <br/>
          billed annually
         </div>
        </div>
        <div class="pricing-item-description">
         For growing teams that need advanced controls, integrations, and priority support.
        </div>
       </div>
       <div class="pricing-item-button-holder">
        <a class="button w-button" href="/sandiego/contact">
         Try for Free
        </a>
       </div>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
 <div class="section">
  <div class="container">
   <div class="text-center mobile-left">
    <div class="fade-in-on-scroll">
     <div class="heading-container">
      <h2 class="heading-3-style">
       All plans include:
      </h2>
     </div>
    </div>
   </div>
   <div class="w-layout-grid grid-6-col">
    <div class="content">
     <div class="checklist-richtext w-richtext">
      <ul role="list">
       <li>
        Get started with
        <strong>
         San Diego
        </strong>
       </li>
       <li>
        High
        <strong>
         quality
        </strong>
        assets
       </li>
       <li>
        <strong>
         Unlimited
        </strong>
        access
       </li>
      </ul>
     </div>
    </div>
    <div class="content">
     <div class="checklist-richtext w-richtext">
      <ul role="list">
       <li>
        Full storage
        <strong>
         security
        </strong>
       </li>
       <li>
        <strong>
         +3 team
        </strong>
        members
       </li>
       <li>
        <strong>
         AI &amp; ML
        </strong>
        services
       </li>
      </ul>
     </div>
    </div>
    <div class="content">
     <div class="checklist-richtext w-richtext">
      <ul role="list">
       <li>
        <strong>
         24/7
        </strong>
        support
       </li>
       <li>
        Direct
        <strong>
         chat
        </strong>
       </li>
       <li>
        <strong>
         Emails
        </strong>
        and
        <strong>
         Phone
        </strong>
        calls
       </li>
      </ul>
     </div>
    </div>
   </div>
  </div>
 </div>
</main>

</SanDiegoLayout>
