---
<footer class="relative z-10 overflow-hidden bg-charcoal text-bone"><div class="px-5 pt-20 sm:px-8 lg:px-12 lg:pt-28"><div class="grid gap-14 border-b border-bone/10 pb-16 lg:grid-cols-12 lg:gap-8"><div class="lg:col-span-5"><span class="inline-flex items-center gap-2.5 mb-10"><svg aria-hidden="true" class="size-7 shrink-0" viewbox="0 0 32 32"><circle cx="16" cy="16" fill="none" r="15" stroke="currentColor" stroke-opacity="0.35"></circle><path d="M5.5 22.5c3.2-3.4 6.7-5 10.5-5s7.3 1.6 10.5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-opacity="0.45"></path><path d="M15 7.5v12" stroke="currentColor" stroke-linecap="round" stroke-width="1.6"></path><path d="M15.8 7.8l6.4 2.6-6.4 2.6z" fill="currentColor"></path></svg><span class="type-wide text-[15px] font-semibold uppercase leading-none tracking-[0.16em]">Morrow</span></span><p class="max-w-md font-serif text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.15] text-bone/90">Tee sheets open <em>twenty-one days</em> ahead for members and fourteen for guests.</p><a class="mt-8 inline-flex h-12 items-center gap-3 rounded-full bg-bone px-6 text-[12px] font-semibold uppercase tracking-[0.16em] text-charcoal transition-colors hover:bg-ochre" href="/morrow/visit#booking">Book a tee time<svg aria-hidden="true" class="lucide lucide-arrow-up-right size-4" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></a></div><div class="grid grid-cols-1 gap-10 min-[480px]:grid-cols-2 lg:col-span-7 lg:grid-cols-3"><div><h2 class="mb-4 font-mono text-[11px] uppercase tracking-[0.24em] text-bone/45">Visit</h2><address class="not-italic leading-relaxed text-bone/80"><span class="block">Morrow Golf Park</span><span class="block">Estrada da Costa</span><span class="block">7570 Grândola, Portugal</span></address><a class="mt-4 inline-block break-all text-bone/80 underline decoration-bone/25 underline-offset-4 transition-colors hover:text-ochre" href="mailto:concierge@morrowgolfpark.com">concierge@morrowgolfpark.com</a></div><div><h2 class="mb-4 font-mono text-[11px] uppercase tracking-[0.24em] text-bone/45">Hours</h2><dl class="space-y-3"><div><dt class="text-bone/80">Championship 18</dt><dd class="text-sm text-bone/50">Sunrise to sunset</dd></div><div><dt class="text-bone/80">The Short Nine</dt><dd class="text-sm text-bone/50">Until 23:00, floodlit</dd></div><div><dt class="text-bone/80">Clubhouse</dt><dd class="text-sm text-bone/50">07:00 to 23:00</dd></div></dl></div><nav aria-label="Footer"><h2 class="mb-4 font-mono text-[11px] uppercase tracking-[0.24em] text-bone/45">Explore</h2><ul class="grid grid-cols-2 gap-x-6 gap-y-2 lg:grid-cols-1"><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow">Home</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/course">The course</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/clubhouse">Clubhouse</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/academy">Academy</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/membership">Membership</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/dining">Dining &amp; stays</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/events">Events</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/nature">Nature &amp; lifestyle</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/gallery">Gallery</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/visit">Visit &amp; book</a></li><li><a class="text-bone/70 transition-colors hover:text-bone" href="/morrow/contact">Contact</a></li></ul></nav></div></div><div class="flex flex-col gap-4 py-6 text-xs text-bone/45 sm:flex-row sm:items-center sm:justify-between"><p>© 2026 <!-- -->Morrow Golf Park<!-- -->. All rights reserved.</p><p class="font-mono uppercase tracking-[0.2em]">38°11′ N · 8°47′ W</p><button class="inline-flex items-center gap-2 self-start uppercase tracking-[0.18em] text-bone/70 transition-colors hover:text-bone sm:self-auto" type="button">Back to top<svg aria-hidden="true" class="lucide lucide-arrow-up size-4" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="relative select-none px-2 pt-6 sm:px-4"><svg aria-hidden="true" class="block w-full overflow-visible" viewbox="0 0 1000 300"><defs><lineargradient id="footer-mark-fill" x1="0" x2="1" y1="0" y2="1"><stop offset="0%" stop-color="var(--color-bone, #f2eee6)"></stop><stop offset="55%" stop-color="var(--color-ochre, #c9a26b)"></stop><stop offset="100%" stop-color="var(--color-clay, #a5683f)"></stop></lineargradient><radialgradient id="footer-mark-light"><stop offset="0%" stop-color="#fff"></stop><stop offset="70%" stop-color="#fff"></stop><stop offset="100%" stop-color="#fff" stop-opacity="0"></stop></radialgradient><mask height="300" id="footer-mark-mask" maskunits="userSpaceOnUse" width="1000" x="0" y="0"><circle cx="900" cy="70" data-mark-light="true" fill="url(#footer-mark-light)" r="0"></circle></mask></defs><g class="text-bone/[0.09]" fill="none" stroke="currentColor" stroke-width="1"><ellipse cx="900" cy="70" data-mark-contour="true" pathlength="1" rx="38" ry="15" stroke-dasharray="1 1" transform="rotate(-6 900 70)"></ellipse><ellipse cx="900" cy="70" data-mark-contour="true" pathlength="1" rx="84" ry="30" stroke-dasharray="1 1" transform="rotate(-6 900 70)"></ellipse><ellipse cx="900" cy="70" data-mark-contour="true" pathlength="1" rx="138" ry="45" strok