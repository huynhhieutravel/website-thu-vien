---
// v2/src/components/fathom/FlythroughCanvas.astro - Fathom 3D Suspended Cards Stage (Astro Native)
---

<section class="relative h-dvh w-full overflow-hidden" style="background-color:#000000;transition:background-color 0.5s;touch-action:none">
  <div class="absolute inset-0 overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background:transparent"></div>
    <div class="absolute inset-0" style="perspective:1080px;perspective-origin:50% 50%">
      <div class="absolute inset-0" style="transform-style:preserve-3d;transform-origin:50% 50%">
        <div class="absolute inset-0" style="transform-style:preserve-3d"></div>
      </div>
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background:transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center" style="z-index:30;color:rgba(255,255,255,0.92);opacity:0;transition:opacity 2.6s ease-out, color 0.6s ease;font-family:var(--font-cyrene), var(--font-instrument-serif), sans-serif;font-weight:400;text-transform:uppercase;letter-spacing:0.04em;line-height:0.98;text-align:center;white-space:nowrap;will-change:opacity, color">
      <span style="font-size:clamp(1.55rem, 5.6vw, 5.6rem)">
        Stories
      </span>
      <span style="font-size:clamp(1.55rem, 5.6vw, 5.6rem)">
        In Motion
      </span>
    </div>
    <style>
      @keyframes fathomDetailFade { from { opacity: 0 } to { opacity: 1 } }
      @keyframes fathomDetailGrow { from { opacity: 0; transform: scale(0.8) } to { opacity: 1; transform: scale(1) } }
      @keyframes fathomDetailText { from { opacity: 0; transform: translateY(10px) } to { opacity: 1; transform: translateY(0) } }
      @media (max-width: 760px) {
        .fathom-detail { flex-direction: column !important; flex-wrap: nowrap !important; }
        .fathom-detail img { max-width: 88vw !important; max-height: 46vh !important; }
        .fathom-detail-panel { max-width: 88vw !important; }
      }
    </style>
  </div>
</section>

