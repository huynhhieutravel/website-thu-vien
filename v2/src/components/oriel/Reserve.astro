e="United States">United States</option><option class="text-foreground" value="United Kingdom">United Kingdom</option><option class="text-foreground" value="Canada">Canada</option><option class="text-foreground" value="European Union">European Union</option><option class="text-foreground" value="Australia">Australia</option><option class="text-foreground" value="Somewhere else">Somewhere else</option></select><svg aria-hidden="true" class="lucide lucide-chevron-down pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m6 9 6 6 6-6"></path></svg></div></div><div class="flex flex-col gap-2"><label class="text-sm font-medium" for="household">Who lives with you <span class="font-normal text-muted-foreground">(optional)</span></label><div class="relative"><select aria-invalid="false" class="h-12 w-full rounded-xl border border-input bg-background px-4 text-[15px] transition-colors placeholder:text-muted-foreground/70 hover:border-foreground/30 focus:border-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 aria-[invalid=true]:border-destructive appearance-none pr-10 text-muted-foreground" id="household" name="household"><option selected="" value="">Prefer not to say</option><option class="text-foreground" value="Just me">Just me</option><option class="text-foreground" value="Two adults">Two adults</option><option class="text-foreground" value="Family with children">Family with children</option><option class="text-foreground" value="Living with an older relative">Living with an older relative</option></select><svg aria-hidden="true" class="lucide lucide-chevron-down pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m6 9 6 6 6-6"></path></svg></div></div></div><fieldset class="flex flex-col gap-2"><legend class="mb-2 text-sm font-medium">Your home</legend><div class="grid gap-2 sm:grid-cols-3"><label class="flex h-12 cursor-pointer items-center justify-center rounded-xl border px-3 text-center text-sm transition-colors has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ring/40 border-input bg-background text-foreground hover:border-foreground/30"><input class="sr-only" name="homeType" type="radio" value="Apartment"/>Apartment</label><label class="flex h-12 cursor-pointer items-center justify-center rounded-xl border px-3 text-center text-sm transition-colors has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ring/40 border-input bg-background text-foreground hover:border-foreground/30"><input class="sr-only" name="homeType" type="radio" value="Single-level house"/>Single-level house</label><label class="flex h-12 cursor-pointer items-center justify-center rounded-xl border px-3 text-center text-sm transition-colors has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ring/40 border-input bg-background text-foreground hover:border-foreground/30"><input class="sr-only" name="homeType" type="radio" value="House with stairs"/>House with stairs</label></div></fieldset><div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden"><label for="company">Company</label><input autocomplete="off" id="company" name="company" tabindex="-1" type="text" value=""/></div><button class="group mt-1 inline-flex h-13 items-center justify-center gap-2 rounded-full bg-foreground px-6 text-[15px] font-medium text-background transition-colors hover:bg-ember-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-wait disabled:opacity-70" type="submit">Reserve Oriel<svg aria-hidden="true" class="lucide lucide-arrow-right size-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button><p class="text-center text-xs leading-relaxed text-muted-foreground">We only use your details to arrange your reservation. No marketing lists.</p></form></div></div></div></section>