---
// Footer.astro
---

<footer class="relative z-10 border-t border-champagne/15 bg-obsidian px-5 pb-28 pt-12 text-ivory md:px-[6vw] md:pb-12">
  <div class="flex flex-col gap-10 md:flex-row md:items-center md:justify-between">
    <a href="#hero" class="pl-[0.32em] font-heading text-[1.8rem] font-medium leading-none tracking-[0.32em] text-champagne">
      AERIVE
    </a>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-8 gap-y-3">
      <a href="#about" class="text-[11px] uppercase tracking-[0.24em] text-ivory/70 transition-colors hover:text-champagne focus-visible:text-champagne focus-visible:outline-none">Giới thiệu</a>
      <a href="#fleet" class="text-[11px] uppercase tracking-[0.24em] text-ivory/70 transition-colors hover:text-champagne focus-visible:text-champagne focus-visible:outline-none">Hạm đội</a>
      <a href="#gallery" class="text-[11px] uppercase tracking-[0.24em] text-champagne font-medium transition-colors hover:text-champagne-soft focus-visible:text-champagne focus-visible:outline-none">Thư viện ảnh SEO</a>
      <a href="#advantages" class="text-[11px] uppercase tracking-[0.24em] text-ivory/70 transition-colors hover:text-champagne focus-visible:text-champagne focus-visible:outline-none">Đặc quyền</a>
      <a href="#global" class="text-[11px] uppercase tracking-[0.24em] text-ivory/70 transition-colors hover:text-champagne focus-visible:text-champagne focus-visible:outline-none">Toàn cầu</a>
    </nav>
    <button type="button" class="inline-flex items-center gap-3 self-start text-[11px] uppercase tracking-[0.24em] text-ivory/70 transition-colors hover:text-champagne md:self-auto">
      Trở lại ô cửa sổ
      <span class="flex size-9 items-center justify-center rounded-full border border-champagne/30 text-champagne">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up size-4"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg>
      </span>
    </button>
  </div>
  <div class="mt-12 flex flex-col gap-3 border-t border-champagne/10 pt-6 text-[10px] uppercase tracking-[0.22em] text-smoke md:flex-row md:justify-between">
    <p>© 2026 AERIVE. All rights reserved.</p>
    <p>Hàng không tư nhân cao cấp, thiết kế cho riêng bạn</p>
  </div>
</footer>

<!-- Floating Mobile Book Button -->
<div class="fixed inset-x-0 bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-40 flex justify-center transition-all duration-700 md:hidden pointer-events-none translate-y-6 opacity-0">
  <button type="button" class="inline-flex h-12 items-center gap-3 rounded-full bg-champagne pl-6 pr-2 text-[11px] uppercase tracking-[0.22em] text-obsidian shadow-[0_18px_40px_rgba(0,0,0,0.35)]">
    Đặt chuyến bay
    <span class="flex size-8 items-center justify-center rounded-full bg-obsidian text-champagne">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane size-4"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"></path></svg>
    </span>
  </button>
</div>
