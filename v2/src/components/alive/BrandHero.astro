---
// v2/src/components/alive/BrandHero.astro
---

<section class="relative w-full overflow-hidden" style="height:100dvh;touch-action:none;background-color:#F5EBE1;color:#18140E;transition:background-color 0.5s, color 0.5s">
  <div class="absolute inset-0">
    <div class="absolute inset-0 z-10 flex flex-col items-center justify-center px-4 text-center sm:px-6" style="pointer-events:none;font-family:var(--font-instrument-serif)">
      <h2 style="margin:0;line-height:0.95;letter-spacing:-0.02em">
        <span class="sr-only">We create brands that feel alive.</span>
        <span aria-hidden="true">
          <span style="display:block;white-space:nowrap;font-family:var(--font-instrument-serif);font-weight:400;font-size:clamp(2rem, 14vw, 8rem)">
            WE CREATE
          </span>
          <span style="display:block;white-space:nowrap;font-family:var(--font-instrument-serif);font-weight:400;font-size:clamp(2rem, 14vw, 8rem)">
            BRANDS <br class="xl:hidden" />THAT FEEL
          </span>
          <span style="position:relative;display:inline-block;white-space:nowrap;font-family:var(--font-bricolage);font-weight:800;font-size:clamp(2.5rem, 14vw, 10rem);letter-spacing:-0.02em">
            ALIVE
            <span data-icon="true" style="position:absolute;top:-0.08em;left:-0.02em;width:0.42em;height:0.42em">
              <img src="/sections/alive/flower-green.png" alt="" style="width:100%;height:100%;display:block" />
            </span>
            <span data-icon="true" style="position:absolute;bottom:-0.16em;right:0.05em;width:0.42em;height:0.42em">
              <img src="/sections/alive/flower-blush.png" alt="" style="width:100%;height:100%;display:block" />
            </span>
          </span>
        </span>
      </h2>
    </div>
    <div aria-hidden="true" class="absolute inset-0 z-20"></div>
  </div>
</section>

