---
// Inquiries.astro
---

<section id="inquiries" aria-labelledby="inquiries-title" class="relative z-10 bg-obsidian px-5 pb-28 pt-20 text-ivory md:px-[6vw] md:pb-40 md:pt-28">
  <div data-reveal="true" class="flex items-center justify-between border-t border-champagne/20 pt-5">
    <p class="text-[11px] uppercase tracking-[0.25em] text-champagne">Yêu cầu thông tin</p>
    <p class="text-[11px] uppercase tracking-[0.25em] text-smoke">Phản hồi riêng biệt</p>
  </div>

  <div class="mt-14 grid gap-12 md:mt-20 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-end lg:gap-20">
    <h2 id="inquiries-title" data-reveal="true" class="font-heading text-[clamp(3rem,7.2vw,7.8rem)] font-light leading-[0.9] tracking-[-0.015em]">
      Hãy nói điểm đến.<br />
      <span class="text-champagne">Chúng tôi chu toàn phần còn lại.</span>
    </h2>

    <div data-reveal="true">
      <p class="max-w-md text-[15px] leading-relaxed text-ivory/70">
        Chia sẻ hành trình và ngày dự kiến của bạn. Chuyên viên quản gia chuyến bay AERIVE sẽ liên hệ trực tiếp với các phương án máy bay được cá nhân hóa hoàn hảo.
      </p>
      <span class="inline-flex mt-9">
        <button type="button" class="inline-flex h-14 items-center gap-3 rounded-full bg-champagne px-8 text-[12px] uppercase tracking-[0.22em] text-obsidian transition-colors hover:bg-champagne-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-champagne">
          Đặt chuyến bay
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right size-4"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
        </button>
      </span>
    </div>
  </div>
</section>
