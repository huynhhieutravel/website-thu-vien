<section id="statement" aria-labelledby="statement-title" class="bg-white py-24 sm:py-36"><div class="mx-auto max-w-[1440px] px-5 sm:px-8"><p data-reveal="fade" class="eyebrow flex items-center gap-3 text-ink/55"><span class="text-signal-deep">01</span><span class="h-px w-8 bg-ink/25" aria-hidden="true"></span>Screenless by design</p><h2 id="statement-title" data-split="true" class="mt-8 max-w-[15ch] font-display text-[clamp(2.6rem,7vw,7rem)] uppercase leading-[0.9] text-ink"><span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">No</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">screen.</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">No</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">noise.</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">Only</span></span> <span class="inline-block overflow-hidden pb-[0.1em] -mb-[0.1em] align-top"><span data-word="true" class="inline-block">signal.</span></span></h2><div class="mt-12 grid gap-10 lg:grid-cols-12"><p data-reveal="true" class="text-xl leading-relaxed text-ink/70 text-pretty lg:col-span-6 lg:col-start-7 sm:text-2xl">PACE Band reads your heart up to 256 times a second, follows every stage of sleep and turns it all into one clear answer each morning: how ready you are to perform.</p></div><dl data-stagger="true" class="mt-14 grid grid-cols-2 sm:mt-20 gap-px overflow-hidden rounded-[28px] border border-line bg-line lg:grid-cols-4"><div class="min-w-0 bg-white p-5 sm:p-8"><dt class="sr-only">Total weight, core and strap</dt><dd><span class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1 sm:gap-2"><span data-count="24" data-decimals="0" class="font-display text-[2.5rem] leading-none tabular-nums text-ink sm:text-[clamp(3rem,6vw,5.5rem)]">24</span><span class="text-base font-semibold text-ink/50 sm:text-lg">g</span></span><span class="mt-3 block text-[13px] text-ink/60 sm:mt-4 sm:text-[15px]">Total weight, core and strap</span></dd></div><div class="min-w-0 bg-white p-5 sm:p-8"><dt class="sr-only">Typical battery life</dt><dd><span class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1 sm:gap-2"><span data-count="10" data-decimals="0" class="font-display text-[2.5rem] leading-none tabular-nums text-ink sm:text-[clamp(3rem,6vw,5.5rem)]">10</span><span class="text-base font-semibold text-ink/50 sm:text-lg">days</span></span><span class="mt-3 block text-[13px] text-ink/60 sm:mt-4 sm:text-[15px]">Typical battery life</span></dd></div><div class="min-w-0 bg-white p-5 sm:p-8"><dt class="sr-only">Optical, thermal, motion, pressure and GNSS</dt><dd><span class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1 sm:gap-2"><span data-count="9" data-decimals="0" class="font-display text-[2.5rem] leading-none tabular-nums text-ink sm:text-[clamp(3rem,6vw,5.5rem)]">9</span><span class="text-base font-semibold text-ink/50 sm:text-lg">sensors</span></span><span class="mt-3 block text-[13px] text-ink/60 sm:mt-4 sm:text-[15px]">Optical, thermal, motion, pressure and GNSS</span></dd></div><div class="min-w-0 bg-white p-5 sm:p-8"><dt class="sr-only">Water resistance, 10 ATM</dt><dd><span class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1 sm:gap-2"><span data-count="100" data-decimals="0" class="font-display text-[2.5rem] leading-none tabular-nums text-ink sm:text-[clamp(3rem,6vw,5.5rem)]">100</span><span class="text-base font-semibold text-ink/50 sm:text-lg">m</span></span><span class="mt-3 block text-[13px] text-ink/60 sm:mt-4 sm:text-[15px]">Water resistance, 10 ATM</span></dd></div></dl></div></section>
