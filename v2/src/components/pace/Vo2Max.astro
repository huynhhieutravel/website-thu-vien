---
// v2/src/components/pace/Vo2Max.astro
---

<section id="vo2-max" class="py-24 sm:py-36 bg-[#f6f7f9] border-b border-[#e2e5eb]">
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left Column: Copy -->
      <div class="lg:col-span-6">
        <span class="eyebrow block mb-3 text-[#ff5a1f]">Cardiovascular Health & Longevity</span>
        <h2 class="font-display text-4xl sm:text-6xl text-[#0c0e12] leading-[0.94] mb-6">
          Your engine, measured.
        </h2>
        <p class="text-base sm:text-lg text-[#5e6777] leading-relaxed mb-8">
          Cardiorespiratory fitness (VO2 Max) is the single strongest predictor of biological longevity and endurance capacity. PACE computes your real-world VO2 Max from sub-maximal training trends and post-exercise heart rate recovery curves — no lab mask needed.
        </p>

        <div class="grid grid-cols-2 gap-6 pt-4 border-t border-[#e2e5eb]">
          <div>
            <span class="text-xs uppercase font-bold tracking-wider text-[#5e6777] block mb-1">Heart Rate Drop (Min 1)</span>
            <span class="font-display text-3xl font-black text-[#0c0e12]">44 BPM</span>
            <p class="text-xs text-[#00d984] font-semibold mt-1">Excellent vagal reactivation</p>
          </div>
          <div>
            <span class="text-xs uppercase font-bold tracking-wider text-[#5e6777] block mb-1">Aerobic Threshold</span>
            <span class="font-display text-3xl font-black text-[#0c0e12]">154 BPM</span>
            <p class="text-xs text-[#5e6777] mt-1">Zone 2 endurance ceiling</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Telemetry Gauge -->
      <div class="lg:col-span-6">
        <div class="bg-white rounded-3xl p-8 sm:p-12 border border-[#e2e5eb] shadow-xl">
          <div class="flex items-center justify-between mb-8">
            <span class="text-xs uppercase font-bold tracking-widest text-[#5e6777]">Estimated VO2 Max</span>
            <span class="rounded-full bg-[#00d984]/15 border border-[#00d984]/30 px-3 py-1 text-xs font-bold text-[#00a863]">TOP 5% FOR AGE</span>
          </div>

          <div class="flex items-baseline gap-3 mb-6">
            <span class="font-display text-6xl sm:text-7xl font-black text-[#0c0e12]">58.4</span>
            <span class="text-sm font-bold uppercase tracking-wider text-[#5e6777]">ml / kg / min</span>
          </div>

          <!-- Color Progress Bar -->
          <div class="relative w-full h-3 rounded-full bg-[#eceef2] overflow-hidden mb-6">
            <div class="absolute inset-y-0 left-0 bg-gradient-to-r from-[#00c4df] via-[#00d984] to-[#ff5a1f] rounded-full" style="width: 86%;"></div>
          </div>

          <!-- Scale labels -->
          <div class="flex justify-between text-[11px] font-bold uppercase tracking-wider text-[#5e6777]/80">
            <span>Fair (35)</span>
            <span>Good (45)</span>
            <span>Great (52)</span>
            <span class="text-[#0c0e12] font-black">Elite (58+)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
