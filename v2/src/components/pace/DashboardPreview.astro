---
// v2/src/components/pace/DashboardPreview.astro
---

<section id="dashboard-preview" class="py-24 sm:py-36 bg-[#090b0e] text-white relative overflow-hidden">
  <!-- Subtle Ambient Glow -->
  <div class="pointer-events-none absolute -left-40 top-1/4 h-[500px] w-[500px] rounded-full bg-[#00d984]/10 blur-[140px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-40 bottom-1/4 h-[500px] w-[500px] rounded-full bg-[#ff5a1f]/10 blur-[140px]" aria-hidden="true"></div>

  <div class="mx-auto max-w-[1440px] px-5 sm:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
      <span class="eyebrow block mb-3 text-[#00d984]">Companion App Experience</span>
      <h2 class="font-display text-4xl sm:text-6xl text-white leading-[0.92]">
        Your data, decoded.
      </h2>
      <p class="mt-6 text-base sm:text-xl text-[#8e98a8] leading-relaxed">
        No proprietary mumbo-jumbo or obscure scores. Direct physiological metrics and clear trends to guide every training day.
      </p>
    </div>

    <!-- Live Telemetry Card Interface -->
    <div class="rounded-[32px] border border-white/10 bg-[#12151b]/90 backdrop-blur-xl p-6 sm:p-12 shadow-2xl">
      <!-- Top Metric Bar -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 pb-10 border-b border-white/10">
        <!-- Metric 1: Recovery -->
        <div class="metric-box bg-white/[0.03] border border-white/5 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase font-bold tracking-wider text-[#8e98a8]">Recovery</span>
            <span class="size-2.5 rounded-full bg-[#00d984] shadow-[0_0_8px_#00d984]"></span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-4xl sm:text-5xl font-black text-white">87%</span>
            <span class="text-xs text-[#00d984] font-bold">Optimal</span>
          </div>
          <p class="text-xs text-[#8e98a8] mt-2">+12% vs 14-day average</p>
        </div>

        <!-- Metric 2: Strain -->
        <div class="metric-box bg-white/[0.03] border border-white/5 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase font-bold tracking-wider text-[#8e98a8]">Day Strain</span>
            <span class="size-2.5 rounded-full bg-[#ff5a1f] shadow-[0_0_8px_#ff5a1f]"></span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-4xl sm:text-5xl font-black text-white">14.8</span>
            <span class="text-xs text-[#8e98a8]">/ 21.0</span>
          </div>
          <p class="text-xs text-[#ff5a1f] mt-2">Target reached: 1,420 kcal</p>
        </div>

        <!-- Metric 3: Sleep -->
        <div class="metric-box bg-white/[0.03] border border-white/5 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase font-bold tracking-wider text-[#8e98a8]">Sleep Duration</span>
            <span class="size-2.5 rounded-full bg-[#00c4df] shadow-[0_0_8px_#00c4df]"></span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-4xl sm:text-5xl font-black text-white">8h 14m</span>
          </div>
          <p class="text-xs text-[#00c4df] mt-2">94% Sleep consistency</p>
        </div>

        <!-- Metric 4: HRV -->
        <div class="metric-box bg-white/[0.03] border border-white/5 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase font-bold tracking-wider text-[#8e98a8]">Resting HRV</span>
            <span class="size-2.5 rounded-full bg-white/40"></span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-4xl sm:text-5xl font-black text-white">78</span>
            <span class="text-xs text-[#8e98a8]">ms</span>
          </div>
          <p class="text-xs text-[#00d984] mt-2">+8 ms higher baseline</p>
        </div>
      </div>

      <!-- Main Visualized Biometric Waveform Chart -->
      <div class="pt-10">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div>
            <h3 class="font-display text-xl sm:text-2xl text-white">Cardiovascular Telemetry</h3>
            <p class="text-sm text-[#8e98a8]">Real-time 24-hour optical pulse wave photoplethysmography (PPG)</p>
          </div>

          <!-- Time tabs -->
          <div class="inline-flex rounded-full bg-white/10 p-1 text-xs font-bold uppercase">
            <button type="button" class="px-4 py-1.5 rounded-full bg-white text-black shadow-sm">24 Hours</button>
            <button type="button" class="px-4 py-1.5 rounded-full text-white/70 hover:text-white">7 Days</button>
            <button type="button" class="px-4 py-1.5 rounded-full text-white/70 hover:text-white">30 Days</button>
          </div>
        </div>

        <!-- Waveform Graph Area -->
        <div class="relative w-full h-[220px] sm:h-[280px] bg-white/[0.02] border border-white/5 rounded-2xl p-4 overflow-hidden">
          <svg viewBox="0 0 1000 240" class="w-full h-full preserve-3d" preserveAspectRatio="none">
            <!-- Grid Lines -->
            <line x1="0" y1="60" x2="1000" y2="60" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4" />
            <line x1="0" y1="120" x2="1000" y2="120" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4" />
            <line x1="0" y1="180" x2="1000" y2="180" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4" />

            <!-- Gradient Area -->
            <defs>
              <linearGradient id="curveGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#00d984" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#00d984" stop-opacity="0.0" />
              </linearGradient>
            </defs>

            <!-- Fill Path -->
            <path
              d="M0,180 C80,180 140,165 200,160 C260,155 300,190 360,185 C420,180 460,80 500,75 C540,70 580,160 620,140 C660,120 720,195 780,190 C840,185 920,150 1000,165 L1000,240 L0,240 Z"
              fill="url(#curveGradient)"
            />

            <!-- Stroke Path -->
            <path
              d="M0,180 C80,180 140,165 200,160 C260,155 300,190 360,185 C420,180 460,80 500,75 C540,70 580,160 620,140 C660,120 720,195 780,190 C840,185 920,150 1000,165"
              fill="none"
              stroke="#00d984"
              stroke-width="3.5"
              stroke-linecap="round"
            />

            <!-- Workout Peak Point -->
            <circle cx="500" cy="75" r="7" fill="#ff5a1f" stroke="#ffffff" stroke-width="2.5" />
            <text x="500" y="55" fill="#ffffff" font-size="12" font-weight="bold" text-anchor="middle">178 BPM · Max Effort</text>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
