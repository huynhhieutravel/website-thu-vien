---
// v2/src/components/pace/Engineering.astro
---

<section id="engineering" class="py-24 sm:py-36 bg-white">
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8">
    <div class="max-w-3xl mb-16 sm:mb-20">
      <span class="eyebrow block mb-3 text-[#ff5a1f]">Materials & Precision</span>
      <h2 class="font-display text-4xl sm:text-6xl text-[#0c0e12] leading-[0.94] mb-6">
        Engineered to disappear.
      </h2>
      <p class="text-base sm:text-lg text-[#5e6777] leading-relaxed">
        Every curve, gram, and seam was tested across hundreds of prototypes until the band felt like nothing more than a smooth extension of your forearm.
      </p>
    </div>

    <!-- 4 Macro Cards (2x2 Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
      <!-- Card 1: Sensors -->
      <div class="macro-card group overflow-hidden rounded-3xl bg-[#f6f7f9] border border-[#e2e5eb] flex flex-col">
        <div class="aspect-[16/11] overflow-hidden">
          <img
            src="/images/pace/macro-sensors.jpg"
            alt="5-wavelength optical biosensor array"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        </div>
        <div class="p-8 sm:p-10 flex flex-col flex-grow">
          <span class="eyebrow text-[#0c0e12] mb-2 font-black">Sensors</span>
          <h3 class="font-display text-2xl text-[#0c0e12] mb-3">5-Wavelength Optical Array</h3>
          <p class="text-[#5e6777] leading-relaxed text-sm sm:text-base">
            Custom-calibrated green, red, and infrared LEDs paired with high-sensitivity silicon photodiodes, sampling blood volume pulses at 100 Hz.
          </p>
        </div>
      </div>

      <!-- Card 2: Titanium Core -->
      <div class="macro-card group overflow-hidden rounded-3xl bg-[#f6f7f9] border border-[#e2e5eb] flex flex-col">
        <div class="aspect-[16/11] overflow-hidden">
          <img
            src="/images/pace/macro-core.jpg"
            alt="Grade 5 titanium alloy chassis"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        </div>
        <div class="p-8 sm:p-10 flex flex-col flex-grow">
          <span class="eyebrow text-[#0c0e12] mb-2 font-black">Chassis</span>
          <h3 class="font-display text-2xl text-[#0c0e12] mb-3">Grade 5 Titanium Unibody</h3>
          <p class="text-[#5e6777] leading-relaxed text-sm sm:text-base">
            Precision CNC-milled from aerospace Ti-6Al-4V alloy. Bead-blasted surface with anti-fingerprint ceramic coating, immune to sweat and saltwater corrosion.
          </p>
        </div>
      </div>

      <!-- Card 3: Woven Band -->
      <div class="macro-card group overflow-hidden rounded-3xl bg-[#f6f7f9] border border-[#e2e5eb] flex flex-col">
        <div class="aspect-[16/11] overflow-hidden">
          <img
            src="/images/pace/macro-weave.jpg"
            alt="Seamless performance woven strap"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        </div>
        <div class="p-8 sm:p-10 flex flex-col flex-grow">
          <span class="eyebrow text-[#0c0e12] mb-2 font-black">Strap</span>
          <h3 class="font-display text-2xl text-[#0c0e12] mb-3">Breathable Polyamide Weave</h3>
          <p class="text-[#5e6777] leading-relaxed text-sm sm:text-base">
            Double-density jacquard weave that maintains consistent skin contact for accurate PPG readings while drying completely in less than 20 minutes post-swim.
          </p>
        </div>
      </div>

      <!-- Card 4: Clasp -->
      <div class="macro-card group overflow-hidden rounded-3xl bg-[#f6f7f9] border border-[#e2e5eb] flex flex-col">
        <div class="aspect-[16/11] overflow-hidden">
          <img
            src="/images/pace/macro-clasp.jpg"
            alt="Titanium magnetic micro-clasp"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        </div>
        <div class="p-8 sm:p-10 flex flex-col flex-grow">
          <span class="eyebrow text-[#0c0e12] mb-2 font-black">Fastening</span>
          <h3 class="font-display text-2xl text-[#0c0e12] mb-3">Micro-Adjustable Latch</h3>
          <p class="text-[#5e6777] leading-relaxed text-sm sm:text-base">
            Zero-pin friction clasp with micro-increments down to 1mm so you get the exact right tension for high-motion sprint intervals or comfortable overnight sleep.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
