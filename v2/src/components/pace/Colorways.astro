---
// v2/src/components/pace/Colorways.astro
---

<section id="colorways" class="py-24 sm:py-36 bg-[#f6f7f9] border-y border-[#e2e5eb]">
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <span class="eyebrow block mb-3 text-[#ff5a1f]">Edition & Finishes</span>
      <h2 class="font-display text-4xl sm:text-6xl text-[#0c0e12] leading-[0.92]">
        Pick your signal.
      </h2>
      <p class="mt-6 text-base sm:text-lg text-[#5e6777] leading-relaxed">
        Three timeless colorways engineered with identical Grade 5 titanium chassis and interchangeable strap architecture.
      </p>
    </div>

    <!-- Main Colorways Trio Image -->
    <div class="rounded-3xl overflow-hidden bg-white border border-[#e2e5eb] shadow-xl mb-12">
      <div class="aspect-[16/9] w-full overflow-hidden">
        <img
          src="/images/pace/colorways.jpg"
          alt="PACE Band 3 Colorways: Signal Orange, Stealth Black, Chalk White"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>

    <!-- 3 Finishes Details -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-8 rounded-2xl border border-[#e2e5eb]">
        <div class="size-4 rounded-full bg-[#ff5a1f] mb-4 shadow-[0_0_8px_#ff5a1f]"></div>
        <h3 class="font-display text-xl text-[#0c0e12] mb-2">Signal Orange</h3>
        <p class="text-sm text-[#5e6777] leading-relaxed">
          High-visibility rescue orange piping along dark grey performance weave. Our signature edition.
        </p>
      </div>

      <div class="bg-white p-8 rounded-2xl border border-[#e2e5eb]">
        <div class="size-4 rounded-full bg-[#181a1f] mb-4"></div>
        <h3 class="font-display text-xl text-[#0c0e12] mb-2">Stealth Black</h3>
        <p class="text-sm text-[#5e6777] leading-relaxed">
          Deep charcoal weave with diamond-like carbon (DLC) coated titanium clasp. Pure minimalism.
        </p>
      </div>

      <div class="bg-white p-8 rounded-2xl border border-[#e2e5eb]">
        <div class="size-4 rounded-full bg-[#e3e6eb] mb-4 border border-black/10"></div>
        <h3 class="font-display text-xl text-[#0c0e12] mb-2">Chalk White</h3>
        <p class="text-sm text-[#5e6777] leading-relaxed">
          Unbleached light-grey technical yarn paired with raw bead-blasted silver titanium.
        </p>
      </div>
    </div>
  </div>
</section>
