---
// v2/src/components/pace/Header.astro
---

<header id="pace-header" class="fixed inset-x-0 top-[42px] z-50 transition-all duration-300">
  <div class="header-inner mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-6 px-5 sm:px-8">
    <!-- Brand Logo -->
    <a href="/pace" aria-label="PACE home" class="logo-link flex items-center gap-2.5 text-ink no-underline">
      <svg width="28" height="19" viewBox="0 0 32 22" fill="none" class="h-4 w-auto shrink-0" style="width: 28px; height: 19px; min-width: 28px; display: inline-block; stroke: #0c0e12;" aria-hidden="true">
        <ellipse cx="16" cy="12.4" rx="13.6" ry="8.4" stroke="currentColor" stroke-width="2.6"></ellipse>
        <circle cx="16" cy="4.2" r="3" fill="#ff5a1f"></circle>
      </svg>
      <span class="font-display text-xl font-extrabold tracking-tight">PACE</span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="#statement" class="nav-link">The Band</a>
      <a href="#pillars" class="nav-link">Health & Recovery</a>
      <a href="#dashboard-preview" class="nav-link">Performance</a>
      <a href="#engineering" class="nav-link">Technology</a>
      <a href="#faq" class="nav-link">FAQ</a>
    </nav>

    <!-- Reserve CTA Button -->
    <div class="flex items-center gap-3">
      <a href="#reserve-cta" class="reserve-btn inline-flex items-center gap-2 rounded-full px-5 py-2 text-xs font-bold uppercase tracking-wider transition-all">
        <span>Reserve</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="translate-y-[-1px]">
          <path d="M7 17L17 7"></path>
          <path d="M7 7h10v10"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  #pace-header {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .nav-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--pace-ink-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-link:hover {
    color: var(--pace-ink);
  }

  .reserve-btn {
    background: var(--pace-ink);
    color: #ffffff;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(12, 14, 18, 0.15);
  }
  .reserve-btn:hover {
    background: var(--pace-ink-soft);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(12, 14, 18, 0.22);
  }
</style>
