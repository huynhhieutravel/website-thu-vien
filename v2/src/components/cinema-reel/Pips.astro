---
// v2/src/components/cinema-reel/Pips.astro
interface Props {
  total: number;
}
const { total = 6 } = Astro.props;
---

<div
  id="cinema-pips"
  class="absolute right-[3.5dvh] z-40 flex flex-col items-end gap-3 transition-opacity duration-[400ms] ease-out pointer-events-none select-none"
  style="top:50%;transform:translateY(-50%);"
  aria-hidden="false"
>
  <!-- Active Film Number -->
  <div id="pips-active-num" class="font-serif-cinema text-[12px] italic text-white/55">
    01
  </div>

  <!-- Vertical Pips -->
  <div data-no-drag="true" class="pointer-events-auto flex flex-col items-center">
    {Array.from({ length: total }).map((_, idx) => (
      <button
        type="button"
        data-pip-index={idx}
        aria-label={`Go to slide ${idx + 1}`}
        class="flex h-5 w-5 items-center justify-center cursor-pointer transition-transform duration-200 hover:scale-125"
      >
        <span
          class="pip-dot rounded-full transition-all duration-300 ease-out"
          style={idx === 0 ? "width:6px;height:6px;background:rgba(241,231,210,0.95);" : "width:4px;height:4px;background:rgba(255,255,255,0.22);"}
        ></span>
      </button>
    ))}
  </div>

  <!-- Total Films -->
  <div id="pips-total-num" class="font-serif-cinema text-[12px] italic text-white/35">
    {String(total).padStart(2, '0')}
  </div>
</div>
