---
// v2/src/components/cinema-reel/Cursor.astro
---

<div
  id="cinema-cursor"
  class="pointer-events-none fixed left-0 top-0 z-50 select-none"
  style="width: 104px; height: 104px; opacity: 0; will-change: transform, opacity;"
  aria-hidden="true"
>
  <div class="relative h-full w-full">
    <!-- Circular Outline -->
    <div class="absolute inset-0 rounded-full border border-white/45"></div>

    <!-- Default SCROLL text -->
    <div
      id="cursor-scroll-label"
      class="absolute inset-0 flex items-center justify-center transition-opacity duration-200 ease-out"
    >
      <span class="text-[10px] font-medium uppercase tracking-[0.32em] text-white">
        SCROLL
      </span>
    </div>

    <!-- Drag Hand Icon -->
    <div
      id="cursor-drag-icon"
      class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-150 ease-out"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 11V7.5a1.5 1.5 0 0 1 3 0V11"></path>
        <path d="M10 11V6.5a1.5 1.5 0 0 1 3 0V11"></path>
        <path d="M13 11V7a1.5 1.5 0 0 1 3 0v6"></path>
        <path d="M16 9.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6H9a6 6 0 0 1-6-6v-3a1.5 1.5 0 0 1 3 0v2"></path>
      </svg>
    </div>

    <!-- Top Navigation Smile Curve -->
    <div
      id="cursor-nav-top"
      class="absolute transition-opacity duration-150 ease-out opacity-0"
      style="bottom: calc(100% + 12px); left: 50%; transform: translateX(-50%);"
    >
      <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
        <path d="M2 12 C 7 4, 15 4, 20 12" stroke="white" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </div>

    <!-- Bottom Navigation Smile Curve -->
    <div
      id="cursor-nav-bottom"
      class="absolute transition-opacity duration-150 ease-out opacity-0"
      style="top: calc(100% + 12px); left: 50%; transform: translateX(-50%) rotate(180deg);"
    >
      <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
        <path d="M2 12 C 7 4, 15 4, 20 12" stroke="white" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </div>
  </div>
</div>

