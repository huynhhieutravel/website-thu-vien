    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
  }

  /* Bottom Strip */
  .footer-bottom-strip {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid #1f242d;
  }

  .bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
