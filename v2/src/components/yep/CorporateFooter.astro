    max-width: 100vw;
    box-sizing: border-box;
    background: #0a0a0a;
    color: #ffffff;
    padding-top: 64px;
    padding-bottom: 48px;
    border-top: 1px solid #1a1d24;
    position: relative;
    overflow: hidden;
    font-family: Manrope, Arial, sans-serif;
  }

  .footer-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: 24px;
    box-sizing: border-box;
    position: relative;
    z-index: 2;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 36px 28px;
  }

  /* Brand Column */
