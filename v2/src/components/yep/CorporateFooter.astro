    gap: 8px;
  }

  .footer-links li a {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
  }

  .footer-links li a:hover {
    color: #c5a365;
  }

  .footer-links li a.text-gold {
    color: #d7c29e;
  }

  .sub-group.mt-group {
