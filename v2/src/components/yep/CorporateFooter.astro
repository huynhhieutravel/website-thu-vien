    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .brand-title h2 {
    font-family: Cormorant, Georgia, serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin: 0;
    line-height: 1;
  }

  .reg-mark {
    font-size: 10px;
    color: #ffffff;
  }

  .brand-slogan {
