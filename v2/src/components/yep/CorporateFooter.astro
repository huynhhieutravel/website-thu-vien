  .bottom-brand {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer-logo {
    height: 30px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .sep-line {
    width: 1px;
    height: 20px;
    background: rgba(255, 255, 255, 0.2);
  }

  .company-subtag {
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.55);
  }

  .bottom-copy p {
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  /* Signature Script */
  .footer-signature {
    position: absolute;
    bottom: 24px;
    right: 24px;
    opacity: 0.12;
    pointer-events: none;
    z-index: 1;
  }

  .footer-signature p {
    font-family: Cormorant, Georgia, serif;
    font-style: italic;
