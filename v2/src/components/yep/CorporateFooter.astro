    color: #ffffff;
    margin: 0 0 16px;
    line-height: 1.4;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }

  .detail-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .detail-item a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.2s;
  }

  .detail-item a:hover {
    color: #c5a365;
  }

  .detail-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 2px;
  }

  .icon-gold {
    color: #c5a365;
  }

  .hotlines-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hotline-subheading {
    font-size: 11.5px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-item.highlight-b2b .link-b2b {
    color: #f3eee6;
  }

  .detail-item.highlight-b2b .link-b2b strong {
    color: #f59e0b;
