---
// CorporateHeader.astro - Header chuẩn Hành Trình Doanh Nghiệp FIT TOUR
export interface Props {
  activePath?: string;
}

const { activePath = '/hanh-trinh-doanh-nghiep' } = Astro.props;

const navItems = [
  { label: 'Tour Doanh Nghiệp', href: 'https://fittour.vn/tour-doanh-nghiep' },
  { label: 'Tour Công Ty', href: 'https://fittour.vn/tour-cong-ty' },
  { 
    label: 'Dịch Vụ', 
    href: 'https://fittour.vn/tour-incentive-travel-doanh-nghiep',
    hasDropdown: true 
  },
  { label: 'Địa Điểm', href: 'https://fittour.vn/dia-diem-to-chuc' },
  { label: 'Hành Trình Doanh Nghiệp', href: 'https://fittour.vn/hanh-trinh-doanh-nghiep', active: true },
  { label: 'Portfolio', href: 'https://fittour.vn/portfolio' },
];

const services = [
  { 
    title: 'Incentive Travel', 
    image: 'https://media.fittour.vn/uploads/2026/03/fit-tour-elite-operations-executive-program-briefing-bosch-nha-trang.webp', 
    href: 'https://fittour.vn/tour-incentive-travel-doanh-nghiep' 
  },
  { 
    title: 'Corporate Retreat', 
    image: 'https://media.fittour.vn/uploads/duoc-pham-nhat-nhat-team-building-15-nam-but-pha-cam-ranh.webp', 
    href: 'https://fittour.vn/corporate-retreat' 
  },
  { 
    title: 'Company Trip', 
    image: 'https://media.fittour.vn/uploads/team-building-hop-luc-vuon-xa-vuot-qua-thu-thach-cam-ranh.webp', 
    href: 'https://fittour.vn/company-trip' 
  },
  { 
    title: 'MICE & Events', 
    image: 'https://media.fittour.vn/uploads/gala-dinner-ky-niem-15-nam-duoc-pham-nhat-nhat.webp', 
    href: 'https://fittour.vn/to-chuc-su-kien-cong-ty-cho-doanh-nghiep' 
  }
];
---

<header class="fittour-corp-header" id="fittour-corp-header">
  <!-- Top Ticker Bar -->
  <div class="fittour-topbar">
    <div class="topbar-inner wrap-corp">
      <div class="topbar-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>6+ năm kinh nghiệm vận hành</span>
      </div>
      <div class="topbar-ticker-mask">
        <div class="topbar-ticker-track">
          <span class="ticker-item">Doanh nghiệp từng đồng hành: Samsung Việt Nam, BOSCH, VIB, ACB, MoMo, Vietcombank, Sacombank, MIRAE ASSET, VIETCAN...</span>
          <span class="ticker-item">Doanh nghiệp từng đồng hành: Samsung Việt Nam, BOSCH, VIB, ACB, MoMo, Vietcombank, Sacombank, MIRAE ASSET, VIETCAN...</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="fittour-navbar">
    <div class="navbar-inner wrap-corp">
      <!-- Logo FIT TOUR -->
      <a href="https://fittour.vn" class="navbar-logo" aria-label="FIT TOUR - Trang chủ">
        <img 
          src="https://media.fittour.vn/uploads/logo-fittour.webp" 
          alt="FIT TOUR" 
          width="155" 
          height="42" 
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="navbar-menu" aria-label="Điều hướng Hành trình Doanh nghiệp">
        {navItems.map(item => (
          item.hasDropdown ? (
            <div class="nav-item-dropdown">
              <a href={item.href} class={`navbar-link ${item.active ? 'is-active' : ''}`}>
                <span>{item.label}</span>
                <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
              </a>
              <div class="megamenu-panel" aria-label="Menu Dịch vụ Tour Doanh Nghiệp">
                <div class="megamenu-grid">
                  {services.map(svc => (
                    <a href={svc.href} class="service-card">
                      <div class="card-thumb">
                        <img src={svc.image} alt={svc.title} width="240" height="135" loading="lazy" />
                      </div>
                      <div class="card-info">
                        <h4>{svc.title}</h4>
                        <span class="card-cta">Xem chi tiết →</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a 
              href={item.href} 
              class={`navbar-link ${item.active ? 'is-active' : ''}`}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <!-- Action Group: Hotline & Button -->
      <div class="navbar-actions">
        <a href="https://fittour.vn" class="navbar-search-btn" aria-label="Tìm kiếm trên FIT TOUR" title="Tìm kiếm">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </a>

        <a href="tel:0932076186" class="navbar-hotline" aria-label="Gọi hotline tư vấn doanh nghiệp 0932 076 186">
          <span class="hotline-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </span>
          <span class="hotline-text">
            <small>Hotline B2B</small>
            <strong>0932 076 186</strong>
          </span>
        </a>

        <a href="#contact" class="navbar-cta-btn" data-open-contact>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          <span>Tư vấn ngay</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button type="button" class="navbar-mobile-toggle" id="corp-menu-toggle" aria-label="Mở menu di động" aria-expanded="false">
          <span class="toggle-bar"></span>
          <span class="toggle-bar"></span>
          <span class="toggle-bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="fittour-mobile-drawer" id="corp-drawer" hidden>
    <div class="drawer-inner">
      <nav class="drawer-nav">
        {navItems.map(item => (
          item.hasDropdown ? (
            <div class="drawer-group">
              <a href={item.href} class="drawer-link is-parent">{item.label}</a>
              <div class="drawer-sublinks">
                {services.map(svc => (
                  <a href={svc.href} class="drawer-sublink">› {svc.title}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} class={`drawer-link ${item.active ? 'is-active' : ''}`}>{item.label}</a>
          )
        ))}
      </nav>
      <div class="drawer-actions">
        <a href="tel:0932076186" class="drawer-call-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Hotline: 0932 076 186</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector('#corp-menu-toggle');
  const drawer = document.querySelector('#corp-drawer');
  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      drawer.hidden = isOpen;
    });
    drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      drawer.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    }));
  }
</script>

<style>
  /* Header chuẩn Hành Trình Doanh Nghiệp FIT TOUR */
  .fittour-corp-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 100vw;
    overflow-x: clip;
    z-index: 1000;
    background: #ffffff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
    border-bottom: 1px solid #e5e7eb;
    font-family: Manrope, Arial, sans-serif;
  }

  .wrap-corp {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 28px;
    box-sizing: border-box;
  }

  /* Topbar */
  .fittour-topbar {
    background: #fcf9f2;
    border-bottom: 1px solid #f0e9dc;
    padding-block: 7px;
    font-size: 13px;
    color: #4b5563;
    overflow: hidden;
    width: 100%;
    max-width: 100vw;
    box-sizing: border-box;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    overflow: hidden;
    width: 100%;
    min-width: 0;
  }

  .topbar-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    color: #374151;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .topbar-badge svg {
    color: #8c6721;
  }

  .topbar-ticker-mask {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(to right, transparent, black 2%, black 98%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 2%, black 98%, transparent);
  }

  .topbar-ticker-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    animation: corp-ticker 28s linear infinite;
    will-change: transform;
  }

  .topbar-ticker-track:hover {
    animation-play-state: paused;
  }

  .ticker-item {
    padding-right: 64px;
    font-weight: 600;
    color: #be185d;
    font-size: 13px;
  }

  @keyframes corp-ticker {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  /* Navbar */
  .fittour-navbar {
    height: 74px;
    display: flex;
    align-items: center;
    background: #ffffff;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar-logo img {
    height: 42px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .navbar-menu {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 100%;
  }

  .navbar-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 100%;
    font-size: 15px;
    font-weight: 700;
    color: #1f2937;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
    border-bottom: 2px solid transparent;
  }

  .navbar-link:hover {
    color: #be185d;
  }

  .navbar-link.is-active {
    color: #be185d;
    border-bottom-color: #be185d;
  }

  /* Dropdown & MegaMenu */
  .nav-item-dropdown {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .dropdown-chevron {
    transition: transform 0.25s ease;
    color: #9ca3af;
  }

  .nav-item-dropdown:hover .dropdown-chevron {
    transform: rotate(180deg);
    color: #be185d;
  }

  .megamenu-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    width: 880px;
    max-width: 92vw;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.05);
    padding: 24px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 100;
  }

  .nav-item-dropdown:hover .megamenu-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .megamenu-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: 10px;
    border-radius: 16px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .service-card:hover {
    background: #fdf2f8;
    transform: translateY(-2px);
  }

  .card-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 12px;
    overflow: hidden;
    background: #f3f4f6;
    margin-bottom: 12px;
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-card:hover .card-thumb img {
    transform: scale(1.06);
  }

  .card-info h4 {
    font-size: 14.5px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 6px;
    line-height: 1.3;
    transition: color 0.2s;
  }

  .service-card:hover .card-info h4 {
    color: #be185d;
  }

  .card-cta {
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    transition: color 0.2s;
  }

  .service-card:hover .card-cta {
    color: #be185d;
  }

  /* Actions */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .navbar-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #f9fafb;
    color: #4b5563;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid #e5e7eb;
  }

  .navbar-search-btn:hover {
    background: #fdf2f8;
    color: #be185d;
    border-color: #fbcfe8;
  }

  .navbar-hotline {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #1f2937;
    padding-right: 6px;
  }

  .hotline-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fdf2f8;
    color: #be185d;
  }

  .hotline-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.2;
  }

  .hotline-text small {
    font-size: 10.5px;
    font-weight: 600;
    color: #6b7280;
    letter-spacing: 0.04em;
  }

  .hotline-text strong {
    font-size: 15px;
    font-weight: 800;
    color: #111827;
  }

  .navbar-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 999px;
    background: #be185d;
    color: #ffffff !important;
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(190, 24, 93, 0.25);
    transition: all 0.25s ease;
  }

  .navbar-cta-btn:hover {
    background: #9d174d;
    box-shadow: 0 6px 18px rgba(190, 24, 93, 0.35);
    transform: translateY(-1px);
  }

  .navbar-mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    flex-direction: column;
    gap: 5px;
  }

  .toggle-bar {
    width: 22px;
    height: 2px;
    background: #111827;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  /* Mobile Drawer */
  .fittour-mobile-drawer {
    display: none;
    background: #ffffff;
    border-top: 1px solid #f3f4f6;
    padding: 24px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }

  .fittour-mobile-drawer:not([hidden]) {
    display: block;
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .drawer-link {
    font-size: 16px;
    font-weight: 700;
    color: #1f2937;
    text-decoration: none;
    padding-block: 6px;
  }

  .drawer-link.is-active {
    color: #be185d;
  }

  .drawer-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .drawer-sublinks {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 14px;
    margin-top: 4px;
    margin-bottom: 8px;
  }

  .drawer-sublink {
    font-size: 14.5px;
    color: #6b7280;
    text-decoration: none;
    font-weight: 500;
  }

  .drawer-sublink:hover {
    color: #be185d;
  }

  .drawer-actions {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid #f3f4f6;
  }

  .drawer-call-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    border-radius: 8px;
    background: #be185d;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }

  @media(max-width: 1100px) {
    .navbar-menu {
      display: none;
    }
    .navbar-mobile-toggle {
      display: flex;
    }
    .navbar-hotline {
      display: none;
    }
  }

  @media(max-width: 768px) {
    .wrap-corp {
      padding-inline: 14px;
    }
    .topbar-badge {
      display: none;
    }
    .fittour-navbar {
      height: 60px;
    }
    .navbar-logo img {
      height: 32px;
    }
    .navbar-cta-btn {
      padding: 7px 14px;
      font-size: 13px;
    }
  }
</style>

