<!-- Project Modal Window (Authentic macOS Light Theme) -->
<div
  id="window-project"
  role="dialog"
  aria-label="Project Details"
  class="atelier-window hidden pointer-events-auto absolute flex-col overflow-hidden rounded-[14px] border border-black/15 bg-[#fbfaf7] text-[#1a1612] shadow-[0_30px_80px_-20px_rgba(0,0,0,0.45),0_8px_24px_-8px_rgba(0,0,0,0.35)] transition-all duration-150"
  style="left: 50%; top: 50%; width: min(880px, 94vw); max-height: calc(100vh - 110px); transform: translate(-50%, -50%); z-index: 100;"
>
  <!-- Window Titlebar -->
  <div class="window-titlebar flex h-10 shrink-0 items-center justify-between border-b border-black/[0.07] px-3.5 select-none cursor-grab active:cursor-grabbing bg-[#ecebe6]">
    <div class="flex items-center gap-1.5">
      <button type="button" data-close-window="project" aria-label="Close" class="group flex size-3 items-center justify-center rounded-full bg-[#ff5f57] ring-1 ring-black/10 hover:brightness-90 cursor-pointer">
        <svg class="size-2 text-[#4d0000] opacity-0 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <button type="button" aria-label="Minimize" class="size-3 rounded-full bg-[#febc2e] ring-1 ring-black/10"></button>
      <button type="button" aria-label="Maximize" class="size-3 rounded-full bg-[#28c840] ring-1 ring-black/10"></button>
    </div>
    <div class="flex items-center justify-center">
      <span id="proj-titlebar" class="truncate text-[12px] font-medium tracking-tight text-black/70">Project Details</span>
    </div>
    <div class="w-12"></div>
  </div>
  
  <!-- Window Body -->
  <div class="flex-1 overflow-y-auto overflow-x-hidden px-5 py-6 sm:px-9 sm:py-8" style="max-height: calc(100vh - 170px);">
    <!-- Section 1: Header -->
    <div class="grid grid-cols-12 gap-5 border-b border-black/[0.08] pb-6">
      <div class="col-span-12 md:col-span-3">
        <p id="proj-num-badge" class="text-[10px] font-semibold uppercase tracking-[0.18em] text-black/45">01 — Project</p>
        <p id="proj-category" class="mt-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-black/45">Product Design</p>
      </div>
      <div class="col-span-12 md:col-span-9">
        <h2 id="proj-title" class="text-[30px] font-semibold leading-[1.05] tracking-[-0.025em] text-[#1a1612] sm:text-[38px]">Lume Eyewear Launch</h2>
        <p id="proj-positioning" class="mt-2.5 max-w-2xl text-[14px] leading-snug text-black/65">Eyewear that reads as an object first, a product second.</p>
      </div>
    </div>

    <!-- Section 2: Overview & 3-Column Brief -->
    <div class="grid grid-cols-12 gap-5 border-b border-black/[0.08] py-7 sm:gap-8">
      <div class="col-span-12 md:col-span-5">
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-black/45">Overview</p>
        <p id="proj-desc" class="mt-2 text-[13.5px] leading-relaxed text-black/80">Naming, packaging, and launch system for an independent eyewear house. Every frame ships in a fold-flat case designed to sit on a shelf like a small sculpture.</p>
      </div>
      <div class="col-span-12 md:col-span-7">
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-black/45">Brief</p>
        <div class="mt-2 grid gap-5 sm:grid-cols-3">
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-black/45">Challenge</p>
            <p id="proj-challenge" class="mt-1.5 text-[13px] leading-relaxed text-black/75">Stand out in a category owned by two conglomerates and a thousand lookalikes.</p>
          </div>
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-black/45">Direction</p>
            <p id="proj-direction" class="mt-1.5 text-[13px] leading-relaxed text-black/75">Lead with the silhouette. Strip the packaging to one colour and one line of type. Let the lens do the talking.</p>
          </div>
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-black/45">Outcome</p>
            <p id="proj-outcome" class="mt-1.5 text-[13px] leading-relaxed text-black/75">Sold through the launch colourway in three weeks. Picked up by two concept stores in Copenhagen.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 3: Gallery -->
    <div class="py-6">
      <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-black/45 mb-3">Gallery</p>
      <div id="proj-gallery-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      </div>
    </div>
  </div>
</div>

