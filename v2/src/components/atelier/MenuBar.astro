---
// v2/src/components/atelier/MenuBar.astro - macOS Top MenuBar Component
---

<header class="atelier-menubar absolute inset-x-0 top-0 z-20 select-none">
  <div class="atelier-menubar-inner flex h-7 items-center justify-between bg-black/20 px-4 backdrop-blur-md border-b border-white/10 text-white">
    <!-- Left Menu Items -->
    <div class="flex items-center gap-4 text-[12px] text-white/90 font-medium">
      <!-- Apple Logo -->
      <span class="inline-flex items-center cursor-default">
        <svg class="size-3.5 fill-current" viewBox="0 0 170 170" width="14" height="14">
          <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.69-7.85-11.97-14.42-6.19-9.58-10.97-20.44-14.34-32.58-3.37-12.14-5.06-23.71-5.06-34.72 0-14.46 3.66-26.36 10.97-35.71 7.31-9.35 16.5-14.15 27.56-14.42 4.13 0 9.04 1.15 14.75 3.46 5.71 2.31 9.38 3.53 11 3.66 2.18-.26 5.98-1.52 11.41-3.8 5.43-2.28 10.15-3.34 14.15-3.17 10.88.54 19.82 4.54 26.83 12.01-9.79 5.98-14.57 14.24-14.34 24.78.22 8.04 3.26 14.88 9.12 20.53 5.86 5.65 12.82 8.8 20.89 9.45-2.28 7.06-5.11 14.34-8.48 21.84zM119.22 31.84c0-7.72 2.76-14.78 8.28-21.19 5.52-6.41 12.22-10.22 20.1-11.41.22 1.09.33 2.18.33 3.26 0 7.61-2.93 14.89-8.8 21.84-5.87 6.96-12.82 10.76-20.86 11.41-.33-1.3-.44-2.6-.44-3.91z"/>
        </svg>
      </span>
      <span class="font-bold tracking-tight text-white">Atelier</span>
      <span class="text-white/75 hover:text-white cursor-default transition-colors">File</span>
      <span class="text-white/75 hover:text-white cursor-default transition-colors">Edit</span>
      <span class="text-white/75 hover:text-white cursor-default transition-colors">View</span>
      <span class="text-white/75 hover:text-white cursor-default transition-colors">Window</span>
      <span class="text-white/75 hover:text-white cursor-default transition-colors">Help</span>
    </div>

    <!-- Right Status Icons -->
    <div class="flex items-center gap-3.5 text-[11px] text-white/90">
      <!-- Battery Status -->
      <div class="flex items-center gap-1.5">
        <span class="text-white">
          <svg width="22" height="11" viewBox="0 0 24 12" fill="none" aria-hidden="true">
            <rect x="0.5" y="1.5" width="19" height="9" rx="2.4" stroke="currentColor" stroke-opacity="0.6"></rect>
            <rect x="2" y="3" width="14" height="6" rx="1.2" fill="#34c759"></rect>
            <path d="M21.5 4.2 v3.6 a1.6 1.6 0 0 0 1.2 -1.8 a1.6 1.6 0 0 0 -1.2 -1.8 Z" fill="currentColor" fill-opacity="0.6"></path>
          </svg>
        </span>
        <span class="text-[11px] font-medium">100%</span>
      </div>

      <!-- Wi-Fi Icon -->
      <span class="inline-flex items-center text-white/85" title="Wi-Fi Connected">
        <svg width="15" height="12" viewBox="0 0 16 12" fill="currentColor">
          <path d="M8 10a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm-3.5-3a5 5 0 0 1 7 0l-1.2 1.2a3.3 3.3 0 0 0-4.6 0L4.5 7zm-3-3a9.2 9.2 0 0 1 13 0l-1.2 1.2a7.5 7.5 0 0 0-10.6 0L1.5 4z"/>
        </svg>
      </span>

      <!-- Control Center / Sliders -->
      <span class="inline-flex items-center text-white/85" title="Control Center">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
          <path d="M3 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v10a1 1 0 1 1-2 0v-1H4v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1zm1 4h8v4H4V6z"/>
        </svg>
      </span>

      <!-- Spotlight Search -->
      <span class="inline-flex items-center text-white/85" title="Spotlight">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
          <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
        </svg>
      </span>

      <!-- Live Clock -->
      <span id="atelier-clock" class="font-medium tracking-tight text-white pl-1">
        Wed 14:08
      </span>
    </div>
  </div>
</header>

<style>
  .atelier-menubar {
    display: block !important;
  }
  .atelier-menubar-inner {
    display: flex !important;
  }
</style>

<script is:inline>
  function updateAtelierClock() {
    const clockEl = document.getElementById('atelier-clock');
    if (!clockEl) return;
    const now = new Date();
    const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const day = days[now.getDay()];
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    clockEl.textContent = `${day} ${hours}:${minutes}`;
  }
  updateAtelierClock();
  setInterval(updateAtelierClock, 1000);
</script>
