<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const triggers = document.querySelectorAll("#services button[id^='service-trigger-']");
  const panels = document.querySelectorAll("#services [id^='service-panel-']");
  
  triggers.forEach((btn, idx) => {
    btn.addEventListener("click", () => {
      triggers.forEach(t => {
        t.setAttribute("aria-expanded", "false");
        t.classList.remove("border-plum", "bg-cream");
      });
      panels.forEach(p => {
        p.setAttribute("hidden", "");
        p.classList.add("hidden");
      });

      btn.setAttribute("aria-expanded", "true");
      btn.classList.add("border-plum", "bg-cream");
      const targetPanel = document.getElementById("service-panel-" + idx);
      if (targetPanel) {
        targetPanel.removeAttribute("hidden");
        targetPanel.classList.remove("hidden");
      }
    });
  });
});
</script>
