    tab.addEventListener("click", () => {
      tabs.forEach(t => {
        t.setAttribute("aria-selected", "false");
        t.setAttribute("tabindex", "-1");
        t.classList.remove("border-plum", "bg-cream", "shadow-[0_4px_0_0_var(--color-plum)]");
