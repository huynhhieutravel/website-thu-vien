<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const pauseBtn = document.querySelector("#clients button");
  if (pauseBtn) {
    let paused = false;
    pauseBtn.addEventListener("click", () => {
      paused = !paused;
      const marquees = document.querySelectorAll("#clients [class*='animate-marquee']");
      marquees.forEach(m => {
        m.style.animationPlayState = paused ? "paused" : "running";
      });
      pauseBtn.setAttribute("aria-pressed", paused);
    });
  }
});
</script>
