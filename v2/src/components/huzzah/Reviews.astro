uote><figcaption class="mt-7"><span class="block font-heading text-2xl text-plum">Marcus Bell</span><span class="block text-plum/70">Founder, Bluebird Roasters</span></figcaption><a class="mt-7 inline-flex w-fit items-center gap-2 font-heading text-lg text-plum underline decoration-2 underline-offset-4 hover:decoration-coral" href="#work">Read the Bluebird story<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right size-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></figure></div></section>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const pauseBtn = document.querySelector("#reviews button");
  if (pauseBtn) {
    let paused = false;
    pauseBtn.addEventListener("click", () => {
      paused = !paused;
      const marquees = document.querySelectorAll("#reviews [class*='animate-marquee']");
      marquees.forEach(m => {
        m.style.animationPlayState = paused ? "paused" : "running";
      });
    });
  }
});
</script>
