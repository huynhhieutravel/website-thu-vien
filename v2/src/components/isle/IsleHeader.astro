---
// v2/src/components/isle/IsleHeader.astro
interface Props {
  currentPath?: string;
}

const { currentPath = "/isle" } = Astro.props;

const isHome = currentPath === "/isle" || currentPath === "/isle/";
const isAbout = currentPath === "/isle/about";
const isContact = currentPath === "/isle/contact";
---

<nav
  class="select-none"
  style="position: fixed; left: 50%; top: 48px; transform: translateX(-50%); z-index: 9999;"
>
  <div
    class="flex items-center gap-1 rounded-full border border-white/15 p-1.5 shadow-[0_10px_28px_rgba(3,7,14,0.35),inset_0_1px_0_rgba(255,255,255,0.18)] backdrop-blur-xl"
    style="background:rgba(10,14,22,0.42)"
  >
    <a
      href="/isle"
      class={`rounded-full px-4 py-1.5 text-[13px] font-medium tracking-wide transition-colors duration-200 ${
        isHome
          ? "bg-white/18 text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.16)]"
          : "text-white/65 hover:text-white"
      }`}
    >
      Home
    </a>
    <a
      href="/isle/about"
      class={`rounded-full px-4 py-1.5 text-[13px] font-medium tracking-wide transition-colors duration-200 ${
        isAbout
          ? "bg-white/18 text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.16)]"
          : "text-white/65 hover:text-white"
      }`}
    >
      About
    </a>
    <a
      href="/isle/contact"
      class={`rounded-full px-4 py-1.5 text-[13px] font-medium tracking-wide transition-colors duration-200 ${
        isContact
          ? "bg-white/18 text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.16)]"
          : "text-white/65 hover:text-white"
      }`}
    >
      Contact
    </a>
  </div>
</nav>
