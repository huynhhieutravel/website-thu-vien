---
// Global.astro - 3D Globe, Flight Arcs, City Carousel & Boarding Pass Card
---

<section id="global" aria-labelledby="global-title" class="relative z-10 bg-obsidian text-ivory">
  <div class="stage relative w-full overflow-hidden bg-obsidian">
    <div class="stage-safe absolute inset-x-0 top-0">
      <div class="pointer-events-none absolute inset-0 bg-linear-to-b from-onyx via-obsidian to-obsidian"></div>

      <!-- Huge Global Typography -->
      <h2 id="global-title" class="pointer-events-none absolute inset-x-0 top-[10%] select-none bg-linear-to-b from-champagne via-champagne/45 to-champagne/0 bg-clip-text pb-[0.08em] text-center font-heading text-[clamp(5.5rem,25vw,27rem)] font-light leading-[0.9] tracking-[-0.02em] text-transparent md:top-[5%]">
        Global
      </h2>

      <!-- Globe Box -->
      <div class="globe-box top-[34%] will-change-transform md:top-[27%]">
        <div class="absolute inset-0 overflow-hidden rounded-full">
          <img
            alt="Quả địa cầu đen với lục địa viền vàng kim hiển thị mạng lưới bay tư nhân"
            loading="eager"
            decoding="async"
            class="scale-[1.06] object-cover"
            style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent"
            src="/images/aerive/globe.png"
          />
        </div>

        <!-- 3 Orbiting Flight Path Arcs -->
        <svg viewBox="0 0 1000 1000" aria-hidden="true" class="absolute inset-0 h-full w-full overflow-visible text-champagne">
          <g transform="rotate(-14 500 500)">
            <path data-arc="true" d="M -60 500 A 560 140 0 0 0 1060 500" pathLength="1" fill="none" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.4" style="stroke-dasharray:1;stroke-dashoffset:0"></path>
            <circle data-arc-dot="true" cx="-60" cy="500" r="5" fill="currentColor" opacity="0"></circle>
          </g>
          <g transform="rotate(17 500 500)">
            <path data-arc="true" d="M -20 500 A 520 196 0 0 0 1020 500" pathLength="1" fill="none" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.4" style="stroke-dasharray:1;stroke-dashoffset:0"></path>
            <circle data-arc-dot="true" cx="-20" cy="500" r="5" fill="currentColor" opacity="0"></circle>
          </g>
          <g transform="rotate(-33 500 500)">
            <path data-arc="true" d="M -110 500 A 610 104 0 0 0 1110 500" pathLength="1" fill="none" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.4" style="stroke-dasharray:1;stroke-dashoffset:0"></path>
            <circle data-arc-dot="true" cx="-110" cy="500" r="5" fill="currentColor" opacity="0"></circle>
          </g>
        </svg>
      </div>

      <!-- City Switcher Carousel (Left) -->
      <div class="absolute inset-x-5 top-[26%] md:inset-x-auto md:bottom-[11%] md:left-[6vw] md:top-auto md:w-[28vw] md:max-w-[26rem]">
        <div data-global-item="true" class="invisible opacity-0">
          <div class="flex flex-nowrap items-center justify-center gap-2 sm:gap-4 md:justify-start">
            <span class="shrink-0 font-heading text-[1.3rem] leading-none text-ivory sm:text-[1.6rem] md:text-[1.8rem]">Bay tới bất kỳ đâu</span>
            <span class="flex shrink-0 items-center gap-2 text-champagne">
              <span class="h-px w-4 bg-champagne/50 sm:w-6 md:w-8"></span>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane size-4" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"></path></svg>
              <span class="h-px w-4 bg-champagne/50 sm:w-6 md:w-8"></span>
            </span>
            <span class="relative inline-flex h-[1.6rem] min-w-[6.5ch] shrink-0 items-center overflow-hidden sm:h-[1.9rem] md:h-[2.1rem]">
              <span class="block whitespace-nowrap font-heading text-[1.3rem] leading-none text-champagne transition-all duration-300 sm:text-[1.6rem] md:text-[1.8rem]">London</span>
            </span>
          </div>
        </div>
        <p data-global-item="true" class="invisible mt-8 hidden font-heading text-[clamp(1.8rem,2.4vw,2.5rem)] font-normal leading-[1.1] opacity-0 md:block">
          Khám phá thế giới với sự thoải mái và chủ động tối đa.
        </p>
        <p data-global-item="true" class="invisible mt-5 hidden text-[14px] leading-[1.75] text-ivory/70 opacity-0 md:block">
          Từ kỳ nghỉ cuối tuần tại Mykonos đến cuộc họp hội đồng quản trị ở Singapore, AERIVE chuẩn bị đường bay, giấy phép và xe đưa đón, để cả địa cầu luôn trong tầm tay bạn.
        </p>
      </div>

      <!-- Luxury Boarding Pass Card (Right) -->
      <div class="invisible absolute inset-x-0 bottom-[13%] mx-auto w-[min(86vw,350px)] opacity-0 md:inset-x-auto md:bottom-[11%] md:right-[6vw] md:mx-0">
        <div class="relative overflow-hidden rounded-[18px] bg-ivory text-obsidian shadow-[0_40px_90px_rgba(0,0,0,0.55)]">
          <div class="px-6 pb-5 pt-6">
            <div class="flex items-start justify-between">
              <span class="pl-[0.3em] font-heading text-[1.35rem] font-medium leading-none tracking-[0.3em]">AERIVE</span>
              <span class="text-[9px] uppercase tracking-[0.24em] text-ash">Boarding pass</span>
            </div>
            <div class="mt-7 flex items-end justify-between gap-3">
              <div>
                <p class="text-[9px] uppercase tracking-[0.24em] text-ash">Điểm đi</p>
                <p class="mt-1 font-heading text-[1.55rem] leading-[1.05]">Nơi bạn ở</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plane mb-1.5 size-4 shrink-0 text-gilt-deep"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"></path></svg>
              <div class="text-right">
                <p class="text-[9px] uppercase tracking-[0.24em] text-ash">Điểm đến</p>
                <p class="mt-1 font-heading text-[1.55rem] leading-[1.05]">Nơi bạn muốn</p>
              </div>
            </div>
            <div class="mt-6 grid grid-cols-3 gap-3 border-t border-obsidian/15 pt-4">
              <div>
                <p class="text-[9px] uppercase tracking-[0.22em] text-ash">Hành khách</p>
                <p class="mt-1 text-[13px] font-medium">Bạn</p>
              </div>
              <div>
                <p class="text-[9px] uppercase tracking-[0.22em] text-ash">Giờ khởi hành</p>
                <p class="mt-1 text-[13px] font-medium">Giờ của bạn</p>
              </div>
              <div>
                <p class="text-[9px] uppercase tracking-[0.22em] text-ash">Chỗ ngồi</p>
                <p class="mt-1 text-[13px] font-medium">Bất kỳ</p>
              </div>
            </div>
          </div>
          <div class="relative flex items-center">
            <span class="absolute -left-3 size-6 rounded-full bg-obsidian"></span>
            <span class="mx-5 h-px flex-1 border-t border-dashed border-obsidian/25"></span>
            <span class="absolute -right-3 size-6 rounded-full bg-obsidian"></span>
          </div>
          <div class="flex items-center justify-between gap-5 px-6 pb-6 pt-5">
            <!-- Simulated Barcode -->
            <svg viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true" class="h-10 w-full max-w-[200px]">
              <rect x="0" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="4" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="7" y="0" width="2" height="20" fill="currentColor"></rect>
              <rect x="10" y="0" width="2" height="20" fill="currentColor"></rect>
              <rect x="13" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="18" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="21" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="25" y="0" width="2" height="20" fill="currentColor"></rect>
              <rect x="28" y="0" width="2" height="20" fill="currentColor"></rect>
              <rect x="31" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="36" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="40" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="43" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="46" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="50" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="55" y="0" width="2" height="20" fill="currentColor"></rect>
              <rect x="58" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="62" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="65" y="0" width="2" height="20" fill="currentColor"></rect>
              <rect x="68" y="0" width="2" height="20" fill="currentColor"></rect>
              <rect x="72" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="75" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="79" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="82" y="0" width="3" height="20" fill="currentColor"></rect>
              <rect x="86" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="89" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="91" y="0" width="1" height="20" fill="currentColor"></rect>
              <rect x="94" y="0" width="2" height="20" fill="currentColor"></rect>
              <rect x="97" y="0" width="1" height="20" fill="currentColor"></rect>
            </svg>
            <span class="shrink-0 text-right text-[9px] uppercase leading-relaxed tracking-[0.22em] text-ash">Hàng không<br />tư nhân</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
