         <a aria-label="Facebook" class="mega-social-link" href="https://facebook.com" rel="noreferrer" target="_blank">
          <img alt="" aria-hidden="true" src="/images/facebook.svg"/>
         </a>
        </div>
       </div>
      </div>
     </nav>
    </div>
   </div>
   <div class="nav-cta-button">
    <a class="button nav-button w-button" href="/sandiego/pricing">
     Sales
    </a>
   </div>
  </nav>
  <div aria-expanded="false" aria-label="Menu" class="menu-button w-nav-button" role="button" tabindex="0">
   <img alt="" aria-hidden="true" src="/images/menu-icon-white.svg"/>
  </div>
 </div>
</header>


<script>
  // Mobile dropdown / hamburger toggler
  document.addEventListener('DOMContentLoaded', () => {
    const dropdownBtns = document.querySelectorAll('.nav-link-dropdown-btn');
    dropdownBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const parent = btn.closest('.nav-dropdown-parent');
        const list = parent?.querySelector('.nav-dropdown-content-holder');
        if (list) {
          const isShown = list.classList.toggle('w--open');
          btn.classList.toggle('w--open', isShown);
        }
      });
    });
  });
</script>
