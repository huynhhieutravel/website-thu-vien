           <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z">
           </path>
          </svg>
         </span>
         <span class="mega-item-text">
          <span class="mega-item-title">
           Blog
          </span>
          <span class="mega-item-desc">
           Product updates, tips, and ideas
          </span>
         </span>
        </a>
       </div>
       <div class="mega-menu-footer">
        <div class="mega-footer-links">
         <a class="mega-footer-link" href="/blog/get-running">
          Article Detail
         </a>
         <a class="mega-footer-link" href="/blog/category/product">
          Blog Category
         </a>
         <a class="mega-footer-link" href="/support/how">
          Support Detail
         </a>
         <a class="mega-footer-link" href="/search">
          Search
         </a>
         <a class="mega-footer-link" href="/sandiego/privacy">
          Privacy
         </a>
        </div>
        <div class="mega-footer-social">
         <a aria-label="Instagram" class="mega-social-link" href="https://instagram.com" rel="noreferrer" target="_blank">
          <img alt="" aria-hidden="true" src="/images/instagram.svg"/>
         </a>
         <a aria-label="Twitter" class="mega-social-link" href="https://twitter.com" rel="noreferrer" target="_blank">
          <img alt="" aria-hidden="true" src="/images/twitter.svg"/>
