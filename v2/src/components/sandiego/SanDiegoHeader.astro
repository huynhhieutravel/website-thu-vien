---
// v2/src/components/sandiego/SanDiegoHeader.astro
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;
---

<header class="main-nav w-nav" data-animation="default" data-collapse="medium" data-nav-open="false" role="banner">
 <div class="container nav-container w-container">
  <div class="nav-bg-holder">
   <div class="nav-bg">
   </div>
  </div>
  <a class="brand w-nav-brand" href="/sandiego">
   <img alt="San Diego" class="nav-logo" src="/images/SanDiego-Logo.svg"/>
  </a>
  <nav class="nav-menu w-nav-menu" role="navigation">
   <div class="nav-link-holder">
    <a class="nav-link w-inline-block" href="/sandiego/features">
     <div>
      Features
     </div>
     <div class="link-background">
     </div>
    </a>
   </div>
   <div class="nav-link-holder">
    <a class="nav-link w-inline-block" href="/sandiego/company">
     <div>
      Company
     </div>
     <div class="link-background">
     </div>
    </a>
   </div>
   <div class="nav-link-holder">
    <div class="nav-dropdown-parent w-dropdown">
     <div aria-expanded="false" aria-haspopup="true" class="nav-link nav-link-dropdown-btn w-dropdown-toggle" role="button" tabindex="0">
      <div class="nav-link-icon w-icon-dropdown-toggle">
      </div>
      <div>
       Pages
      </div>
      <div class="link-background">
      </div>
      <div class="nav-dropdown-link-arrow-holder">
       <div class="nav-dropdown-link-arrow-animated">
        <div class="nav-dropdown-link-arrow">
        </div>
       </div>
      </div>
     </div>
     <nav class="nav-dropdown-content-holder w-dropdown-list">
      <div class="mega-menu">
       <div class="mega-menu-grid">
        <a class="mega-item" href="/sandiego">
         <span class="mega-item-icon">
          <svg class="lucide lucide-house size-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
           <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8">
           </path>
           <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z">
           </path>
          </svg>
         </span>
         <span class="mega-item-text">
          <span class="mega-item-title">
           Home
          </span>
          <span class="mega-item-desc">
           Back to the San Diego homepage
          </span>
         </span>
        </a>
        <a class="mega-item" href="/sandiego/features">
         <span class="mega-item-icon">
          <svg class="lucide lucide-sparkles size-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
           <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z">
           </path>
           <path d="M20 3v4">
           </path>
           <path d="M22 5h-4">
           </path>
           <path d="M4 17v2">
           </path>
           <path d="M5 18H3">
           </path>
          </svg>
         </span>
         <span class="mega-item-text">
          <span class="mega-item-title">
           Features
          </span>
          <span class="mega-item-desc">
           Everything San Diego can do for you
          </span>
         </span>
        </a>
        <a class="mega-item" href="/sandiego/pricing">
         <span class="mega-item-icon">
          <svg class="lucide lucide-tag size-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
           <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z">
           </path>
