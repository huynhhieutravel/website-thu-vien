           </circle>
          </svg>
         </span>
         <span class="mega-item-text">
          <span class="mega-item-title">
           Pricing
          </span>
          <span class="mega-item-desc">
           Simple plans for every team size
          </span>
         </span>
        </a>
        <a class="mega-item" href="/sandiego/company">
         <span class="mega-item-icon">
          <svg class="lucide lucide-building2 size-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
           <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z">
           </path>
           <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2">
           </path>
           <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2">
           </path>
           <path d="M10 6h4">
           </path>
           <path d="M10 10h4">
           </path>
           <path d="M10 14h4">
           </path>
           <path d="M10 18h4">
           </path>
          </svg>
         </span>
         <span class="mega-item-text">
          <span class="mega-item-title">
           Company
          </span>
          <span class="mega-item-desc">
           The team and story behind us
          </span>
         </span>
        </a>
        <a class="mega-item" href="/sandiego/support">
         <span class="mega-item-icon">
          <svg class="lucide lucide-life-buoy size-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
           <circle cx="12" cy="12" r="10">
