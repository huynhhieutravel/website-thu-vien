        <a class="mega-item" href="/sandiego/contact">
         <span class="mega-item-icon">
          <svg class="lucide lucide-mail size-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
