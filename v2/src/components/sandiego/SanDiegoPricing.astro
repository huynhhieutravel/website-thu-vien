---
// v2/src/components/sandiego/SanDiegoPricing.astro
---

<div class="section" id="pricing">
 <div class="container">
  <div class="fade-in-on-scroll">
   <h2>
    Flexible pricing for
    <span class="text-gradient">
     companies
    </span>
    and developers
   </h2>
  </div>
  <div class="fade-in-on-scroll">
   <div class="text-container">
    <p>
     Easily combine and sync all the media from a single shoot, then tap to choose your best footage.
    </p>
   </div>
  </div>
  <div class="pricing-table">
   <div class="content">
    <div class="pricing-table-info">
     <div class="fade-in-on-scroll">
      <h3 class="heading-3-style">
       Keep everything organised
      </h3>
     </div>
     <div class="fade-in-on-scroll">
      <div>
       Bring time, expenses, and tasks into one shared view, so your whole team always knows what is happening and what comes next.
      </div>
     </div>
     <div class="fade-in-on-scroll">
      <div class="button-holder-left-justify-bottom">
       <a class="button black-button-with-icon w-button" href="/pricing">
        See pricing
       </a>
      </div>
     </div>
    </div>
   </div>
   <div class="content">
    <div class="card-item pricing-card">
     <div class="card-item-content pricing-item-content">
      <div class="pricing-item-content">
       <div class="pricing-title">
        Core
       </div>
       <div class="pricing-main-content">
        <div class="product-item-price">
         <sup class="superscript">
          $
         </sup>
         20
        </div>
        <div class="pricing-item-price-desc">
         per user / month
         <br/>
         billed annually
        </div>
       </div>
       <div class="pricing-item-description">
        For teams that want a world-class experience for every member, without all the admin.
       </div>
      </div>
      <div class="pricing-item-button-holder">
       <a class="button w-button" href="/pricing">
        Try for Free
       </a>
      </div>
     </div>
    </div>
   </div>
   <div class="content">
    <div class="card-item pricing-card">
     <div class="card-item-content pricing-item-content">
      <div class="pricing-item-content">
       <div class="pricing-title">
        Pro
       </div>
       <div class="pricing-main-content">
        <div class="product-item-price">
         <sup class="superscript">
          $
         </sup>
         50
        </div>
        <div class="pricing-item-price-desc">
         per user / month
         <br/>
         billed annually
        </div>
       </div>
       <div class="pricing-item-description">
        For growing teams that need advanced controls, integrations, and priority support.
       </div>
      </div>
      <div class="pricing-item-button-holder">
       <a class="button w-button" href="/pricing">
        Try for Free
       </a>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
</div>

