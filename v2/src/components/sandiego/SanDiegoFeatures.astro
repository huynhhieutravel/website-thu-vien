---
// v2/src/components/sandiego/SanDiegoFeatures.astro
---

<div class="section" id="FeatureList">
 <div class="container">
  <div class="w-layout-grid feature-grid">
   <div class="card-item white-text" id="w-node-_7b19d13e-0e8d-2369-5abf-e24fedfaa268-6c33c78d">
    <div class="card-background">
    </div>
    <div class="card-item-content">
     <img alt="Clock illustration" class="feature-1-image fade-in-on-scroll" loading="lazy" sizes="(max-width: 479px) 49vw, (max-width: 767px) 52vw, 703px" src="/images/clock-dynamic-clay.webp" srcset="/images/clock-dynamic-clay-p-500.png 500w, /images/clock-dynamic-clay-p-800.png 800w, /images/clock-dynamic-clay.webp 1026w"/>
     <div class="fade-in-on-scroll">
      <h2 class="card-title">
       Effortless Time Mastery
      </h2>
     </div>
     <div class="fade-in-on-scroll">
      <p>
       In the fast-paced world we live in, San Diego empowers you to take control of your time like never before.
      </p>
     </div>
    </div>
   </div>
   <div class="card-item" id="w-node-_628315c7-9285-9cb1-4712-9cee2615c32b-6c33c78d">
    <div class="card-background">
    </div>
    <div class="card-item-content">
     <div class="fade-in-on-scroll">
      <h2 class="card-title">
       Secure Information Hub
      </h2>
     </div>
     <div class="fade-in-on-scroll">
      <p>
       From important documents and passwords to confidential notes and contacts, San Diego safeguards your sensitive data with state-of-the-art encryption.
      </p>
     </div>
    </div>
    <img alt="San Diego user" class="card-person-image fade-in-on-scroll" loading="lazy" sizes="(max-width: 479px) 92vw, 1244px" src="/images/SD-Person.webp" srcset="/images/SD-Person-p-500.png 500w, /images/SD-Person-p-800.png 800w, /images/SD-Person-p-1080.png 1080w, /images/SD-Person.webp 1114w"/>
   </div>
   <div class="card-item white-text" id="w-node-_107edcd6-e1b1-ee1d-d87c-382208bdc80a-6c33c78d">
    <div class="card-background main-gradient">
    </div>
    <div class="card-text-with-iphone-content">
     <div class="card-item-content">
      <div class="fade-in-on-scroll">
       <div class="card-small-icon">
        <img alt="" class="card-small-icon-image" loading="lazy" src="/images/ScaleIcon.svg"/>
       </div>
      </div>
      <div class="fade-in-on-scroll">
       <h2 class="card-title-xl">
        Intelligent Finance Tracking
       </h2>
      </div>
      <div class="fade-in-on-scroll">
       <p>
        Easily integrate with all your favorite tools through APIs including automatic integrations.
       </p>
      </div>
     </div>
     <div class="card-iphone on-card">
      <div class="card-iphone-holder">
       <div class="card-phone-image-container">
        <img alt="" class="card-iphone-screelock" data-parallax="true" data-parallax-scale="1.15,1" loading="lazy" src="/images/SD-App.svg"/>
        <img alt="" class="width-full" loading="lazy" sizes="(max-width: 479px) 73vw, 473px" src="/images/App2.webp" srcset="/images/App2-p-500.jpg 500w, /images/App2-p-800.jpg 800w, /images/App2.webp 1020w"/>
       </div>
       <img alt="San Diego finance dashboard" class="card-iphone-image" loading="lazy" sizes="(max-width: 479px) 92vw, 603px" src="/images/iPhoneMockup.webp" srcset="/images/iPhoneMockup-p-500.png 500w, /images/iPhoneMockup-p-800.png 800w, /images/iPhoneMockup-p-1080.png 1080w, /images/iPhoneMockup.webp 1419w"/>
      </div>
     </div>
    </div>
   </div>
  </div>
 </div>
</div>

