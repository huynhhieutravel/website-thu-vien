<script is:inline>
(function() {
  const slider = document.querySelector('.phone-slider');
  if (!slider) return;

  const slides = slider.querySelectorAll('.phone-slide');
  const dots = slider.querySelectorAll('.w-slider-dot');
  const prevBtn = slider.querySelector('.phone-slider-arrows.w-slider-arrow-left');
  const nextBtn = slider.querySelector('.phone-slider-arrows.w-slider-arrow-right');

  let currentIdx = 0;
  const totalSlides = slides.length;

  function showSlide(index) {
    if (index < 0) index = totalSlides - 1;
    if (index >= totalSlides) index = 0;
    currentIdx = index;

    slides.forEach((slide, i) => {
      if (i === currentIdx) {
        slide.style.opacity = '1';
        slide.style.transform = 'scale(1)';
        slide.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
        slide.style.zIndex = '2';
      } else {
        slide.style.opacity = '0';
        slide.style.transform = 'scale(0.96)';
        slide.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
        slide.style.zIndex = '1';
      }
    });

    dots.forEach((dot, i) => {
      if (i === currentIdx) {
        dot.classList.add('w-active');
      } else {
        dot.classList.remove('w-active');
      }
    });
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.preventDefault();
      showSlide(currentIdx - 1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.preventDefault();
      showSlide(currentIdx + 1);
    });
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', (e) => {
      e.preventDefault();
      showSlide(i);
    });
  });

  // Autoplay slider every 4 seconds
  let autoTimer = setInterval(() => {
    showSlide(currentIdx + 1);
  }, 4000);

  slider.addEventListener('mouseenter', () => clearInterval(autoTimer));
  slider.addEventListener('mouseleave', () => {
    clearInterval(autoTimer);
    autoTimer = setInterval(() => showSlide(currentIdx + 1), 4000);
  });

  showSlide(0);
})();
</script>

