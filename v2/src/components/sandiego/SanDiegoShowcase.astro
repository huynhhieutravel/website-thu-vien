---
// v2/src/components/sandiego/SanDiegoShowcase.astro
---

<div class="section" id="DarkMode">
 <div class="container display-on-section-scroll">
  <div class="content" id="w-node-ece89d93-2df3-9c66-994e-a99360ef72ee-6c33c78d">
   <div class="fade-in-on-scroll">
    <h2 class="white-text">
     Seamless Functionality
     <br/>
     <span class="text-gradient">
      in Any
     </span>
     environment.
    </h2>
   </div>
   <div class="text-container">
    <div class="fade-in-on-scroll">
     <p class="white-text">
      San Diego understands that everyone has different preferences and environments, which is why it offers a sleek and efficient Dark Mode.
     </p>
    </div>
   </div>
  </div>
  <div class="product-phone-image-container product-phone-image-on-dark-section">
   <div class="product-container on-dark-section">
    <div class="product-phone-image-holder">
     <img alt="San Diego dark mode on iPhone" class="product-phone-image" loading="lazy" sizes="(max-width: 1279px) 100vw, 1313.5px" src="/images/Holding-iPhone.webp" srcset="/images/Holding-iPhone-p-500.png 500w, /images/Holding-iPhone-p-800.png 800w, /images/Holding-iPhone-p-1080.png 1080w, /images/Holding-iPhone-p-1600.png 1600w, /images/Holding-iPhone-p-2000.png 2000w, /images/Holding-iPhone.webp 2475w"/>
     <div class="product-phone-content">
      <img alt="" class="product-phone-demo-image _1" loading="lazy" src="/images/SD-App.svg"/>
      <img alt="" class="product-phone-demo-image _2" data-parallax="true" data-parallax-x="100,0" loading="lazy" sizes="(max-width: 479px) 100vw, 554px" src="/images/App2.webp" srcset="/images/App2-p-500.jpg 500w, /images/App2-p-800.jpg 800w, /images/App2.webp 1020w"/>
     </div>
     <div class="product-phone-image-overlay">
     </div>
    </div>
   </div>
  </div>
  <div class="cta-on-dark-section">
   <div class="fade-in-on-scroll">
    <div class="cta-on-dark-images-holder">
     <img alt="" class="cta-on-dark-app _1" data-parallax="true" data-parallax-y="0,-30" loading="lazy" sizes="(max-width: 479px) 37vw, 238px" src="/images/App2.webp" srcset="/images/App2-p-500.jpg 500w, /images/App2-p-800.jpg 800w, /images/App2.webp 1020w"/>
     <img alt="" class="cta-on-dark-app _2" data-parallax="true" data-parallax-y="0,30" loading="lazy" src="/images/SD-App.svg"/>
    </div>
   </div>
   <div class="fade-in-on-scroll">
    <h2 class="cta-dark-title">
     Download
     <br/>
     San Diego Now!
    </h2>
    <p class="white-text">
     Discover how digital presenteeism damages productivity and
     <br/>
     prevents asynchronous work
    </p>
    <div class="subscribe-form w-form">
     <form class="subscribe-form-flex" name="subscribe-form" novalidate="">
      <div class="subscribe-form-input-wrapper">
       <input aria-label="Email" class="form-input subscribe-input w-input" maxlength="256" name="email" placeholder="Your Email" required="" type="email" value=""/>
      </div>
      <input class="button btn-subscribe w-button" type="submit" value="Download Report"/>
     </form>
    </div>
    <div class="subscribe-bottom-text">
     By clicking Subscribe, you confirm to have read Our
     <!-- -->
     <a class="inline-link-on-dark" href="/privacy">
      terms and services
     </a>
    </div>
   </div>
  </div>
 </div>
 <div class="section-dark-bg-scale" data-parallax="true" data-parallax-end="center center" data-parallax-scale="0.9,1">
 </div>
</div>

