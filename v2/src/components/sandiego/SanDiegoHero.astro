     <div class="product-container">
      <div class="product-phone-image-holder" style="cursor: pointer;" title="Nhấp chuột hoặc cuộn trang để chuyển đổi màn hình điện thoại">
       <img alt="San Diego app on iPhone" class="product-phone-image" loading="lazy" sizes="(max-width: 1279px) 100vw, 1313.5px" src="/images/Holding-iPhone.webp" srcset="/images/Holding-iPhone-p-500.png 500w, /images/Holding-iPhone-p-800.png 800w, /images/Holding-iPhone-p-1080.png 1080w, /images/Holding-iPhone-p-1600.png 1600w, /images/Holding-iPhone-p-2000.png 2000w, /images/Holding-iPhone.webp 2475w"/>
       <div class="product-phone-content">
        <img alt="San Diego App Screen 1" class="product-phone-demo-image _1" loading="lazy" src="/images/SD-App.svg"/>
        <img alt="San Diego App Screen 2" class="product-phone-demo-image _2" loading="lazy" sizes="(max-width: 479px) 100vw, 554px" src="/images/App2.webp" srcset="/images/App2-p-500.jpg 500w, /images/App2-p-800.jpg 800w, /images/App2.webp 1020w"/>
        <img alt="iPhone Lock Screen" class="iphone-lock-screen-image" loading="lazy" sizes="(max-width: 479px) 100vw, 554px" src="/images/LockScreen.webp" srcset="/images/LockScreen-p-500.jpg 500w, /images/LockScreen-p-800.jpg 800w, /images/LockScreen.webp 1020w"/>
