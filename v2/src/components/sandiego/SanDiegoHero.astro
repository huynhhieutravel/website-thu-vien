     </div>
     <div class="download-button">
      <a class="button black-button w-inline-block" href="https://play.google.com/store/apps" rel="noreferrer" target="_blank">
       <img alt="" class="download-button-icon" loading="lazy" src="/images/Android-Icon.svg"/>
       <div>
        <span class="hide-on-mobile">
         Download for
        </span>
        Android
       </div>
      </a>
     </div>
    </div>
   </div>
  </div>
 </div>
 <div class="home-hero-container">
  <div class="hero-text-sticky">
   <div class="hero-text-holder">
    <div class="hero-text-holder-1">
     <h1 class="hero-text _1">
      Meet
     </h1>
     <div class="hero-text-white-gradient white-gradient-on-right">
