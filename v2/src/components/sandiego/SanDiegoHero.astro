  </div>
 </div>
</div>

<!-- Video Modal Player (Exact Replica) -->
<div id="sd-video-modal" role="dialog" aria-modal="true" aria-label="Video player" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/80 p-4 backdrop-blur-sm" style="display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.82); backdrop-filter: blur(8px); align-items: center; justify-content: center; padding: 16px;">
  <div class="relative w-full max-w-4xl" style="position: relative; width: 100%; max-width: 880px;">
    <button type="button" id="sd-close-video" aria-label="Close video" class="absolute -top-12 right-0 flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus:outline-none" style="position: absolute; top: -48px; right: 0; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; cursor: pointer;">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
    <div style="position: relative; aspect-ratio: 16/9; width: 100%; overflow: hidden; border-radius: 16px; background: #000; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7);">
      <iframe id="sd-video-iframe" src="" title="San Diego Video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0;"></iframe>
    </div>
  </div>
</div>

<style>
  /* Play Me Marquee Animation */
  @keyframes marqueeLeft {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .play-me-holder {
    display: flex !important;
    width: 200% !important;
    animation: marqueeLeft 14s linear infinite !important;
  }
  .play-me-holder:hover {
    animation-play-state: paused !important;
  }
  .product-phone-image-holder {
    user-select: none;
    -webkit-user-select: none;
  }
</style>

<script is:inline>
(function() {
  function initSanDiegoHero() {
    const heroDemo = document.querySelector('.hero-product-demo');
    const heroContainer = document.querySelector('.home-hero-container');
    const lockScreenImg = document.querySelector('.iphone-lock-screen-image');
    const app1Img = document.querySelector('.product-phone-demo-image._1');
    const app2Img = document.querySelector('.product-phone-demo-image._2');
    const hero1 = document.querySelector('.hero-text-holder-1');
    const hero2 = document.querySelector('.hero-text-holder-2');
    const heroLine = document.querySelector('.hero-text-line');
    const heroTextHolder = document.querySelector('.hero-text-holder');
    const playBtn = document.getElementById('sandiego-play-btn') || document.querySelector('.play-icon-holder');
    const gradientBox = document.querySelector('.hero-gradient-box');
    const playMeHolder = document.querySelector('.play-me-holder');
    const phoneHolder = document.querySelector('.product-phone-image-holder');

    if (!heroDemo || typeof gsap === 'undefined') {
      setTimeout(initSanDiegoHero, 50);
      return;
    }

    if (typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
    }

    // Set Initial GSAP States (khớp 1-to-1 mã gốc Webflow / Next.js)
    if (app2Img) gsap.set(app2Img, { xPercent: 100 });
    if (app1Img) gsap.set(app1Img, { xPercent: 0 });
    if (lockScreenImg) gsap.set(lockScreenImg, { yPercent: 0 });
    if (hero1) gsap.set(hero1, { x: 0 });
    if (hero2) gsap.set(hero2, { x: 0 });
    if (heroLine) gsap.set(heroLine, { opacity: 1 });
    if (playBtn) gsap.set(playBtn, { opacity: 0, pointerEvents: 'none' });
    if (gradientBox) gsap.set(gradientBox, { width: "120%" });
    if (playMeHolder) gsap.set(playMeHolder, { opacity: 0 });

    // Timeline GSAP nguyên bản với 100 duration units
    const tl = gsap.timeline({ paused: true, defaults: { ease: "none" } });
    if (app2Img) tl.to(app2Img, { xPercent: 0, duration: 15 }, 42);
    if (app1Img) tl.to(app1Img, { xPercent: -10, duration: 15 }, 42);
    if (lockScreenImg) tl.to(lockScreenImg, { yPercent: -100, duration: 18 }, 24);
    if (hero1) tl.to(hero1, { x: -150, duration: 9 }, 20).to(hero1, { x: -120, duration: 36 }, 29).to(hero1, { x: 0, duration: 35 }, 65);
    if (hero2) tl.to(hero2, { x: 150, duration: 9 }, 20).to(hero2, { x: 120, duration: 36 }, 29).to(hero2, { x: 0, duration: 35 }, 65);
    if (heroLine) tl.to(heroLine, { opacity: 0, duration: 9 }, 20);
    if (playBtn) {
      tl.to(playBtn, {
        opacity: 1,
        duration: 8,
        ease: "power1.out",
        onUpdate: function() {
          const op = gsap.getProperty(playBtn, "opacity");
          playBtn.style.pointerEvents = op > 0.3 ? 'auto' : 'none';
        }
      }, 57);
    }
    if (gradientBox) tl.to(gradientBox, { width: "90%", duration: 8 }, 57);
    if (playMeHolder) tl.to(playMeHolder, { opacity: 1, duration: 5 }, 65);
    if (heroTextHolder) tl.to(heroTextHolder, { opacity: 0, duration: 5 }, 65).to(heroTextHolder, { opacity: 1, duration: 5 }, 90);

    // Ticker với lerp 0.5 khớp chuẩn gốc
    const lerpState = { target: 0, current: 0 };
    let isManualOverride = false;
    let manualTimeout = null;
    let manualIndex = 0;

    const tickerFn = () => {
      if (isManualOverride) return;
      const diff = lerpState.target - lerpState.current;
      if (Math.abs(diff) < 0.0001) {
        if (lerpState.current !== lerpState.target) {
          lerpState.current = lerpState.target;
          tl.progress(lerpState.current);
        }
        return;
      }
      lerpState.current += 0.5 * diff;
      tl.progress(lerpState.current);
    };
    gsap.ticker.add(tickerFn);

    // ScrollTrigger chuẩn gốc: start "top bottom", end "bottom top"
    if (typeof ScrollTrigger !== 'undefined') {
      ScrollTrigger.create({
        trigger: heroDemo,
        start: "top bottom",
        end: "bottom top",
        onUpdate: self => {
          if (!isManualOverride) {
            lerpState.target = self.progress;
          }
        }
      });
    }

    // Play Me marquee vô tận (Infinite Marquee)
    const marquee1 = document.querySelector('.play-me-holder-text._1');
    const marquee2 = document.querySelector('.play-me-holder-text._2');
    if (marquee1 && marquee2) {
      gsap.set([marquee1, marquee2], { xPercent: 0 });
      gsap.timeline({ repeat: -1, defaults: { ease: "none" } })
        .to(marquee1, { xPercent: -100, duration: 25 }, 0)
        .to(marquee2, { xPercent: -100, duration: 25 }, 0)
        .set(marquee1, { xPercent: 100 }, 25)
        .to(marquee1, { xPercent: 0, duration: 25 }, 25)
        .to(marquee2, { xPercent: -200, duration: 25 }, 25)
        .set(marquee2, { xPercent: 0 }, 50);
    }

    // Click vào điện thoại để chuyển màn hình ngay tức thì
    if (phoneHolder) {
      phoneHolder.addEventListener('click', (e) => {
        if (e.target.closest('#sandiego-play-btn')) return;

        isManualOverride = true;
        clearTimeout(manualTimeout);

        manualIndex = (manualIndex + 1) % 3;
        let targetProgressVal = 0;
        if (manualIndex === 0) {
          targetProgressVal = 0; // Lock Screen
        } else if (manualIndex === 1) {
          targetProgressVal = 0.38; // App 1
        } else {
          targetProgressVal = 0.65; // App 2 + Play Button
        }

        gsap.to(tl, {
          progress: targetProgressVal,
          duration: 0.6,
          ease: "power2.out"
        });

        // Sau 4 giây tự động trở lại theo vị trí cuộn
        manualTimeout = setTimeout(() => {
          isManualOverride = false;
        }, 4000);
      });
    }

    // Video Modal Player
    const videoModal = document.getElementById('sd-video-modal');
    const videoIframe = document.getElementById('sd-video-iframe');
    const closeVideoBtn = document.getElementById('sd-close-video');
    const youtubeUrl = 'https://www.youtube.com/embed/sWRUzxINCoA?autoplay=1&rel=0';

    function openVideoModal() {
      if (videoModal && videoIframe) {
        videoIframe.src = youtubeUrl;
        videoModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    }

    function closeVideoModal() {
      if (videoModal && videoIframe) {
        videoIframe.src = '';
        videoModal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    if (playBtn) {
      playBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openVideoModal();
      });
    }

    const marqueeTextEls = document.querySelectorAll('.play-me-text');
    marqueeTextEls.forEach(el => {
      el.style.cursor = 'pointer';
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openVideoModal();
      });
    });

    if (closeVideoBtn) closeVideoBtn.addEventListener('click', closeVideoModal);
    if (videoModal) {
      videoModal.addEventListener('click', (e) => {
        if (e.target === videoModal) closeVideoModal();
      });
    }
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && videoModal && videoModal.style.display !== 'none') {
        closeVideoModal();
      }
    });
  }

  // Khởi động khi DOM sẵn sàng
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSanDiegoHero);
  } else {
    initSanDiegoHero();
  }
})();
</script>
