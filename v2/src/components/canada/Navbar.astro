---
// v2/src/components/canada/Navbar.astro
import rawNavbar from '../../raw/canada-navbar.html?raw';

const navbarHtml = rawNavbar
  .replace('href="/"', 'href="/canada"')
  .replace('href="/projects"', 'href="/canada/projects"')
  .replace('href="/blog"', 'href="/canada/blog"')
  .replace('href="/about"', 'href="/canada/about"')
  .replace('href="/shop"', 'href="/canada/shop"')
  .replace('href="/contact"', 'href="/canada/contact"');
---

<Fragment set:html={navbarHtml} />

