---
// v2/src/layouts/KuroLayout.astro - Dedicated Layout for Kuro Cold Brew Coffee
interface Props {
  title?: string;
  description?: string;
  isOriginal?: boolean;
}

const {
  title = "Kuro — Craft Cold Brew & Botanical Lattes",
  description = "Slow-steeped craft cold brew and botanical lattes. Roasted in small batches, infused with real spices and organic botanicals.",
  isOriginal = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" data-next-head="" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" data-next-head="" />
    <title data-next-head="">{title}</title>
    <meta name="description" content={description} data-next-head="" />
    <meta property="og:site_name" content="Kuro" data-next-head="" />
    <meta property="og:title" content={title} data-next-head="" />
    <meta property="og:description" content={description} data-next-head="" />
    <meta property="og:type" content="website" data-next-head="" />
    <meta property="og:image" content="/images/kuro-thumb-16x9.jpg" data-next-head="" />
    <meta name="twitter:card" content="summary_large_image" data-next-head="" />
    <meta name="twitter:title" content={title} data-next-head="" />
    <meta name="twitter:description" content={description} data-next-head="" />
    <meta name="twitter:image" content="/images/kuro-thumb-16x9.jpg" data-next-head="" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#15110D" />
    <meta name="color-scheme" content="dark" />

    <!-- Google Fonts & Preload Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=Manrope:wght@300;400;500;600;700;800&family=Geist+Mono:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/_next/static/media/a343f882a40d2cc9-s.p.0kho-wj7-y-w1.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    <link rel="preload" href="/_next/static/media/54fc36028e2bb174-s.p.0nkps02--w45i.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    <link rel="preload" href="/_next/static/media/797e433ab948586e-s.p.08e28id.o-okb.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    
    <style is:inline>
      :root {
        --font-app-sans: 'Manrope', 'Manrope Fallback', sans-serif;
        --font-app-mono: 'Geist Mono', 'Geist Mono Fallback', monospace;
        --font-app-heading: 'Fraunces', 'Fraunces Fallback', serif;
      }
    </style>

    <!-- Kuro Design System CSS -->
    <link rel="stylesheet" href="/_next/static/chunks/0a77ce~~mvr7m.css" data-n-g="" />
    <noscript data-n-css=""></noscript>



    <style is:global>
      body {
        padding-top: 40px !important;
      }
      .fixed.inset-x-0.top-0 {
        top: 40px !important;
      }
      [data-modulify-badge] {
        display: none !important;
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 7px;
      }
      ::-webkit-scrollbar-track {
        background: #15110D;
      }
      ::-webkit-scrollbar-thumb {
        background: rgba(235, 230, 220, 0.2);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #d97706;
      }
    </style>
      <!-- Image Loader Normalizer for Static Hosting -->
    <script is:inline>
      (function() {
        function cleanUrl(val) {
          if (typeof val === "string" && val.includes("/_next/image?url=")) {
            if (val.includes(",")) {
              return val.replace(/\/_next\/image\?url=([%a-zA-Z0-9_\-\.\/]+)(?:&amp;|&)[^,\s>]+/g, function(m, u) {
                return decodeURIComponent(u);
              });
            }
            var m = val.match(/url=([^&]+)/);
            if (m) {
              return decodeURIComponent(m[1]);
            }
          }
          return val;
        }

        var origSet = HTMLImageElement.prototype.setAttribute;
        HTMLImageElement.prototype.setAttribute = function(name, val) {
          if (name === "src" || name === "srcset" || name === "srcSet") {
            val = cleanUrl(val);
          }
          return origSet.call(this, name, val);
        };

        var srcDesc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, "src");
        if (srcDesc && srcDesc.set) {
          Object.defineProperty(HTMLImageElement.prototype, "src", {
            get: srcDesc.get,
            set: function(val) {
              return srcDesc.set.call(this, cleanUrl(val));
            },
            configurable: true,
            enumerable: true
          });
        }

        var srcsetDesc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, "srcset");
        if (srcsetDesc && srcsetDesc.set) {
          Object.defineProperty(HTMLImageElement.prototype, "srcset", {
            get: srcsetDesc.get,
            set: function(val) {
              return srcsetDesc.set.call(this, cleanUrl(val));
            },
            configurable: true,
            enumerable: true
          });
        }
      })();
    </script>
  </head>

  <body class="min-h-full flex flex-col bg-background text-foreground antialiased">
    <!-- Top Bar Navigation quay lại Thư Viện -->
    <aside style="position:fixed;top:0;left:0;right:0;z-index:9999;background:rgba(21,17,13,0.96);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,0.12);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;font-size:11px;text-transform:uppercase;letter-spacing:0.18em;font-family:sans-serif;">
      <a href="/" style="color:#d97706;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>← Về Trang Chủ Thư Viện</span>
      </a>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="background:rgba(217,119,6,0.14);border:1px solid rgba(217,119,6,0.3);padding:3px 12px;border-radius:9999px;color:#d97706;font-size:10px;font-weight:700;">
          {isOriginal ? "Mục 10: Bản Clone Gốc (HTML / JS / Coffee)" : "Phiên Bản: Astro Code Native (Component Hóa)"}
        </span>
        {isOriginal ? (
          <a href="/kuro" style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.2);padding-left:12px;" title="Xem Bản Astro Code">
            Xem Bản Astro Code ↗
          </a>
        ) : (
          <a href="/kuro-original" style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.2);padding-left:12px;" title="Xem Bản Gốc">
            Xem Bản Gốc ↗
          </a>
        )}
      </div>
    </aside>

    <div id="__next">
      <div class="h-full font-sans">
        <div class="flex min-h-screen flex-col">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
