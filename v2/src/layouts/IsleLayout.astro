---
// v2/src/layouts/IsleLayout.astro - Website 29: Isle — Liquid Glass Layout
import IsleHeader from '../components/isle/IsleHeader.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "Isle — Liquid Glass",
  description = "An island of real glass that refracts the world behind it and springs open like a droplet. Bend the light.",
  currentPath = "/isle",
} = Astro.props;

const originalPath = currentPath === "/isle"
  ? "/isle-original"
  : currentPath === "/isle/about"
    ? "/isle-original/about"
    : "/isle-original/contact";
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#060810] text-white">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/_next/static/chunks/0-9rcqvg4159e.css" />
  <link rel="stylesheet" href="/_next/static/chunks/0cvcj6u5y~.b7.css" />
  <link rel="stylesheet" href="/_next/static/chunks/0xh_oq1wx-4pv.css" />

  <style is:global>
    :root {
      --isl-ink: #fffffff2;
      --isl-ink-2: #ffffff99;
      --isl-fill: #ffffff29;
      --isl-fill-2: #ffffff38;
      --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, sans-serif;
    }
    body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      background-color: #060810;
      color: #ffffff;
      font-family: var(--font-sans);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    .isl-ink {
      color: var(--isl-ink);
      transition: color 0.35s ease;
    }
    .isl-ink-2 {
      color: var(--isl-ink-2);
      transition: color 0.35s ease;
    }
    .isl-ink-bg {
      background: var(--isl-ink);
      transition: background 0.35s ease;
    }
    .isl-track-bg {
      background: var(--isl-fill);
      transition: background 0.35s ease;
    }
    .isl-thumb {
      background: var(--isl-ink);
      transition: background 0.35s ease;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35), 0 0 0 0.5px rgba(255, 255, 255, 0.3);
    }
    .isl-btn {
      background: var(--isl-fill);
      transition: background 0.25s ease, transform 0.18s ease;
      box-shadow: inset 0 0.5px rgba(255, 255, 255, 0.18);
    }
    .isl-btn:hover {
      background: var(--isl-fill-2);
    }
    .isl-btn:active {
      transform: scale(0.93);
    }
    .isl-btn-primary {
      background: var(--isl-fill-2);
    }
    .isl-dock-btn {
      transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s ease;
    }
    .isl-dock-btn:hover {
      transform: scale(1.1);
    }
    .isl-dock-btn:active {
      transform: scale(0.96);
    }
    .isl-cfg-btn {
      background: transparent;
      transition: background 0.2s ease, color 0.2s ease;
    }
    .isl-cfg-btn:hover {
      background: var(--isl-fill);
      color: var(--isl-ink);
    }
    @keyframes isl-pop {
      0% { transform: scale(0.85); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .isl-track-pop {
      animation: 0.32s cubic-bezier(0.17, 0.89, 0.24, 1.11) isl-pop;
    }
  </style>
</head>
<body class="relative min-h-screen w-full bg-[#060810] text-white selection:bg-white/20">
  <!-- Top Bar Navigation quay lại Thư Viện -->
  <aside style="position:fixed;top:0;left:0;right:0;height:36px;z-index:999999;background:rgba(6,8,16,0.92);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.08);padding:0 20px;display:flex;align-items:center;justify-content:space-between;font-size:11px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;letter-spacing:0.12em;text-transform:uppercase;color:#f6efe2;">
    <a href="/" style="color:#f6efe2;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      <span>← Về Trang Chủ Thư Viện</span>
    </a>
    <div style="display:flex;align-items:center;gap:14px;">
      <span style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);padding:3px 12px;border-radius:9999px;font-weight:700;color:#f6efe2;font-size:10px;">
        Phiên bản: Astro Code Native (Component Hóa)
      </span>
      <a href={originalPath} style="color:rgba(246,239,226,0.7);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.18);padding-left:12px;" title="Xem Bản Gốc 1-to-1">
        Xem Bản Gốc ↗
      </a>
    </div>
  </aside>

  <!-- Floating Navigation -->
  <IsleHeader currentPath={currentPath} />

  <!-- Page Content -->
  <slot />
</body>
</html>

