---
// v2/src/layouts/LightLayout.astro
// Layout giao diện Light Theme siêu nhẹ, sạch sẽ, chuẩn thiết kế cao cấp
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Thư Viện Website & Template Đã Tạo | Website Archive Hub",
  description = "Kho lưu trữ và sơ đồ danh mục các website đã clone và chuyển đổi mã nguồn Astro."
} = Astro.props;
---

<!doctype html>
<html lang="vi" class="h-full bg-slate-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts Inter & Manrope -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Override Dark Variables with Clean Light Theme Design System -->
    <style is:global>
      :root {
        --color-background: #f8fafc !important;
        --color-foreground: #0f172a !important;
        --background: #f8fafc !important;
        --foreground: #0f172a !important;
      }
      html, body {
        background-color: #f8fafc !important;
        color: #0f172a !important;
        font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
      }
      /* Custom fine-tuned card shadows */
      .light-card-shadow {
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 10px 25px -5px rgba(0, 0, 0, 0.04) !important;
      }
      .light-card-shadow:hover {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.06), 0 20px 35px -10px rgba(0, 0, 0, 0.08) !important;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 text-slate-800 font-sans antialiased">
    <slot />
  </body>
</html>
