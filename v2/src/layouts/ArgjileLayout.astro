---
// v2/src/layouts/ArgjileLayout.astro - Dedicated Layout for ARGJILË Ceramic Studio
interface Props {
  title?: string;
  description?: string;
  isOriginal?: boolean;
}

const {
  title = "ARGJILË Ceramic Studio — Handmade Ceramics & Pottery | Prishtina",
  description = "A small ceramic studio in Prishtina throwing cups, bowls and vases by hand, one at a time. Shop the collection or book a session at the wheel.",
  isOriginal = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/argjile-thumb-16x9.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/argjile-thumb-16x9.jpg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#EDE6DA" />

    <!-- Google Fonts & Next.js Preload Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:ital,wght@0,300..700;1,300..700&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/_next/static/media/ab57efd000576a30-s.p.0.xyi-bdzzdcz.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    <link rel="preload" href="/_next/static/media/7546fe8f902b88b8-s.p.0ezg~kdx4q-_h.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    <link rel="preload" href="/_next/static/media/36363bfb06833f56-s.p.0-pny06~-x26a.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    <link rel="preload" href="/_next/static/media/a73419dd2ba2d841-s.p.0x-0vqtj_fzf1.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    <link rel="preload" href="/_next/static/media/7ebf22b5a21034f8-s.p.10_7676vm7pyy.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    <link rel="preload" href="/_next/static/media/e41d5df559864f9e-s.p.0gq7fw9.sy_5..woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    
    <!-- Argjile Design System CSS -->
    <link rel="stylesheet" href="/_next/static/chunks/0yhwm3_wbjq96.css" />



    <style is:global>
      :root {
        --font-app-sans: 'Inter Tight', sans-serif;
        --font-app-mono: 'DM Mono', monospace;
        --font-app-heading: 'Instrument Serif', serif;
      }

      body {
        padding-top: 40px !important;
      }
      header.fixed {
        top: 40px !important;
      }
      [data-modulify-badge] {
        display: none !important;
      }

      /* Custom artisan scrollbar */
      ::-webkit-scrollbar {
        width: 7px;
      }
      ::-webkit-scrollbar-track {
        background: #1b1714;
      }
      ::-webkit-scrollbar-thumb {
        background: #a8553a;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #c49a76;
      }
    </style>
  </head>

  <body class="min-h-screen bg-bone text-charcoal antialiased selection:bg-terracotta selection:text-bone">
    <!-- Top Bar Navigation quay lại Thư Viện -->
    <aside style="position:fixed;top:0;left:0;right:0;z-index:9999;background:rgba(27,23,20,0.96);backdrop-filter:blur(14px);border-bottom:1px solid rgba(237,230,218,0.12);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;font-size:11px;text-transform:uppercase;letter-spacing:0.18em;font-family:sans-serif;">
      <a href="/" style="color:#c49a76;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>← Về Trang Chủ Thư Viện</span>
      </a>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="background:rgba(196,154,118,0.14);border:1px solid rgba(196,154,118,0.3);padding:3px 12px;border-radius:9999px;color:#c49a76;font-size:10px;font-weight:700;">
          {isOriginal ? "Mục 07: Bản Clone Gốc (HTML / JS)" : "Phiên Bản: Astro Code Native (Component Hóa)"}
        </span>
        {isOriginal ? (
          <a href="/argjile" style="color:rgba(237,230,218,0.7);text-decoration:none;font-size:10px;border-left:1px solid rgba(237,230,218,0.2);padding-left:12px;" title="Xem Bản Astro Code">
            Xem Bản Astro Code ↗
          </a>
        ) : (
          <a href="/argjile-original" style="color:rgba(237,230,218,0.7);text-decoration:none;font-size:10px;border-left:1px solid rgba(237,230,218,0.2);padding-left:12px;" title="Xem Bản Gốc">
            Xem Bản Gốc ↗
          </a>
        )}
      </div>
    </aside>

    <div id="__next">
      <div class="h-full font-sans">
        <div class="flex min-h-screen flex-col">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
