        --font-app-mono: 'DM Mono', monospace;
        --font-app-heading: 'Instrument Serif', serif;
      }

      body {
        padding-top: 40px !important;
      }
      header.fixed {
        top: 40px !important;
      }
      [data-modulify-badge] {
        display: none !important;
      }

