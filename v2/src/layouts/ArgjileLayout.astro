    <script is:inline id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"pieces":[{"id":"9c0c1392-6416-4a8c-83ea-334a57fe6775","slug":"dune-vase","number":1,"name":"Dune Vase","category":"vases","glazeName":"Celadon","glazeColor":"#B4C4A9","rimColor":null,"form":"vase","finish":"satin","speckled":false,"price":86,"dimensions":"Ø 150 × 260 mm","weight":"1.4 kg","description":"A tall, bottle-shaped vase with a low, heavy belly and a neck pulled narrow enough to hold a single branch upright. The celadon pools pale green in every throwing ring and thins to cream where the shoulder turns. It stands steady on a deep, unglazed foot.","materialNotes":["Wheel-thrown stoneware","Celadon satin glaze, inside and out","Watertight","Unglazed foot ring","Hand-wash only"],"careNote":"Rinse with warm water and a soft brush, then dry upside down so the foot can breathe.","batchSize":14,"stock":6,"releasedAt":"2026-09-12"},{"id":"c62f7ad6-ef78-4f2b-ae49-d59d12800d68","slug":"tide-bowl","number":2,"name":"Tide Bowl","category":"bowls","glazeName":"Bone white, brown rim","glazeColor":"#EAE2D0","rimColor":"#8A6346","form":"bowl","finish":"gloss","speckled":false,"price":58,"dimensions":"Ø 220 × 90 mm","weight":"0.9 kg","description":"A wide, shallow serving bowl that opens like a shoreline, made for salads, fruit or a shared plate of pasta. The bone white glaze stops just short of the edge, where the soft brown of the clay shows through. Every rim is finished by hand, so each one dips a little differently.","materialNotes":["Wheel-thrown stoneware","Bone white gloss glaze, bare brown rim","Food-safe","Dishwasher-safe"],"careNote":"Dishwasher-safe on a gentle cycle. Skip scouring pads on the bare rim, a soft cloth keeps it smooth.","batchSize":14,"stock":6,"releasedAt":"2026-09-26"},{"id":"46688f4d-80e1-404c-bd6c-c1597ed6c195","slug":"ember-cup","number":3,"name":"Ember Cup","category":"cups","glazeName":"Oxide brown","glazeColor":"#4E2A18","rimColor":"#B5603C","form":"cup","finish":"gloss","speckled":false,"price":32,"dimensions":"Ø 85 × 95 mm","weight":"0.3 kg","description":"A straight-sided cup that sits warm in the hand, sized for a long coffee or a pot of tea poured slowly. The oxide brown glaze breaks to warm terracotta at the rim, where iron rises through the firing. No handle, just a thick wall that holds the heat.","materialNotes":["Wheel-thrown stoneware","Iron oxide gloss glaze","Holds 250 ml","Food-safe","Dishwasher and microwave safe"],"careNote":"Dishwasher and microwave safe. Let it cool before rinsing in cold water, stoneware dislikes sudden changes.","batchSize":14,"stock":6,"releasedAt":"2026-10-03"},{"id":"7dacd408-42fb-40e2-8024-8c080f57d47c","slug":"hollow-jug","number":4,"name":"Hollow Jug","category":"vases","glazeName":"Charcoal black","glazeColor":"#1F1B19","rimColor":null,"form":"jug","finish":"matte","speckled":false,"price":74,"dimensions":"Ø 160 × 210 mm","weight":"1.2 kg","description":"A round-bellied jug with a pinched spout and a handle pulled by hand, the kind of piece that ends up living on the table. Soft charcoal black outside and glossy inside, so it rinses clean. It pours water without a drip and holds an armful of wild flowers just as well.","materialNotes":["Wheel-thrown stoneware, hand-pulled handle","Matte charcoal glaze outside, clear gloss inside","Holds 1 litre","Food-safe","Hand-wash recommended"],"careNote":"Hand-wash to keep the matte surface soft. A drop of oil on a cloth brings back its depth.","batchSize":14,"stock":6,"releasedAt":"2026-08-29"},{"id":"2dd91cd5-9d71-43e1-a103-5e8c7d8eda2a","slug":"lull-plate","number":5,"name":"Lull Plate","category":"plates","glazeName":"Terracotta","glazeColor":"#A8553A","rimColor":null,"form":"plate","finish":"satin","speckled":false,"price":48,"dimensions":"Ø 260 × 25 mm","weight":"0.8 kg","description":"A flat dinner plate with a gently raised rim that keeps sauces where they belong. The terracotta glaze is fired to a soft satin, warm under candlelight and quiet on a white tablecloth. Made for slow dinners that run late.","materialNotes":["Wheel-thrown and trimmed stoneware","Terracotta satin glaze","Food-safe","Dishwasher-safe"],"careNote":"Dishwasher-safe. If you stack them for years, a napkin between plates keeps the glaze unmarked.","batchSize":14,"stock":6,"releasedAt":"2026-09-19"},{"id":"6ef44889-71cc-407c-b67c-dc81ceb57524","slug":"stem-bottle","number":6,"name":"Stem Bottle","category":"vases","glazeName":"Speckled cream","glazeColor":"#E6DCC4","rimColor":null,"form":"bottle","finish":"satin","speckled":true,"price":64,"dimensions":"Ø 70 × 230 mm","weight":"0.6 kg","description":"A slim bottle for a single stem, thrown in two parts and joined at the shoulder. The speckles are iron in the clay rising through the cream glaze in the kiln, so no two bottles carry the same pattern. It looks finished even when it stands empty.","materialNotes":["Speckled stoneware, thrown in two parts","Cream satin glaze","Watertight","Hand-wash only"],"careNote":"Rinse with a bottle brush and dry upside down. Fresh water every two days keeps a stem longer.","batchSize":14,"stock":6,"releasedAt":"2026-10-01"}],"workshops":[{"id":"9653321c-34bf-4ef6-ae77-65bb0828b1df","slug":"intro-to-the-wheel","name":"Intro to the Wheel","duration":"2 hours","price":55,"priceNote":"per person","description":"Two hours on a wheel of your own. We centre, open and pull together until something stands up by itself, then trim, glaze and fire your favourite piece for you.","capacity":8,"spotsLeft":3,"spotLabel":"places","nextSession":"2026-10-17T08:00:00.000Z","nextSessionLabel":null},{"id":"5a271497-26a0-428d-8b68-3aef378b4038","slug":"date-night-throw","name":"Date Night Throw","duration":"2.5 hours","price":120,"priceNote":"per pair","description":"A slow evening for two: a wheel each, a pot of mountain tea and one teacher moving quietly between you. Bring someone who does not mind clay on their sleeve.","capacity":5,"spotsLeft":2,"spotLabel":"pairs","nextSession":"2026-10-23T17:00:00.000Z","nextSessionLabel":null},{"id":"dbb9ebfd-5837-45a9-bd5f-fa4bfa97c237","slug":"private-masterclass","name":"Private Masterclass","duration":"4 hours","price":240,"priceNote":"one to one","description":"Four hours with our head potter, shaped around what you want to make. Taller walls, wider plates, cleaner trimming: we work on your hands, not a lesson plan.","capacity":2,"spotsLeft":1,"spotLabel":"sessions","nextSession":"2026-11-03T09:00:00.000Z","nextSessionLabel":"Tue 3 Nov · 10:00"}]},"__N_SSG":true},"page":"/","query":{},"buildId":"Uecj9S-bVRC9A7kgWcD1M","isFallback":false,"isExperimentalCompile":false,"gsp":true,"scriptLoader":[]}</script>

