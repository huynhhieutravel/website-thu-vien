---
// v2/src/layouts/PaceLayout.astro - Dedicated Layout for PACE Smart Band (Astro Code Native)
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PACE Band — Screenless Smart Health Band",
  description = "A screenless titanium smart band that decodes your heart, sleep, recovery and training load around the clock. Grade 5 titanium, woven comfort and a full performance dashboard, with no subscription.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" data-next-head="" />
    <meta name="viewport" content="width=device-width, initial-scale=1" data-next-head="" />
    <title>{title}</title>
    <meta name="description" content={description} data-next-head="" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Google Fonts & Preloads -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/_next/static/media/21ca8f3f56c22ca2-s.p.0fmzj955937qe.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    <link rel="preload" href="/_next/static/media/70bc3e132a0a741e-s.p.1409xf.ylxg8g.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    
    <!-- PACE Design System CSS -->
    <link rel="stylesheet" href="/_next/static/chunks/0c37tlhoz_s48.css" data-n-g="" />



    <!-- Local Image Path Interceptor -->
    <script is:inline>
      (function() {
        const origSet = HTMLImageElement.prototype.setAttribute;
        HTMLImageElement.prototype.setAttribute = function(name, val) {
          if (typeof val === "string" && val.includes("/_next/image?url=")) {
            const match = val.match(/url=([^&]+)/);
            if (match) {
              val = decodeURIComponent(match[1]).replace(/^\/images\//, "/images/pace/");
            }
          }
          return origSet.call(this, name, val);
        };
      })();
    </script>

    <style is:global>
      :root {
        --font-app-sans: 'Archivo', 'Archivo Fallback', sans-serif;
        --font-app-mono: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
        --font-app-heading: 'Archivo', 'Archivo Fallback', sans-serif;
      }

      body {
        padding-top: 40px !important;
      }
      header.fixed {
        top: 40px !important;
      }

      [data-modulify-badge] {
        display: none !important;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col">
    <!-- Top Bar Navigation quay lại Thư Viện -->
    <aside style="position:fixed;top:0;left:0;right:0;z-index:9999;background:rgba(9,11,14,0.95);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,0.1);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;font-size:11px;text-transform:uppercase;letter-spacing:0.18em;font-family:sans-serif;">
      <a href="/" style="color:#00d984;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
        <span>← Về Trang Chủ Thư Viện</span>
      </a>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="background:rgba(0,217,132,0.12);border:1px solid rgba(0,217,132,0.3);padding:3px 12px;border-radius:9999px;color:#00d984;font-size:10px;font-weight:700;">
          Phiên Bản: Astro Code Native (Component Hóa)
        </span>
        <a href="/pace-original" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.2);padding-left:12px;" title="Xem Bản Gốc">
          Xem Bản Gốc ↗
        </a>
      </div>
    </aside>

    <div id="__next">
      <div class="flex min-h-full flex-1 flex-col font-sans">
        <a href="#main" class="sr-only z-[60] rounded-full bg-ink px-5 py-3 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4">
          Skip to content
        </a>

        <slot />
      </div>
    </div>
  </body>
</html>
