---
// v2/src/layouts/OrvaneLayout.astro - Dedicated Layout for Orvane Autonomous LiDAR Drones (Astro Native)
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Orvane — Autonomous LiDAR Drones | Astro Native",
  description = "Self-flying LiDAR drones that measure bridges, power lines, turbines and terrain to the centimetre and catch structural risks early.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f8f8" />

    <!-- Google Fonts & Preloads -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link as="font" crossorigin="anonymous" href="/_next/static/media/ab57efd000576a30-s.p.0.xyi-bdzzdcz.woff2" rel="preload" type="font/woff2" />
    <link as="font" crossorigin="anonymous" href="/_next/static/media/70bc3e132a0a741e-s.p.1409xf.ylxg8g.woff2" rel="preload" type="font/woff2" />

    <link as="style" href="/_next/static/chunks/0hrl7a-ajzz6g.css" rel="preload" />
    <link href="/_next/static/chunks/0hrl7a-ajzz6g.css" rel="stylesheet" />

    <script is:inline>document.documentElement.classList.add('js')</script>

    <style is:global>
      :root {
        --font-app-sans: 'Inter Tight', 'Inter Tight Fallback', sans-serif;
        --font-app-mono: 'JetBrains Mono', 'JetBrains Mono Fallback', monospace;
        --font-app-heading: 'Inter Tight', 'Inter Tight Fallback', sans-serif;
      }

      body {
        padding-top: 40px !important;
      }
      header.fixed {
        top: 40px !important;
      }
      .preloader {
        top: 40px !important;
      }
      [data-modulify-badge] {
        display: none !important;
      }
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="h-full bg-mist font-sans text-ink antialiased selection:bg-[#5fbfd0]/30 selection:text-ink">
    <div id="__next">
      <div class="h-full font-sans">
        <slot />
      </div>
    </div>

    <!-- Top Bar Navigation quay lại Thư Viện -->
    <aside style="position:fixed;top:0;left:0;right:0;z-index:9999;background:rgba(9,11,14,0.95);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,0.1);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;font-size:11px;text-transform:uppercase;letter-spacing:0.18em;font-family:sans-serif;">
      <a href="/" style="color:#00d984;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
        <span>← Về Trang Chủ Thư Viện</span>
      </a>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="background:rgba(0,217,132,0.12);border:1px solid rgba(0,217,132,0.3);padding:3px 12px;border-radius:9999px;color:#00d984;font-size:10px;font-weight:700;">
          Phiên Bản: Astro Code Native (Component Hóa)
        </span>
        <a href="/orvane-original" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.2);padding-left:12px;" title="Xem Bản Gốc">
          Xem Bản Gốc ↗
        </a>
      </div>
    </aside>

    <!-- Astro Native Interactive Script for Solutions Tabs & Scrollytelling -->
    <script is:inline>
      (function() {
        // Solutions Tabs Interactivity
        const solutionsSec = document.getElementById('solutions');
        if (solutionsSec) {
          const tabList = solutionsSec.querySelector('[role="tablist"]');
          if (tabList) {
            const tabs = tabList.querySelectorAll('button[role="tab"]');
            const indicator = tabList.querySelector('span[aria-hidden="true"]');
            const stepCounter = solutionsSec.querySelector('.label-mono.hidden.text-haze span');
            
            const textCols = solutionsSec.querySelectorAll('.grid.content-start > div');
            const panelCanvases = solutionsSec.querySelectorAll('[data-anchor="solutions-panel"] canvas');
            const panelLabels = solutionsSec.querySelectorAll('[data-anchor="solutions-panel"] .grid span.label-mono');
            const tagLists = solutionsSec.querySelectorAll('.flex.min-h-0.flex-col > .grid > ul');

            function selectTab(index) {
              tabs.forEach((tab, i) => {
                const isSelected = (i === index);
                tab.setAttribute('aria-selected', String(isSelected));
                tab.style.color = isSelected ? '#1d2a31' : '#9aa3a8';
                if (isSelected && indicator) {
                  indicator.style.width = tab.offsetWidth + 'px';
                  indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
                  indicator.style.transition = 'transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), width 0.4s cubic-bezier(0.22, 1, 0.36, 1)';
                }
              });

              if (stepCounter) {
                stepCounter.textContent = `0${index + 1}`;
              }

              textCols.forEach((el, i) => {
                el.style.opacity = (i === index) ? '1' : '0';
                el.style.transition = 'opacity 0.4s ease';
              });

              panelCanvases.forEach((el, i) => {
                el.style.clipPath = (i === index) ? 'none' : 'inset(100% 0% 0% 0%)';
                el.style.transition = 'clip-path 0.5s cubic-bezier(0.65, 0, 0.35, 1)';
              });

              panelLabels.forEach((el, i) => {
                el.style.opacity = (i === index) ? '1' : '0';
                el.style.transition = 'opacity 0.35s ease';
              });

              tagLists.forEach((el, i) => {
                el.style.opacity = (i === index) ? '1' : '0';
                el.style.transition = 'opacity 0.35s ease';
              });
            }

            tabs.forEach((tab, index) => {
              tab.addEventListener('click', () => selectTab(index));
            });

            // Initialize indicator position
            setTimeout(() => {
              selectTab(0);
            }, 500);
          }
        }
      })();
    </script>
  </body>
</html>
