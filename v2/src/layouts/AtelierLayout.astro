---
// v2/src/layouts/AtelierLayout.astro - Dedicated Layout for Atelier (Alex Morgan macOS Desktop Portfolio) (Astro Native)

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const {
  title = "Atelier — Alex Morgan",
  description = "The portfolio of Alex Morgan, an independent product and brand designer, presented as an interactive macOS desktop you can explore.",
  activePath = "/atelier",
} = Astro.props;

const originalPath = "/atelier-original";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Atelier" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/atelier-thumb-16x9.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/atelier-thumb-16x9.jpg" />
    <link rel="icon" type="image/png" href="/favicon-atelier.png" sizes="any" />

    <!-- Atelier Preload Fonts -->
    <link rel="preload" href="/_next/static/media/caa3a2e1cccd8315-s.p.09~u27dqhyhd6.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/_next/static/media/797e433ab948586e-s.p.08e28id.o-okb.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- Atelier Tailwind v4 & Design System Stylesheet -->
    <link rel="stylesheet" href="/_next/static/chunks/0khma9z8blnhv.css" />

    <style is:global>
      body {
        padding-top: 36px !important;
        margin: 0;
        overflow: hidden;
      }

      [data-modulify-badge] {
        display: none !important;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col font-sans antialiased bg-[#1a1612]">
    <!-- Top Bar Navigation quay lại Thư Viện -->
    <aside style="position:fixed;top:0;left:0;right:0;height:36px;z-index:999999;background:rgba(20,18,15,0.94);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.1);padding:0 20px;display:flex;align-items:center;justify-content:space-between;font-size:11px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;letter-spacing:0.12em;text-transform:uppercase;color:#e8e4dc;">
      <a href="/" style="color:#e8e4dc;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        <span>← Về Trang Chủ Thư Viện</span>
      </a>
      <div style="display:flex;align-items:center;gap:14px;">
        <span style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);padding:3px 12px;border-radius:9999px;font-weight:700;color:#f5f0e6;font-size:10px;">
          Phiên Bản: Astro Code Native (Component Hóa)
        </span>
        <a href={originalPath} style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.2);padding-left:12px;" title="Xem Bản Gốc 1-to-1">
          Xem Bản Gốc ↗
        </a>
      </div>
    </aside>

    <div id="__next" class="h-full">
      <slot />
    </div>
  </body>
</html>
