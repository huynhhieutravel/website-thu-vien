---
// v2/src/layouts/HuzzahLayout.astro - Dedicated Layout for Huzzah Creative Agency
interface Props {
  title?: string;
  description?: string;
  isOriginal?: boolean;
}

const {
  title = "Huzzah Studio — Branding & Digital Creative Agency",
  description = "Huzzah Studio is a small, senior creative agency for branding, websites, content and growth marketing. Brand work so good, people actually cheer.",
  isOriginal = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Image Loader Normalizer for Static Hosting (Immediate intercept before any script) -->
    <script is:inline>
      (function() {
        function cleanUrl(val) {
          if (typeof val === "string" && val.includes("/_next/image?url=")) {
            if (val.includes(",")) {
              return val.replace(/\/_next\/image\?url=([%a-zA-Z0-9_\-\.\/]+)(?:&amp;|&)[^,\s>]+/g, function(m, u) {
                return decodeURIComponent(u);
              });
            }
            var m = val.match(/url=([^&]+)/);
            if (m) {
              return decodeURIComponent(m[1]);
            }
          }
          return val;
        }

        var origSet = HTMLImageElement.prototype.setAttribute;
        HTMLImageElement.prototype.setAttribute = function(name, val) {
          if (name === "src" || name === "srcset" || name === "srcSet") {
            val = cleanUrl(val);
          }
          return origSet.call(this, name, val);
        };

        var srcDesc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, "src");
        if (srcDesc && srcDesc.set) {
          Object.defineProperty(HTMLImageElement.prototype, "src", {
            get: srcDesc.get,
            set: function(val) {
              return srcDesc.set.call(this, cleanUrl(val));
            },
            configurable: true,
            enumerable: true
          });
        }

        var srcsetDesc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, "srcset");
        if (srcsetDesc && srcsetDesc.set) {
          Object.defineProperty(HTMLImageElement.prototype, "srcset", {
            get: srcsetDesc.get,
            set: function(val) {
              return srcsetDesc.set.call(this, cleanUrl(val));
            },
            configurable: true,
            enumerable: true
          });
        }
      })();
    </script>

    <meta charset="utf-8" data-next-head="" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" data-next-head="" />
    <title data-next-head="">{title}</title>
    <meta name="description" content={description} data-next-head="" />
    <meta property="og:site_name" content="Huzzah Studio" data-next-head="" />
    <meta property="og:title" content={title} data-next-head="" />
    <meta property="og:description" content={description} data-next-head="" />
    <meta property="og:type" content="website" data-next-head="" />
    <meta property="og:image" content="/images/huzzah-thumb-16x9.jpg" data-next-head="" />
    <meta name="twitter:card" content="summary_large_image" data-next-head="" />
    <meta name="twitter:title" content={title} data-next-head="" />
    <meta name="twitter:description" content={description} data-next-head="" />
    <meta name="twitter:image" content="/images/huzzah-thumb-16x9.jpg" data-next-head="" />
    <link rel="icon" href="/images/huzzah-favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FFF8E8" />

    <!-- Google Fonts & Preload Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Geist+Mono:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/_next/static/media/5c285b27cdda1fe8-s.p.0yo6-5yoeeudq.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    <link rel="preload" href="/_next/static/media/9e9f04e3c37952ab-s.p.07uvnuj.ona6k.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust" />
    
    <style is:inline>
      :root {
        --font-app-sans: 'DM Sans', 'DM Sans Fallback', sans-serif;
        --font-app-mono: 'Geist Mono', 'Geist Mono Fallback', monospace;
        --font-app-heading: 'Anton', 'Anton Fallback', sans-serif;
      }
    </style>

    <!-- Huzzah Design System CSS -->
    <link rel="stylesheet" href="/_next/static/chunks/130irm5o-7xc_.css" data-n-g="" />
    <noscript data-n-css=""></noscript>



    <style is:global>
      body {
        padding-top: 40px !important;
      }
      .fixed.inset-x-0.top-0 {
        top: 40px !important;
      }
      [data-modulify-badge] {
        display: none !important;
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #fff8e8;
      }
      ::-webkit-scrollbar-thumb {
        background: #3c0d25;
        border-radius: 4px;
      }
    </style>
  </head>

  <body class="bg-cream font-sans text-plum antialiased selection:bg-bubblegum selection:text-plum">
    <!-- Top Bar Navigation quay lại Thư Viện -->
    <aside style="position:fixed;top:0;left:0;right:0;z-index:9999;background:rgba(18,14,24,0.96);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,0.12);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;font-size:11px;text-transform:uppercase;letter-spacing:0.18em;font-family:sans-serif;">
      <a href="/" style="color:#f28a6f;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        <span>← Về Trang Chủ Thư Viện</span>
      </a>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="background:rgba(242,138,111,0.14);border:1px solid rgba(242,138,111,0.3);padding:3px 12px;border-radius:9999px;color:#f28a6f;font-size:10px;font-weight:700;">
          {isOriginal ? 'Mục 11: Bản Clone Gốc (HTML / JS / Agency)' : 'Mục 11: Bản Astro Code (Modular Components)'}
        </span>
        <a
          href={isOriginal ? '/huzzah' : '/huzzah-original'}
          style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.2);padding-left:12px;"
          title={isOriginal ? 'Xem Bản Astro Code' : 'Xem Bản Gốc 1-to-1'}
        >
          {isOriginal ? 'Xem Bản Astro Code ↗' : 'Xem Bản Gốc ↗'}
        </a>
      </div>
    </aside>

    <div id="__next">
      <div class="h-full font-sans">
        <slot />
      </div>
    </div>
  </body>
</html>
