---
// v2/src/layouts/CanadaLayout.astro - Dedicated Layout for Anny Motion & Brand Designer (Astro Native)
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
  pageName?: string;
  extraScripts?: string[];
  pageProps?: any;
}

const {
  title = "Brand & Motion Designer | Anny",
  description = "Elevating brand identities, systems, and apps through collaborative motion design.",
  activePath = "/canada",
  pageName = "/",
  extraScripts = [
    "/_next/static/chunks/036w6yxidjqko.js"
  ],
  pageProps: customPageProps,
} = Astro.props;

let pageProps = customPageProps || {};
if (!customPageProps) {
  try {
    const jsonFile = pageName === '/' ? 'index.json' : `${pageName.replace(/^\//, '')}.json`;
    const jsonPath = path.resolve(`./public/_next/data/JxmxsttWmhvZwD9wztrbT/${jsonFile}`);
    if (fs.existsSync(jsonPath)) {
      const data = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
      pageProps = data.pageProps || {};
    }
  } catch (e) {}
}

const nextData = JSON.stringify({
  props: { pageProps, __N_SSG: true },
  page: pageName,
  query: {},
  buildId: "JxmxsttWmhvZwD9wztrbT",
  isFallback: false,
  gsp: true,
  scriptLoader: []
});

const originalPath = activePath.replace(/^\/canada/, '/canada-original') || '/canada-original';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <script is:inline>
      (function() {
        window.addEventListener('error', function(e) {
          if (e.message && (e.message.includes('418') || e.message.includes('Hydration') || e.message.includes('minified React error'))) {
            e.stopImmediatePropagation();
            e.preventDefault();
            return true;
          }
        }, true);

        function cleanUrl(val) {
          if (typeof val === "string" && val.includes("/_next/image?url=")) {
            if (val.includes(",")) {
              return val.replace(/\/_next\/image\?url=([%a-zA-Z0-9_\-\.\/]+)(?:&amp;|&)[^,\s>]+/g, function(m, u) {
                return decodeURIComponent(u);
              });
            }
            var m = val.match(/url=([^&]+)/);
            if (m) {
              return decodeURIComponent(m[1]);
            }
          }
          return val;
        }

        var origSetAttr = Element.prototype.setAttribute;
        Element.prototype.setAttribute = function(name, val) {
          if (name === "src" || name === "srcset" || name === "imagesrcset" || name === "href") {
            val = cleanUrl(val);
          }
          return origSetAttr.call(this, name, val);
        };

        var srcDesc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, "src");
        if (srcDesc && srcDesc.set) {
          Object.defineProperty(HTMLImageElement.prototype, "src", {
            get: srcDesc.get,
            set: function(val) { return srcDesc.set.call(this, cleanUrl(val)); },
            configurable: true, enumerable: true
          });
        }

        var srcsetDesc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, "srcset");
        if (srcsetDesc && srcsetDesc.set) {
          Object.defineProperty(HTMLImageElement.prototype, "srcset", {
            get: srcsetDesc.get,
            set: function(val) { return srcsetDesc.set.call(this, cleanUrl(val)); },
            configurable: true, enumerable: true
          });
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Anny Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/canada-thumb-16x9.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/canada-thumb-16x9.jpg" />
    <link rel="icon" href="/favicon-canada.ico" sizes="any" />

    <!-- Canada Design System CSS -->
    <link rel="stylesheet" href="/_next/static/chunks/0t91nk6quo2hn.css" />
    <link rel="stylesheet" href="/_next/static/chunks/09fsaa2nrfzwf.css" />

    <!-- Next.js Client Runtime Scripts -->
    <script is:inline src="/_next/static/chunks/0utg-1tcqk674.js" defer=""></script>
    <script is:inline src="/_next/static/chunks/0uw~ov22uo1v0.js" defer=""></script>
    <script is:inline src="/_next/static/chunks/0ipqwf.t2jw3m.js" defer=""></script>
    <script is:inline src="/_next/static/chunks/0mmpg.u0.bfoa.js" defer=""></script>
    <script is:inline src="/_next/static/chunks/08b3ftsysp8o2.js" defer=""></script>
    <script is:inline src="/_next/static/chunks/turbopack-0csm-96ns31jd.js" defer=""></script>
    <script is:inline src="/_next/static/chunks/0yf_uuhdbt1yw.js" defer=""></script>
    <script is:inline src="/_next/static/chunks/0goasl47cm1wh.js" defer=""></script>
    <script is:inline src="/_next/static/chunks/turbopack-0bfxl0ibpkk6y.js" defer=""></script>
    {extraScripts.map((s) => (
      <script is:inline src={s} defer=""></script>
    ))}
    <script is:inline src="/_next/static/JxmxsttWmhvZwD9wztrbT/_buildManifest.js" defer=""></script>
    <script is:inline src="/_next/static/JxmxsttWmhvZwD9wztrbT/_ssgManifest.js" defer=""></script>
    <script is:inline src="/_next/static/JxmxsttWmhvZwD9wztrbT/_clientMiddlewareManifest.js" defer=""></script>

    <style is:global>
      body {
        padding-top: 40px !important;
      }

      .fixed-nav {
        top: 40px !important;
      }

      [data-modulify-badge] {
        display: none !important;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col font-sans antialiased">
    <!-- Top Bar Navigation quay lại Thư Viện -->
    <aside style="position:fixed;top:0;left:0;right:0;z-index:99999;background:rgba(25,25,25,0.95);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,0.12);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;font-size:11px;text-transform:uppercase;letter-spacing:0.18em;font-family:sans-serif;color:#f0f0f0;">
      <a href="/" style="color:#f0f0f0;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        <span>← Về Trang Chủ Thư Viện</span>
      </a>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);padding:3px 12px;border-radius:9999px;color:#f0f0f0;font-size:10px;font-weight:700;">
          Phiên Bản: Astro Code Native (Component Hóa)
        </span>
        <a href={originalPath} style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.2);padding-left:12px;" title="Xem Bản Gốc 1-to-1">
          Xem Bản Gốc ↗
        </a>
      </div>
    </aside>

    <div id="__next">
      <slot />
    </div>

    <script is:inline id="__NEXT_DATA__" type="application/json" set:html={nextData}></script>
  </body>
</html>
