---
// v2/src/layouts/MeridianLayout.astro - Dedicated Layout for Meridian Freight (Astro Native)
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Meridian Freight — Global Air, Ocean & Intermodal Logistics",
  description = "Air and ocean freight, customs brokerage, warehousing and road transport across Asia Pacific, run end to end by one team that owns every shipment.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Meridian Freight" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/meridian/ship-fog.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/meridian/ship-fog.jpg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0b0d" />

    <!-- Google Fonts & Preloads -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link as="font" crossorigin="anonymous" data-next-font="size-adjust" href="/_next/static/media/2a0421e210ae52c2-s.p.02d-f.5otso_q.woff2" rel="preload" type="font/woff2" />
    <link as="font" crossorigin="anonymous" data-next-font="size-adjust" href="/_next/static/media/70bc3e132a0a741e-s.p.1409xf.ylxg8g.woff2" rel="preload" type="font/woff2" />
    <link as="font" crossorigin="anonymous" data-next-font="size-adjust" href="/_next/static/media/75affa71d1e2f6a7-s.p.0e5c5_wyqqx75.woff2" rel="preload" type="font/woff2" />

    <!-- Meridian Design System CSS -->
    <link rel="stylesheet" href="/_next/static/chunks/0okc8grb9hotf.css" />



    <style is:global>
      :root {
        --font-app-sans: 'Plus Jakarta Sans', sans-serif;
        --font-app-mono: 'JetBrains Mono', monospace;
        --font-app-heading: 'Space Grotesk', sans-serif;
      }

      body {
        padding-top: 40px !important;
      }
      header.fixed {
        top: 40px !important;
      }
      [data-modulify-badge] {
        display: none !important;
      }

      /* Native scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0b0b0d;
      }
      ::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #2563eb;
      }
    </style>
  </head>

  <body class="min-h-screen bg-white text-ink antialiased selection:bg-brand selection:text-white">
    <!-- Top Bar Navigation quay lại Thư Viện -->
    <aside style="position:fixed;top:0;left:0;right:0;z-index:9999;background:rgba(10,14,20,0.95);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,0.1);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;font-size:11px;text-transform:uppercase;letter-spacing:0.18em;font-family:sans-serif;">
      <a href="/" style="color:#38bdf8;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
        <span>← Về Trang Chủ Thư Viện</span>
      </a>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="background:rgba(56,189,248,0.12);border:1px solid rgba(56,189,248,0.3);padding:3px 12px;border-radius:9999px;color:#38bdf8;font-size:10px;font-weight:700;">
          Phiên Bản: Astro Code Native (Component Hóa)
        </span>
        <a href="/meridian-original" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.2);padding-left:12px;" title="Xem Bản Gốc">
          Xem Bản Gốc ↗
        </a>
      </div>
    </aside>

    <div id="__next">
      <div class="h-full font-sans">
        <div class="flex min-h-screen flex-col">
          <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-white focus:px-5 focus:py-3 focus:font-mono focus:text-xs focus:uppercase focus:tracking-[0.14em] focus:text-ink">Skip to content</a>
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
