---
// v2/src/layouts/MeridianLayout.astro - Dedicated Layout for Meridian Freight (Astro Native)
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Meridian Freight — Global Air, Ocean & Intermodal Logistics",
  description = "Air and ocean freight, customs brokerage, warehousing and road transport across Asia Pacific, run end to end by one team that owns every shipment.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Meridian Freight" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/meridian/ship-fog.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/meridian/ship-fog.jpg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0b0d" />

    <!-- Google Fonts & Preloads -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link as="font" crossorigin="anonymous" data-next-font="size-adjust" href="/_next/static/media/2a0421e210ae52c2-s.p.02d-f.5otso_q.woff2" rel="preload" type="font/woff2" />
    <link as="font" crossorigin="anonymous" data-next-font="size-adjust" href="/_next/static/media/70bc3e132a0a741e-s.p.1409xf.ylxg8g.woff2" rel="preload" type="font/woff2" />
    <link as="font" crossorigin="anonymous" data-next-font="size-adjust" href="/_next/static/media/75affa71d1e2f6a7-s.p.0e5c5_wyqqx75.woff2" rel="preload" type="font/woff2" />

    <!-- Meridian Design System CSS -->
    <link rel="stylesheet" href="/_next/static/chunks/0okc8grb9hotf.css" />

    <style is:global>
      :root {
        --font-app-sans: 'Plus Jakarta Sans', sans-serif;
        --font-app-mono: 'JetBrains Mono', monospace;
        --font-app-heading: 'Space Grotesk', sans-serif;
      }

      body {
        padding-top: 40px !important;
      }
      header.fixed {
        top: 40px !important;
      }
      [data-modulify-badge] {
        display: none !important;
      }

      /* Native scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0b0b0d;
      }
      ::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #2563eb;
      }
    </style>
  </head>

  <body class="min-h-screen bg-white text-ink antialiased selection:bg-brand selection:text-white">
    <!-- Top Bar Navigation quay lại Thư Viện -->
    <aside style="position:fixed;top:0;left:0;right:0;z-index:9999;background:rgba(10,14,20,0.95);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,0.1);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;font-size:11px;text-transform:uppercase;letter-spacing:0.18em;font-family:sans-serif;">
      <a href="/" style="color:#38bdf8;text-decoration:none;display:flex;align-items:center;gap:6px;font-weight:600;">
        <span>← Về Trang Chủ Thư Viện</span>
      </a>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="background:rgba(56,189,248,0.12);border:1px solid rgba(56,189,248,0.3);padding:3px 12px;border-radius:9999px;color:#38bdf8;font-size:10px;font-weight:700;">
          Phiên Bản: Astro Code Native (Component Hóa)
        </span>
        <a href="/meridian-original" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:10px;border-left:1px solid rgba(255,255,255,0.2);padding-left:12px;" title="Xem Bản Gốc">
          Xem Bản Gốc ↗
        </a>
      </div>
    </aside>

    <div class="h-full font-sans">
      <slot />
    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-menu-drawer" class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-300">
      <div id="mobile-menu-backdrop" class="absolute inset-0 bg-ink/80 backdrop-blur-sm"></div>
      <div id="mobile-menu-panel" class="absolute right-0 top-0 bottom-0 w-full max-w-sm bg-ink text-white p-6 shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300">
        <div>
          <div class="flex items-center justify-between pb-6 border-b border-white/10">
            <span class="font-heading text-lg uppercase tracking-wider">Menu</span>
            <button id="mobile-menu-close" type="button" class="p-2 text-white/70 hover:text-white" aria-label="Close menu">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
          <nav class="flex flex-col gap-4 mt-8 font-mono text-sm uppercase tracking-widest">
            <a class="mobile-nav-link py-2 text-white/80 hover:text-brand-soft" href="/meridian#about">About</a>
            <a class="mobile-nav-link py-2 text-white/80 hover:text-brand-soft" href="/meridian#services">Services</a>
            <a class="mobile-nav-link py-2 text-white/80 hover:text-brand-soft" href="/meridian#why-us">Why Us</a>
            <a class="mobile-nav-link py-2 text-white/80 hover:text-brand-soft" href="/meridian/insights">Insights</a>
            <a class="mobile-nav-link py-2 text-white/80 hover:text-brand-soft" href="/meridian#faq">FAQ</a>
            <a class="mobile-nav-link py-2 text-white/80 hover:text-brand-soft" href="/meridian/contact">Contact</a>
          </nav>
        </div>
        <div class="pt-6 border-t border-white/10">
          <a href="/meridian/contact" class="flex w-full items-center justify-center rounded-full bg-brand py-3 text-center font-mono text-xs uppercase tracking-widest text-white hover:bg-brand/90 transition-colors">
            Work With Us
          </a>
        </div>
      </div>
    </div>

    <!-- Native Client Script: Interactivity without Next.js React Conflicts -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. FAQ Accordion Logic
        const faqButtons = document.querySelectorAll('#faq button[aria-controls]');
        faqButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const isExpanded = btn.getAttribute('aria-expanded') === 'true';
            const targetId = btn.getAttribute('aria-controls');
            const panel = document.getElementById(targetId);
            const icon = btn.querySelector('.lucide-plus');
            const badge = btn.querySelector('span[aria-hidden="true"]');

            // Close all
            faqButtons.forEach((otherBtn) => {
              if (otherBtn !== btn) {
                otherBtn.setAttribute('aria-expanded', 'false');
                const otherId = otherBtn.getAttribute('aria-controls');
                const otherPanel = document.getElementById(otherId);
                const otherIcon = otherBtn.querySelector('.lucide-plus');
                const otherBadge = otherBtn.querySelector('span[aria-hidden="true"]');
                if (otherPanel) {
                  otherPanel.classList.remove('grid-rows-[1fr]');
                  otherPanel.classList.add('grid-rows-[0fr]');
                  otherPanel.setAttribute('inert', '');
                }
                if (otherIcon) otherIcon.classList.remove('rotate-45');
                if (otherBadge) {
                  otherBadge.classList.remove('border-ink', 'bg-ink', 'text-white');
                  otherBadge.classList.add('group-hover:border-ink');
                }
              }
            });

            // Toggle current
            if (isExpanded) {
              btn.setAttribute('aria-expanded', 'false');
              if (panel) {
                panel.classList.remove('grid-rows-[1fr]');
                panel.classList.add('grid-rows-[0fr]');
                panel.setAttribute('inert', '');
              }
              if (icon) icon.classList.remove('rotate-45');
              if (badge) {
                badge.classList.remove('border-ink', 'bg-ink', 'text-white');
                badge.classList.add('group-hover:border-ink');
              }
            } else {
              btn.setAttribute('aria-expanded', 'true');
              if (panel) {
                panel.classList.remove('grid-rows-[0fr]');
                panel.classList.add('grid-rows-[1fr]');
                panel.removeAttribute('inert');
              }
              if (icon) icon.classList.add('rotate-45');
              if (badge) {
                badge.classList.add('border-ink', 'bg-ink', 'text-white');
                badge.classList.remove('group-hover:border-ink');
              }
            }
          });
        });

        // 2. Dynamic Sticky Header Scroll Behavior
        const header = document.querySelector('header.fixed');
        if (header) {
          const updateHeader = () => {
            const scrollY = window.scrollY;
            const heroSection = document.getElementById('hero');
            const heroHeight = heroSection ? heroSection.offsetHeight - 120 : 600;

            if (scrollY > heroHeight) {
              header.classList.remove('text-white');
              header.classList.add('bg-white/95', 'text-ink', 'shadow-sm', 'backdrop-blur-md');
              
              // Border and button overrides
              const borders = header.querySelectorAll('.border-white\\/25');
              borders.forEach(el => {
                el.classList.remove('border-white/25');
                el.classList.add('border-ink/20');
              });
              const ctaBtn = header.querySelector('a[href="/meridian/contact"].bg-white');
              if (ctaBtn) {
                ctaBtn.classList.remove('bg-white', 'text-ink');
                ctaBtn.classList.add('bg-ink', 'text-white');
              }
            } else {
              header.classList.add('text-white');
              header.classList.remove('bg-white/95', 'text-ink', 'shadow-sm', 'backdrop-blur-md');
              
              const borders = header.querySelectorAll('.border-ink\\/20');
              borders.forEach(el => {
                el.classList.remove('border-ink/20');
                el.classList.add('border-white/25');
              });
              const ctaBtn = header.querySelector('a[href="/meridian/contact"].bg-ink');
              if (ctaBtn) {
                ctaBtn.classList.remove('bg-ink', 'text-white');
                ctaBtn.classList.add('bg-white', 'text-ink');
              }
            }
          };

          window.addEventListener('scroll', updateHeader, { passive: true });
          updateHeader();
        }

        // 3. Mobile Menu Open/Close
        const menuBtn = document.querySelector('button[aria-controls="site-menu"]');
        const drawer = document.getElementById('mobile-menu-drawer');
        const backdrop = document.getElementById('mobile-menu-backdrop');
        const panel = document.getElementById('mobile-menu-panel');
        const closeBtn = document.getElementById('mobile-menu-close');
        const navLinks = document.querySelectorAll('.mobile-nav-link');

        const openMenu = () => {
          if (!drawer || !panel) return;
          drawer.classList.remove('pointer-events-none', 'opacity-0');
          drawer.classList.add('pointer-events-auto', 'opacity-100');
          panel.classList.remove('translate-x-full');
          panel.classList.add('translate-x-0');
        };

        const closeMenu = () => {
          if (!drawer || !panel) return;
          drawer.classList.add('opacity-0', 'pointer-events-none');
          drawer.classList.remove('opacity-100', 'pointer-events-auto');
          panel.classList.add('translate-x-full');
          panel.classList.remove('translate-x-0');
        };

        if (menuBtn) menuBtn.addEventListener('click', openMenu);
        if (closeBtn) closeBtn.addEventListener('click', closeMenu);
        if (backdrop) backdrop.addEventListener('click', closeMenu);
        navLinks.forEach(link => link.addEventListener('click', closeMenu));

        // 4. Original 3D Earth Globe Canvas Animation (Faithfully Ported to Native Astro)
        const heroTrack = document.getElementById('hero');
        const heroStage = heroTrack?.querySelector('.sticky');
        const canvas = heroTrack?.querySelector('canvas');

        if (heroTrack && heroStage && canvas) {
          const ctx = canvas.getContext('2d');
          if (ctx) {
            const DEG = Math.PI / 180;
            const clamp = (val, min = 0, max = 1) => Math.min(max, Math.max(min, val));
            const lerp = (start, end, progress) => start + (end - start) * progress;
            const smoothStep = (edge0, edge1, x) => {
              const t = clamp((x - edge0) / (edge1 - edge0));
              return t * t * (3 - 2 * t);
            };
            const toXYZ = (lon, lat) => {
              const radLon = lon * DEG;
              const radLat = lat * DEG;
              return [
                Math.cos(radLat) * Math.sin(radLon),
                Math.sin(radLat),
                Math.cos(radLat) * Math.cos(radLon)
              ];
            };

            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const monoFont = getComputedStyle(document.documentElement).getPropertyValue('--font-app-mono').trim() || 'ui-monospace, monospace';

            const routeHub = { name: "Melbourne", lon: 144.96, lat: -37.81 };
            const hubXYZ = toXYZ(routeHub.lon, routeHub.lat);

            const routeDestinations = [
              { name: "Germany", lon: 8.68, lat: 50.11 },
              { name: "Spain", lon: -3.7, lat: 40.42 },
              { name: "Italy", lon: 9.19, lat: 45.46 },
              { name: "Turkey", lon: 28.98, lat: 41.01 },
              { name: "Egypt", lon: 31.24, lat: 30.04 },
              { name: "Qatar", lon: 51.53, lat: 25.29 },
              { name: "Saudi Arabia", lon: 46.68, lat: 24.71 },
              { name: "Kenya", lon: 36.82, lat: -1.29 },
              { name: "South Africa", lon: 28.05, lat: -26.2 },
              { name: "USA", lon: -118.24, lat: 34.05 },
              { name: "Canada", lon: -123.12, lat: 49.28 },
              { name: "Mexico", lon: -99.13, lat: 19.43 },
              { name: "Brazil", lon: -46.63, lat: -23.55 },
              { name: "Argentina", lon: -58.38, lat: -34.6 },
              { name: "Colombia", lon: -74.07, lat: 4.71 },
              { name: "Chile", lon: -70.67, lat: -33.45 },
              { name: "Japan", lon: 139.69, lat: 35.69 },
              { name: "Hong Kong", lon: 114.17, lat: 22.32 },
              { name: "Thailand", lon: 100.5, lat: 13.76 },
              { name: "Singapore", lon: 103.82, lat: 1.35 },
              { name: "Australia", lon: 151.21, lat: -33.87 },
              { name: "New Zealand", lon: 174.76, lat: -36.85 },
              { name: "China", lon: 121.47, lat: 31.23 }
            ];

            const destCount = routeDestinations.length;
            const destinations = routeDestinations.map((dest, idx) => {
              const startXYZ = toXYZ(routeHub.lon, routeHub.lat);
              const endXYZ = toXYZ(dest.lon, dest.lat);
              const dot = clamp(startXYZ[0] * endXYZ[0] + startXYZ[1] * endXYZ[1] + startXYZ[2] * endXYZ[2], -1, 1);
              const angle = Math.acos(dot);
              const sinAngle = Math.sin(angle);
              const arcAltitude = 0.05 + (angle / Math.PI) * 0.22;
              const points = new Float32Array(72 * 3);

              for (let i = 0; i < 72; i++) {
                const t = i / 71;
                const o = sinAngle < 1e-6 ? 1 - t : Math.sin((1 - t) * angle) / sinAngle;
                const d = sinAngle < 1e-6 ? t : Math.sin(t * angle) / sinAngle;
                const altMultiplier = 1 + arcAltitude * Math.sin(Math.PI * t);
                points[3 * i] = (o * startXYZ[0] + d * endXYZ[0]) * altMultiplier;
                points[3 * i + 1] = (o * startXYZ[1] + d * endXYZ[1]) * altMultiplier;
                points[3 * i + 2] = (o * startXYZ[2] + d * endXYZ[2]) * altMultiplier;
              }

              return {
                name: dest.name.toUpperCase(),
                points,
                end: endXYZ,
                delay: (((7 * idx) % destCount) / destCount) * 0.5,
                speed: 0.09 + ((3 * idx) % 5) * 0.025,
                offset: (0.173 * idx) % 1
              };
            });

            let landPoints = new Float32Array(0);
            let screenPoints = new Float32Array(0);
            let landLoadedTime = 0;
            let stageWidth = 0;
            let stageHeight = 0;
            let dpr = 1;
            let animId = 0;
            let isIntersecting = true;
            let isDestroyed = false;

            let rotX = 0, rotY = 0, rotZ = 0;
            let cosQ = 1, sinQ = 0, cosD = 1, sinD = 0;
            const startTime = performance.now();

            const project = (x, y, z) => {
              const lx = x * cosQ - z * sinQ;
              const lz = x * sinQ + z * cosQ;
              rotX = lx;
              rotY = y * cosD - lz * sinD;
              rotZ = y * sinD + lz * cosD;
            };

            const render = (now) => {
              animId = 0;
              if (isDestroyed) return;

              const elapsedSec = prefersReducedMotion ? 0 : (now - startTime) / 1000;
              const trackRect = heroTrack.getBoundingClientRect();
              const maxScroll = Math.max(trackRect.height - window.innerHeight, 1);
              const heroProgress = prefersReducedMotion ? 1 : clamp(-trackRect.top / maxScroll);
              heroStage.style.setProperty('--hero-progress', heroProgress.toFixed(3));

              // Cubic easing for scroll physics
              const tNorm = clamp(heroProgress / 0.8);
              const p = tNorm < 0.5 ? 4 * tNorm * tNorm * tNorm : 1 - Math.pow(-2 * tNorm + 2, 3) / 2;

              const isDesktop = stageWidth >= 1024;
              const initialRadius = 1.3 * Math.max(stageWidth, stageHeight);
              const targetRadius = isDesktop ? Math.min(0.38 * stageHeight, 0.26 * stageWidth) : Math.min(0.8 * stageWidth, 0.42 * stageHeight);
              const targetX = isDesktop ? 0.73 * stageWidth : stageWidth / 2;
              const targetY = isDesktop ? 0.5 * stageHeight : 0.72 * stageHeight + 0.5 * targetRadius;

              const G = lerp(initialRadius, targetRadius, p);
              const Z = lerp(stageWidth / 2, targetX, p);
              const U = lerp(0.8 * stageHeight + initialRadius, targetY, p);

              const angleQ = (140 + 55 * Math.sin(0.12 * elapsedSec) + (1 - p) * 40) * DEG;
              const angleD = -10 * DEG;
              cosQ = Math.cos(angleQ);
              sinQ = Math.sin(angleQ);
              cosD = Math.cos(angleD);
              sinD = Math.sin(angleD);

              ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
              ctx.clearRect(0, 0, stageWidth, stageHeight);

              // 1. Atmosphere Radial Gradient Glow
              const B = 36 + 0.05 * G;
              const X = (0.03 * G) / (0.03 * G + B);
              const atmosphereGrad = ctx.createRadialGradient(Z, U, 0.97 * G, Z, U, G + B);
              atmosphereGrad.addColorStop(0, "rgba(35, 64, 255, 0)");
              atmosphereGrad.addColorStop(X, "rgba(74, 99, 255, 0.55)");
              atmosphereGrad.addColorStop(1, "rgba(35, 64, 255, 0)");
              ctx.fillStyle = atmosphereGrad;
              ctx.beginPath();
              ctx.arc(Z, U, G + B, 0, 2 * Math.PI);
              ctx.fill();

              // 2. Planet Sphere Body Gradient
              const sphereGrad = ctx.createRadialGradient(Z - 0.3 * G, U - 0.35 * G, 0.1 * G, Z, U, G);
              sphereGrad.addColorStop(0, "#0d1236");
              sphereGrad.addColorStop(0.75, "#05060f");
              sphereGrad.addColorStop(0.965, "#0a1250");
              sphereGrad.addColorStop(1, "#4a63ff");
              ctx.fillStyle = sphereGrad;
              ctx.beginPath();
              ctx.arc(Z, U, G, 0, 2 * Math.PI);
              ctx.fill();

              // 3. Earth Land Points
              if (landPoints.length > 0) {
                const fadeIn = (prefersReducedMotion ? 1 : clamp((now - landLoadedTime) / 900)) * (0.35 + 0.65 * smoothStep(0, 0.55, heroProgress));
                const dotSize = clamp(G / 280, 0.9, 1.7);
                const halfSize = dotSize / 2;
                let visibleCount = 0;

                for (let i = 0; i < landPoints.length; i += 3) {
                  project(landPoints[i], landPoints[i + 1], landPoints[i + 2]);
                  if (rotZ <= 0) continue;
                  const sx = Z + rotX * G;
                  const sy = U - rotY * G;
                  if (sx < -2 || sy < -2 || sx > stageWidth + 2 || sy > stageHeight + 2) continue;
                  screenPoints[3 * visibleCount] = sx;
                  screenPoints[3 * visibleCount + 1] = sy;
                  screenPoints[3 * visibleCount + 2] = rotZ;
                  visibleCount++;
                }

                ctx.fillStyle = "#cdd6ff";
                const depthLayers = [
                  [0, 0.35, 0.28],
                  [0.35, 0.7, 0.6],
                  [0.7, 1.01, 1.0]
                ];
                for (const [zMin, zMax, layerAlpha] of depthLayers) {
                  ctx.beginPath();
                  for (let i = 0; i < visibleCount; i++) {
                    const zVal = screenPoints[3 * i + 2];
                    if (zVal < zMin || zVal >= zMax) continue;
                    ctx.rect(screenPoints[3 * i] - halfSize, screenPoints[3 * i + 1] - halfSize, dotSize, dotSize);
                  }
                  ctx.globalAlpha = layerAlpha * fadeIn;
                  ctx.fill();
                }
                ctx.globalAlpha = 1;
              }

              // 4. Arcs & Routes
              const arcVisibility = prefersReducedMotion ? 1 : smoothStep(0.3, 0.92, heroProgress);
              const showLabels = isDesktop && G < 520;
              ctx.lineCap = "round";
              ctx.font = `500 10px ${monoFont}`;

              for (const dest of destinations) {
                const progressFraction = prefersReducedMotion ? 1 : clamp((arcVisibility - dest.delay) / 0.5);
                if (progressFraction <= 0) continue;

                const stepLimit = Math.max(1, Math.floor(71 * progressFraction));
                let isDrawing = false;
                ctx.beginPath();

                for (let i = 0; i <= stepLimit; i++) {
                  project(dest.points[3 * i], dest.points[3 * i + 1], dest.points[3 * i + 2]);
                  if (rotZ <= 0 && rotX * rotX + rotY * rotY <= 1) {
                    isDrawing = false;
                    continue;
                  }
                  const sx = Z + rotX * G;
                  const sy = U - rotY * G;
                  if (isDrawing) ctx.lineTo(sx, sy);
                  else ctx.moveTo(sx, sy);
                  isDrawing = true;
                }

                ctx.strokeStyle = "rgba(140, 155, 255, 0.55)";
                ctx.lineWidth = 1;
                ctx.stroke();

                if (progressFraction >= 1) {
                  if (!prefersReducedMotion) {
                    const pulseIndex = Math.floor(((elapsedSec * dest.speed + dest.offset) % 1) * 71);
                    const tailIndex = Math.max(0, pulseIndex - 10);
                    let isPulseDrawing = false;
                    let lastHeadX = 0, lastHeadY = 0;
                    let isFrontVisible = false;

                    ctx.beginPath();
                    for (let s = tailIndex; s <= pulseIndex; s++) {
                      project(dest.points[3 * s], dest.points[3 * s + 1], dest.points[3 * s + 2]);
                      isFrontVisible = rotZ > 0 || rotX * rotX + rotY * rotY > 1;
                      if (!isFrontVisible) {
                        isPulseDrawing = false;
                        continue;
                      }
                      lastHeadX = Z + rotX * G;
                      lastHeadY = U - rotY * G;
                      if (isPulseDrawing) ctx.lineTo(lastHeadX, lastHeadY);
                      else ctx.moveTo(lastHeadX, lastHeadY);
                      isPulseDrawing = true;
                    }

                    ctx.strokeStyle = "rgba(255, 255, 255, 0.85)";
                    ctx.lineWidth = 1.6;
                    ctx.stroke();

                    if (isFrontVisible) {
                      ctx.fillStyle = "rgba(140, 155, 255, 0.3)";
                      ctx.beginPath();
                      ctx.arc(lastHeadX, lastHeadY, 5, 0, 2 * Math.PI);
                      ctx.fill();

                      ctx.fillStyle = "#ffffff";
                      ctx.beginPath();
                      ctx.arc(lastHeadX, lastHeadY, 1.8, 0, 2 * Math.PI);
                      ctx.fill();
                    }
                  }

                  // Destination Hub Marker
                  project(dest.end[0], dest.end[1], dest.end[2]);
                  if (rotZ > 0.05) {
                    const dx = Z + rotX * G;
                    const dy = U - rotY * G;
                    ctx.fillStyle = "#8c9bff";
                    ctx.fillRect(dx - 1.5, dy - 1.5, 3, 3);
                    if (showLabels && rotZ > 0.2) {
                      ctx.globalAlpha = clamp((rotZ - 0.2) * 4);
                      ctx.fillStyle = "#ffffff";
                      ctx.fillText(dest.name, dx + 7, dy + 3);
                      ctx.globalAlpha = 1;
                    }
                  }
                }
              }

              // 5. Melbourne Origin Hub Marker & Pulse
              project(hubXYZ[0], hubXYZ[1], hubXYZ[2]);
              if (rotZ > 0) {
                const mx = Z + rotX * G;
                const my = U - rotY * G;
                const pulseNorm = prefersReducedMotion ? 0.4 : (elapsedSec % 2.4) / 2.4;
                ctx.strokeStyle = `rgba(110, 132, 255, ${(1 - pulseNorm) * 0.9})`;
                ctx.lineWidth = 1.2;
                ctx.beginPath();
                ctx.arc(mx, my, 4 + 16 * pulseNorm, 0, 2 * Math.PI);
                ctx.stroke();

                ctx.fillStyle = "#ffffff";
                ctx.fillRect(mx - 2.5, my - 2.5, 5, 5);

                if (showLabels && arcVisibility > 0) {
                  ctx.globalAlpha = arcVisibility;
                  ctx.fillStyle = "#8c9bff";
                  ctx.fillText("MELBOURNE HUB", mx + 10, my + 4);
                  ctx.globalAlpha = 1;
                }
              }

              if (!prefersReducedMotion && isIntersecting) {
                animId = window.requestAnimationFrame(render);
              }
            };

            const requestFrame = () => {
              if (!animId && !isDestroyed) {
                animId = window.requestAnimationFrame(render);
              }
            };

            const resize = () => {
              const rect = heroStage.getBoundingClientRect();
              stageWidth = rect.width;
              stageHeight = rect.height;
              dpr = Math.min(window.devicePixelRatio || 1, 2);
              canvas.width = Math.max(1, Math.round(stageWidth * dpr));
              canvas.height = Math.max(1, Math.round(stageHeight * dpr));
              requestFrame();
            };

            const resizeObserver = new ResizeObserver(resize);
            const intersectObserver = new IntersectionObserver(([entry]) => {
              isIntersecting = !!entry?.isIntersecting;
              if (isIntersecting) requestFrame();
            });

            resize();
            resizeObserver.observe(heroStage);
            intersectObserver.observe(heroTrack);

            window.addEventListener('scroll', requestFrame, { passive: true });

            // Load precomputed 3D land points
            fetch('/images/meridian/land-points.bin')
              .then((res) => {
                if (!res.ok) throw new Error('Status ' + res.status);
                return res.arrayBuffer();
              })
              .then((buffer) => {
                if (!isDestroyed) {
                  landPoints = new Float32Array(buffer);
                  screenPoints = new Float32Array(landPoints.length);
                  landLoadedTime = performance.now();
                  requestFrame();
                }
              })
              .catch((err) => {
                console.warn('Could not load land-points.bin:', err);
              });
          }
        }
      });
    </script>
  </body>
</html>
