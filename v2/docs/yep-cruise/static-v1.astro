---
const base = '/images/yep-cruise/';
const photos = [
 {file:'yep-140-khach-du-thuyen-indochina-star-tphcm',title:'Bắt đầu một buổi tối khác biệt',label:'01 / ĐÓN KHÁCH',alt:'Đoàn khách chuẩn bị lên du thuyền Indochina Star tại TP.HCM'},
 {file:'yep-indoor-activities-tro-choi-tuong-tac',title:'Kết nối bằng những tiếng cười',label:'02 / INDOOR ACTIVITIES',alt:'MC hướng dẫn trò chơi tương tác trong chương trình YEP của FIT TOUR'},
 {file:'san-khau-yep-thiet-ke-rieng-tren-du-thuyen',title:'Sân khấu cho câu chuyện riêng',label:'03 / THIẾT KẾ CHƯƠNG TRÌNH',alt:'Sân khấu sự kiện được chuẩn bị trong khoang du thuyền Indochina Star'},
 {file:'gala-dinner-140-khach-tren-du-thuyen-sai-gon',title:'Cùng ngồi lại, cùng nâng ly',label:'04 / GALA DINNER',alt:'Không gian Gala Dinner với khách mời và bàn tiệc trong khoang du thuyền'},
 {file:'acoustic-live-band-gala-dinner-du-thuyen',title:'Âm nhạc nối dài cảm xúc',label:'05 / ACOUSTIC LIVE BAND',alt:'Ban nhạc acoustic biểu diễn trên sân khấu Gala Dinner của FIT TOUR'},
 {file:'ngam-sai-gon-ve-dem-tu-du-thuyen',title:'Sài Gòn, từ một góc nhìn khác',label:'06 / SÀI GÒN VỀ ĐÊM',alt:'Khách ngắm cầu và các tòa nhà sáng đèn từ du thuyền trên sông Sài Gòn'},
];
const image=(i:number)=>base+photos[i].file+'.webp';
---
<!doctype html>
<html lang="vi">
<head>
 <link rel="stylesheet" href="/fonts/yep/fonts.css" /><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <title>YEP Indoor & Private Cruise — Case Study 140 Khách | FIT TOUR</title>
 <meta name="description" content="Một chương trình, hai trải nghiệm. Khám phá case study YEP Indoor, Gala Dinner và acoustic trên du thuyền Indochina Star cùng FIT TOUR." />
 <meta name="robots" content="noindex,nofollow" /><meta name="theme-color" content="#151713" />
 <link rel="preload" as="image" href={base+'hero-cabin.webp'} />
 <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
 <a class="skip" href="#story">Đến nội dung</a>
 <header class="header">
  <a class="wordmark" href="#top" aria-label="FIT TOUR về đầu trang">FIT TOUR<span>PRIVATE EXPERIENCES</span></a>
  <nav aria-label="Điều hướng chính"><a href="#story">Câu chuyện</a><a href="#experience">Trải nghiệm</a><a href="#moments">Khoảnh khắc</a></nav>
  <a class="nav-cta" href="#contact">Thiết kế chương trình riêng <span>↗</span></a>
  <button class="menu-toggle" aria-label="Mở menu" aria-expanded="false" aria-controls="mobile-nav">Menu <span>＋</span></button>
 </header>
 <nav id="mobile-nav" class="mobile-nav" hidden aria-label="Điều hướng di động"><a href="#story">Câu chuyện</a><a href="#experience">Trải nghiệm</a><a href="#moments">Khoảnh khắc</a><a href="#contact">Trao đổi chương trình riêng ↗</a></nav>
 <main>
  <section class="hero" id="top" aria-labelledby="hero-title">
   <picture><source media="(max-width: 650px)" srcset={base+'hero-cabin-mobile.webp'} /><img class="hero-img" src={base+'hero-cabin.webp'} alt="" width="1920" height="1080" fetchpriority="high" /></picture>
   <div class="hero-shade"></div>
   <div class="hero-content"><p class="eyebrow">FIT TOUR JOURNAL <span>—</span> A PRIVATE CELEBRATION</p><h1 id="hero-title">Một buổi tối.<br/>Hai miền <em>cảm xúc.</em></h1><p class="hero-desc">Gắn kết trong từng khoảnh khắc.<br/>Tận hưởng Sài Gòn từ một góc nhìn riêng.</p><a class="text-link" href="#story">Khám phá câu chuyện <span>↓</span></a></div>
   <div class="hero-bottom"><span>YEP INDOOR & PRIVATE CRUISE</span><span>140 KHÁCH <i>·</i> INDOCHINA STAR <i>·</i> TP.HCM</span><span class="edition">CASE STUDY / 01</span></div>
  </section>
  <section class="intro wrap section" id="story">
   <div class="section-label reveal"><span class="number">01</span><p>CÂU CHUYỆN<br/>ĐẰNG SAU BUỔI TIỆC</p></div>
   <div class="intro-main reveal"><h2>Không chỉ gặp nhau.<br/><em>Mà thật sự kết nối.</em></h2><div class="intro-copy"><p>Một buổi tiệc cuối năm có thể bắt đầu bằng lời chào. Một trải nghiệm đáng nhớ bắt đầu khi mọi người cùng tham gia.</p><p>Với đoàn 140 khách, FIT TOUR kết hợp hoạt động indoor, Gala Dinner và âm nhạc acoustic trên du thuyền Indochina Star — để sự sôi nổi và những phút thư giãn cùng hiện diện trong một chương trình.</p></div><div class="facts"><div><strong>140</strong><span>KHÁCH THAM DỰ</span></div><div><strong>02</strong><span>MẠCH TRẢI NGHIỆM</span></div><div><strong>01</strong><span>CHƯƠNG TRÌNH RIÊNG</span></div></div></div>
  </section>
  <figure class="arrival wrap reveal"><img src={image(0)} alt={photos[0].alt} width="1280" height="720" loading="lazy"/><figcaption><span>KHỞI ĐẦU HÀNH TRÌNH</span> Đón khách lên du thuyền Indochina Star, TP.HCM <span>ẢNH SỰ KIỆN THỰC TẾ ↗</span></figcaption></figure>
  <section class="experience section" id="experience">
   <div class="wrap experience-heading reveal"><div><p class="eyebrow dark">02 / MỘT CHƯƠNG TRÌNH, HAI TRẢI NGHIỆM</p><h2>Nhịp vui chung.<br/><em>Dấu ấn riêng.</em></h2></div><p>Từ những tiếng cười trong khoang tiệc<br/>đến thành phố lấp lánh ngoài ô cửa.</p></div>
   <div class="duet wrap">
    <article class="experience-card reveal"><div class="media"><img src={image(1)} alt={photos[1].alt} loading="lazy" width="1280" height="720"/><span class="photo-tag">THE CONNECTION</span></div><div class="card-copy"><span class="small-label">01 / GẮN KẾT</span><h3>Khi khoảng cách<br/>nhường chỗ cho <em>tiếng cười.</em></h3><p>Những trò chơi tương tác có người dẫn dắt, tạo cơ hội để các thành viên cùng tham gia và chia sẻ khoảnh khắc vui vẻ.</p><a class="text-link dark-link" href="#design">Bên trong chương trình <span>↗</span></a></div></article>
    <article class="experience-card second reveal"><div class="media"><img src={image(3)} alt={photos[3].alt} loading="lazy" width="1280" height="720"/><span class="photo-tag">THE CELEBRATION</span></div><div class="card-copy"><span class="small-label">02 / TẬN HƯỞNG</span><h3>Một bàn tiệc ấm.<br/>Một buổi tối <em>đáng nhớ.</em></h3><p>Gala Dinner trong không gian gỗ ấm, âm nhạc acoustic và cảnh đêm trên sông Sài Gòn tiếp nối phần hoạt động gắn kết.</p><a class="text-link dark-link" href="#night">Chạm vào nhịp Sài Gòn <span>↗</span></a></div></article>
   </div>
  </section>
  <section class="design wrap section" id="design"><div class="design-copy reveal"><p class="eyebrow">03 / THIẾT KẾ TỪNG ĐIỂM CHẠM</p><h2>Phía sau cảm xúc,<br/>là những điều<br/><em>được chuẩn bị.</em></h2><p>Không gian, hoạt động và âm nhạc cùng phục vụ một câu chuyện xuyên suốt của buổi tối.</p><div class="details"><details open><summary><span>01</span> Sân khấu & không gian <b>＋</b></summary><p>Khu vực sân khấu trong khoang du thuyền là điểm tập trung cho hoạt động dẫn chương trình và biểu diễn.</p></details><details><summary><span>02</span> Hoạt động tương tác <b>＋</b></summary><p>MC dẫn dắt trò chơi indoor, kết nối người tham dự qua hoạt động chung trong không gian sự kiện.</p></details><details><summary><span>03</span> Âm nhạc & tiệc tối <b>＋</b></summary><p>Gala Dinner kết hợp acoustic live band, tạo nhịp chuyển từ hoạt động sôi nổi sang phần thưởng thức và trò chuyện.</p></details></div></div><div class="design-images reveal"><figure><img src={image(2)} alt={photos[2].alt} width="1280" height="720" loading="lazy"/><figcaption>THE STAGE / Không gian dành cho câu chuyện riêng</figcaption></figure><figure class="band"><img src={image(4)} alt={photos[4].alt} width="1280" height="720" loading="lazy"/><figcaption>THE SOUND / Acoustic live band</figcaption></figure></div></section>
  <section class="river-interlude" aria-label="Chuyển cảnh mặt sông"><img src={base+'river-reflections.webp'} alt="" loading="lazy" width="1920" height="1080"/><div class="wrap reveal"><p class="eyebrow">TỪ SÔI NỔI ĐẾN THẢNH THƠI</p><p class="river-quote">Cùng một dòng sông.<br/><em>Mỗi khoảnh khắc, một cảm xúc.</em></p></div><span class="illustration-note">HÌNH MINH HỌA KHÔNG KHÍ</span></section>
  <section class="journey wrap section"><div class="journey-head reveal"><p class="eyebrow dark">04 / NHỊP CHƯƠNG TRÌNH</p><h2>Một hành trình<br/><em>liền mạch.</em></h2><p>Những phần trải nghiệm bổ sung cho nhau,<br/>từ lúc gặp gỡ đến phút ngắm thành phố.</p></div><ol class="timeline"><li class="reveal"><span>01</span><h3>Chào đón</h3><p>Đón khách và bước vào không gian du thuyền.</p></li><li class="reveal"><span>02</span><h3>Gắn kết</h3><p>Cùng tham gia trò chơi và hoạt động indoor.</p></li><li class="reveal"><span>03</span><h3>Chung vui</h3><p>Gala Dinner hòa cùng âm nhạc acoustic.</p></li><li class="reveal"><span>04</span><h3>Tận hưởng</h3><p>Ngắm cảnh Sài Gòn rực sáng bên sông.</p></li></ol></section>
  <section class="night" id="night"><img src={image(5)} alt={photos[5].alt} width="1280" height="720" loading="lazy"/><div class="night-shade"></div><div class="night-copy wrap reveal"><p class="eyebrow">SAIGON, AFTER DARK</p><h2>Thành phố lên đèn.<br/><em>Cảm xúc ở lại.</em></h2><p>Một góc nhìn từ du thuyền.<br/>Một khoảnh khắc cùng nhau.</p></div><span class="night-caption">SÔNG SÀI GÒN / ẢNH SỰ KIỆN THỰC TẾ</span></section>
  <section class="moments wrap section" id="moments"><div class="gallery-head reveal"><div><p class="eyebrow dark">05 / NHỮNG KHOẢNH KHẮC CÓ THẬT</p><h2>Câu chuyện qua <em>hình ảnh.</em></h2></div><span>06 KHUNG HÌNH <span class="gallery-hint">/ CHẠM ĐỂ XEM LỚN</span></span></div><div class="gallery">{photos.map((p,i)=><button class="gallery-item reveal" data-photo={i} aria-label={'Xem ảnh: '+p.title}><div><img src={image(i)} alt={p.alt} loading="lazy" width="1280" height="720"/><span class="expand">↗</span></div><span class="gallery-label">{p.label}</span><strong>{p.title}</strong></button>)}</div></section>
  <section class="contact" id="contact"><img src={base+'river-reflections.webp'} alt="" loading="lazy" width="1920" height="1080"/><div class="contact-shade"></div><div class="wrap contact-inner reveal"><p class="eyebrow">YOUR NEXT PRIVATE EXPERIENCE</p><h2>Câu chuyện tiếp theo,<br/><em>mang dấu ấn của bạn.</em></h2><p>Một dịp gặp gỡ. Một tinh thần doanh nghiệp.<br/>Cùng FIT TOUR hình dung chương trình dành riêng cho đội ngũ của bạn.</p><button class="contact-button" data-open-contact>Trao đổi chương trình riêng <span>↗</span></button></div></section>
 </main>
 <footer class="wrap"><a class="wordmark" href="#top">FIT TOUR<span>PRIVATE EXPERIENCES</span></a><p>YEP INDOOR · GALA DINNER · PRIVATE CRUISE</p><a href="#top">Về đầu trang ↑</a><div class="footer-bottom"><span>© 2026 FIT TOUR · BẢN CONCEPT XEM THỬ</span><span>Ảnh sự kiện: FIT TOUR · Nền không khí: AI minh họa</span></div></footer>
 <dialog class="lightbox" aria-label="Ảnh sự kiện"><button class="dialog-close" aria-label="Đóng ảnh">Đóng ×</button><img id="large-photo" alt=""/><div class="lightbox-bar"><button data-prev aria-label="Ảnh trước">←</button><p id="photo-caption"></p><button data-next aria-label="Ảnh tiếp theo">→</button></div></dialog>
 <dialog class="contact-dialog" aria-labelledby="contact-title"><button class="dialog-close" aria-label="Đóng cửa sổ">Đóng ×</button><p class="eyebrow dark">LET’S CREATE SOMETHING PERSONAL</p><h2 id="contact-title">Buổi tối của bạn,<br/><em>bắt đầu từ một ý tưởng.</em></h2><p>Chuẩn bị số lượng khách dự kiến, dịp tổ chức và tinh thần bạn muốn mang đến cho chương trình. FIT TOUR sẽ cùng bạn trao đổi phương án phù hợp.</p><a href="https://fittour.vn" target="_blank" rel="noopener" class="contact-button">Kết nối qua website FIT TOUR ↗</a><small>Bản xem thử chưa thu thập hoặc gửi thông tin.</small></dialog>
 <script define:vars={{photos,base}}>
  const menu=document.querySelector('.menu-toggle'), nav=document.querySelector('#mobile-nav');
  menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav.hidden=!open;});
  nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.hidden=true;menu.setAttribute('aria-expanded','false');}));
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  if('IntersectionObserver' in window&&!reduced){const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target);}}),{threshold:.08});document.querySelectorAll('.reveal').forEach(el=>{el.classList.add('will-reveal');observer.observe(el);});}
  const box=document.querySelector('.lightbox'),large=document.querySelector('#large-photo'),caption=document.querySelector('#photo-caption');let active=0;
  function showPhoto(i){active=(i+photos.length)%photos.length;large.src=base+photos[active].file+'.webp';large.alt=photos[active].alt;caption.textContent=String(active+1).padStart(2,'0')+' / 06 — '+photos[active].title;}
  document.querySelectorAll('[data-photo]').forEach(button=>button.addEventListener('click',()=>{showPhoto(Number(button.dataset.photo));box.showModal();}));
  document.querySelector('[data-prev]').addEventListener('click',()=>showPhoto(active-1));document.querySelector('[data-next]').addEventListener('click',()=>showPhoto(active+1));
  box.addEventListener('keydown',e=>{if(e.key==='ArrowRight')showPhoto(active+1);if(e.key==='ArrowLeft')showPhoto(active-1);});
  document.querySelectorAll('dialog').forEach(dialog=>{dialog.querySelector('.dialog-close').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});});
  document.querySelector('[data-open-contact]').addEventListener('click',()=>document.querySelector('.contact-dialog').showModal());
  document.querySelectorAll('.details details').forEach(d=>d.addEventListener('toggle',()=>{if(d.open)document.querySelectorAll('.details details').forEach(other=>{if(other!==d)other.open=false;});}));
 </script>
 <style is:global>

 :root{--ink:#20291f;--paper:#f2eee5;--cream:#f6f1e5;--gold:#bca47d;--muted:#b1afa2;--line:rgba(188,164,125,.28);--gutter:64px;color-scheme:dark;scroll-behavior:smooth;scroll-padding-top:95px}
